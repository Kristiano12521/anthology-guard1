-- Fixture: trimmed stand-in for a base game script.

local cached = {}

function actor_on_item_use(obj)
	if obj:section() == "bread" then
		play_item_fx(obj:section())
	end
end

function play_item_fx(section)
	cached[section] = (cached[section] or 0) + 1
end

local function reset_cache()
	cached = {}
end

function on_game_start()
	RegisterScriptCallback("actor_on_item_use", actor_on_item_use)
	RegisterScriptCallback("on_game_load", reset_cache)
end

function on_game_end()
	UnregisterScriptCallback("actor_on_item_use", actor_on_item_use)
	UnregisterScriptCallback("on_game_load", reset_cache)
end
