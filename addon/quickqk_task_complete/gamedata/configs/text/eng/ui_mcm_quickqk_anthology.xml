<?xml version='1.0' encoding='windows-1251'?>
<string_table>
    <string id="ui_mcm_menu_quickqk">
        <text>QuickQK Task Status Tool</text>
    </string>
    <string id="ui_mcm_menu_qq_general">
        <text>Controls</text>
    </string>
    <string id="ui_mcm_menu_qq_safety">
        <text>Safety</text>
    </string>
    <string id="ui_mcm_quickqk_qq_general_desc">
        <text>Force-closes the task currently tracked in the PDA as completed or failed. This changes only the task status; rewards, dialogue, info portions, and later quest stages are not guaranteed.</text>
    </string>
    <string id="ui_mcm_quickqk_qq_general_enable">
        <text>Enable addon</text>
    </string>
    <string id="ui_mcm_quickqk_qq_general_enable_desc">
        <text>Master switch for all QuickQK hotkeys.</text>
    </string>
    <string id="ui_mcm_quickqk_qq_general_modifier">
        <text>Modifier key</text>
    </string>
    <string id="ui_mcm_quickqk_qq_general_modifier_desc">
        <text>Hold this key together with the force-complete or force-fail key.</text>
    </string>
    <string id="quickqk_qq_general_modifier_lst_f6">
        <text>F6</text>
    </string>
    <string id="quickqk_qq_general_modifier_lst_f7">
        <text>F7</text>
    </string>
    <string id="quickqk_qq_general_modifier_lst_f8">
        <text>F8</text>
    </string>
    <string id="quickqk_qq_general_modifier_lst_f9">
        <text>F9</text>
    </string>
    <string id="ui_mcm_quickqk_qq_general_complete_key">
        <text>Force-close as completed key</text>
    </string>
    <string id="ui_mcm_quickqk_qq_general_complete_key_desc">
        <text>Used with the modifier to mark the tracked task as completed through Task Manager. This is not the same as completing all quest scripts normally.</text>
    </string>
    <string id="quickqk_qq_general_complete_key_lst_home">
        <text>Home</text>
    </string>
