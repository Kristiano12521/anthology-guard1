    </string>
    <string id="quickqk_qq_general_complete_key_lst_insert">
        <text>Insert</text>
    </string>
    <string id="ui_mcm_quickqk_qq_general_fail_key">
        <text>Force-close as failed key</text>
    </string>
    <string id="ui_mcm_quickqk_qq_general_fail_key_desc">
        <text>Used with the modifier to mark the tracked task as failed through Task Manager.</text>
    </string>
    <string id="quickqk_qq_general_fail_key_lst_end">
        <text>End</text>
    </string>
    <string id="quickqk_qq_general_fail_key_lst_pagedown">
        <text>Page Down</text>
    </string>
    <string id="quickqk_qq_general_fail_key_lst_delete">
        <text>Delete</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_desc">
        <text>Forced status changes can bypass dialogue, rewards, item hand-ins, info portions, and later quest stages. Keep confirmation enabled and make a separate save before use.</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_require_confirm">
        <text>Require a second hotkey press</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_require_confirm_desc">
        <text>The first press displays a detailed warning. Repeat the same combination within the confirmation window to force the status change.</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_confirm_window">
        <text>Confirmation window, seconds</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_confirm_window_desc">
        <text>How long the second identical hotkey press remains valid.</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_cooldown">
        <text>Action cooldown, seconds</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_cooldown_desc">
        <text>Minimum delay between executed task changes.</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_show_notifications">
        <text>Show notifications</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_show_notifications_desc">
        <text>Display confirmation, success, failure, and error messages.</text>
    </string>
    <string id="st_quickqk_confirm_complete">
        <text>This will force-close the tracked task as completed. Rewards, dialogue, item hand-ins, and follow-up stages are not guaranteed. Repeat the hotkey to confirm.</text>
    </string>
    <string id="st_quickqk_confirm_fail">
        <text>This will force-close the tracked task as failed. Quest consequences may be skipped. Repeat the hotkey to confirm.</text>
    </string>
    <string id="st_quickqk_task_completed">
        <text>The task was force-closed as completed. Rewards and story events may have been skipped.</text>
    </string>
    <string id="st_quickqk_task_failed">
        <text>The task was force-closed as failed.</text>
    </string>
    <string id="st_quickqk_no_active_task">
        <text>No tracked active task was found.</text>
    </string>
    <string id="st_quickqk_task_manager_error">
        <text>Task Manager is unavailable. No task was changed.</text>
    </string>
    <string id="st_quickqk_action_error">
        <text>The task state could not be changed.</text>
    </string>
    <string id="st_quickqk_key_conflict">
        <text>Complete and fail keys were identical. The fail key was restored to a free key.</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_log_task_details">
        <text>Write task details to the log</text>
    </string>
    <string id="ui_mcm_quickqk_qq_safety_log_task_details_desc">
        <text>Writes the task ID, detected title, requested action, result, and reward warning to xray.log. Useful for identifying missions that require a separate compatibility patch.</text>
    </string>
