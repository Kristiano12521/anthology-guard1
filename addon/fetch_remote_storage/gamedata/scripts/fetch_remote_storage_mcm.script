-- Fetch Remote Storage - MCM options
-- Option tree only. Keep game logic in fetch_remote_storage.script
-- Text keys live in gamedata/configs/text/<lang>/ui_st_mcm_fetch_remote_storage.xml

function on_mcm_load()
	return {
		id = "fetch_remote_storage",
		sh = true,
		gr = {
			{ id = "title", type = "title", text = "ui_mcm_fetch_remote_storage_title" },

			{ id = "desc", type = "desc", text = "ui_mcm_fetch_remote_storage_desc" },

			{ id = "enable", type = "check", val = 1, def = false,
			  text = "ui_mcm_fetch_remote_storage_enable" },
		}
	}
end
