-- Fetch Remote Storage
-- Anomaly 1.5.3 / Anthology 2.1
--
-- Always on, no MCM. PDA Announcements (Utjans fetch count): show how many
-- of the *required* section are in nearby online boxes - player-created
-- stashes + Hideout Furniture workshop + Anomalous hidden stash - with the
-- same red / yellow / green markers as inventory.
--
-- Soft-deps: Utjans z_fetch_shows_count, HF / Anomalous m_data keys.
-- Offline boxes are skipped (same as Utjans player stashes). Does not call
-- set_switch_online. Does not change quest status or turn-in.
--
-- load-order: after z_fetch_shows_count (re-wrap on actor_on_first_update)

local LOG_TAG = "[fetch_remote_storage]"
local VERSION = "1.1.0"

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig_extend = nil
local installed = false
local callbacks_registered = false

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

-- Match Utjans multiuse counting so board markers stay consistent.
local function count_matching_item(item, section)
	if not item then
		return 0
	end
	local ok_sec, sec = pcall(function()
		return item:section()
	end)
	if not (ok_sec and sec == section) then
		return 0
	end
	local ok_u, uses = pcall(function()
		return item:get_remaining_uses()
	end)
	if ok_u and type(uses) == "number" and uses > 1 then
		return uses
	end
	return 1
end

local function color_number(cnt, amount)
	if cnt == 0 then
		return utils_xml.get_color("d_red")
	elseif cnt >= amount then
		return utils_xml.get_color("pda_green")
	end
	return utils_xml.get_color("pda_yellow")
end

local function online_box(id)
	if not (level and type(level.object_by_id) == "function") then
		return nil
	end
	local ok, go = pcall(level.object_by_id, id)
	if not (ok and go) then
		return nil
	end
	if type(go.iterate_inventory_box) ~= "function" then
		return nil
	end
	return go
end

-- Nearby online only: player stashes + HF workshop boxes + Anomalous hidden.
local function collect_nearby_stash_ids()
	local ids = {}
	local seen = {}

	local function add_id(id)
		if type(id) == "number" and id > 0 and not seen[id] then
			seen[id] = true
			ids[#ids + 1] = id
		end
	end

	local ok, m_data = pcall(function()
		return alife_storage_manager.get_state()
	end)
	if not (ok and type(m_data) == "table") then
		return ids
	end

	if type(m_data.player_created_stashes) == "table" then
		for stash_id, _ in pairs(m_data.player_created_stashes) do
			add_id(stash_id)
		end
	end

	if type(m_data.workshop_stashes) == "table" then
		for _, stash_id in pairs(m_data.workshop_stashes) do
			add_id(stash_id)
		end
	end

	-- Real storage for Anomalous Stash (anom_inv_stash is UI proxy only).
	add_id(m_data.anomalous_hidden_stash)

	return ids
end

local function count_section_in_nearby_stashes(section)
	local cnt = 0
	if type(section) ~= "string" then
		return 0
	end
	local ids = collect_nearby_stash_ids()
	for i = 1, #ids do
		local box = online_box(ids[i])
		if box then
			pcall(function()
				box:iterate_inventory_box(function(_, item)
					cnt = cnt + count_matching_item(item, section)
				end, box)
			end)
		end
	end
	return cnt
end

local function patched_extend_news_text(text, section, amount)
	if not (section and db and db.actor and utils_xml and utils_data
		and type(utils_data.parse_string_keys) == "function")
	then
		if orig_extend then
			return orig_extend(text, section, amount)
		end
		return text
	end

	amount = amount or 1
	local gc = game.translate_string
	local parse_keys = utils_data.parse_string_keys
	local clr_txt = utils_xml.get_color("pda_white")

	-- Inventory line (same rules / colors as Utjans).
	local inv_cnt = 0
	pcall(function()
		db.actor:iterate_inventory(function(_, item)
			inv_cnt = inv_cnt + count_matching_item(item, section)
		end, nil)
	end)
	text = text
		.. "\\n"
		.. parse_keys(gc("st_fetch_count_have"), {
			["count"] = inv_cnt,
			["clr_txt"] = clr_txt,
			["clr_number"] = color_number(inv_cnt, amount),
		})

	-- Nearby stashes: required section only; player + workshop + anom.
	local stash_cnt = count_section_in_nearby_stashes(section)
	text = text
		.. "\\n"
		.. parse_keys(gc("st_fetch_count_in_stashes"), {
			["count"] = stash_cnt,
			["clr_txt"] = clr_txt,
			["clr_number"] = color_number(stash_cnt, amount),
		})

	return text
end

local function install()
	local zfc = rawget(_G, "z_fetch_shows_count")
	if not (type(zfc) == "table" and type(zfc.extend_news_text) == "function") then
		printf("%s z_fetch_shows_count.extend_news_text not found - guard NOT installed", LOG_TAG)
		return false
	end

	if installed and zfc.extend_news_text == patched_extend_news_text then
		return true
	end

	if zfc.extend_news_text ~= patched_extend_news_text then
		orig_extend = zfc.extend_news_text
		zfc.extend_news_text = patched_extend_news_text
	end

	installed = true
	log("installed v%s (PDA stash markers)", VERSION)
	return true
end

local function uninstall()
	local zfc = rawget(_G, "z_fetch_shows_count")
	if type(zfc) == "table" and orig_extend and zfc.extend_news_text == patched_extend_news_text then
		zfc.extend_news_text = orig_extend
	end
	orig_extend = nil
	installed = false
end

function actor_on_first_update()
	install()
end

function on_game_start()
	install()
	if callbacks_registered then
		return
	end
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	callbacks_registered = true
end

function on_game_end()
	uninstall()
	if not callbacks_registered then
		return
	end
	UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
	callbacks_registered = false
end
