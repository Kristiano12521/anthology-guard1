-- Tosox vanish-fail на общем DRX stash-слоте
-- Anomaly 1.5.3 / Anthology 2.1
--
-- Tosox z_task_marker_delivery_fix при stage==0 и мёртвом var.item_id
-- возвращает "fail". На общих слотах 1/2/3 сдача одного заказа
-- (remove_item того же drx_sl_quest_item_N) валит соседний.
-- Ваниль только откатывает stage; этот патч вместо fail перезапускает
-- тайник (новый target_id, stash_created=false, item_id сброшен).

local LOG_TAG = "[fix_quest_item_shared_fail]"
local VERSION = "1.0.0"
local EVENT_ID = "fix_quest_item_shared_fail"
local INSTALL_ACTION = "install_late"
local INSTALL_DELAY = 0.5

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig_status = nil
local callbacks_registered = false

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

local function load_task_var(task_id)
	if not (db.actor and task_id and type(load_var) == "function") then
		return nil
	end
	local ok, var = pcall(load_var, db.actor, task_id)
	if ok and type(var) == "table" then
		return var
	end
	return nil
end

local function level_name_of(se_obj)
	if not (se_obj and alife and game_graph) then
		return nil
	end
	local ok, name = pcall(function()
		return alife():level_name(game_graph():vertex(se_obj.m_game_vertex_id):level_id())
	end)
	if ok then
		return name
	end
	return nil
end

local function pick_stash_id()
	if not (treasure_manager and type(treasure_manager.get_random_stash) == "function") then
		return nil
	end
	-- Как drx_sl_create_quest_stash: сначала локальная карта, иначе любая.
	local ok, stash_id = pcall(treasure_manager.get_random_stash, nil, nil, true, true)
	if ok and stash_id then
		return stash_id
	end
	ok, stash_id = pcall(treasure_manager.get_random_stash, nil, nil, false, true)
	if ok then
		return stash_id
	end
	return nil
end

local function rearm_stash(tsk, task_id, var)
	local typ = tonumber(var.stash_type)
	if not typ then
		return false
	end

	local old_item = var.item_id
	local old_target = var.target_id
	var.item_id = nil
	var.stash_created = false

	local stash_id = pick_stash_id()
	if stash_id then
		var.target_id = stash_id
		local se_target = alife_object(stash_id)
		local lvl = level_name_of(se_target)
		if lvl then
			var.lvl_target = lvl
		end
	end

	if type(save_var) == "function" then
		save_var(db.actor, task_id, var)
	end

	if tsk then
		tsk.stage = 0
		tsk.check_time = 0
		if tsk.last_check_task == "fail" then
			tsk.last_check_task = nil
		end
	end

	log(
		"rearm task=%s type=%s old_item=%s old_stash=%s new_stash=%s",
		tostring(task_id),
		tostring(typ),
		tostring(old_item),
		tostring(old_target),
		tostring(var.target_id)
	)
	return true
end

local function is_vanish_fail(var)
	if type(var) ~= "table" or not var.item_id then
		return false
	end
	local ok, item_obj = pcall(alife_object, var.item_id)
	if not ok or not item_obj then
		return true
	end
	local typ = tonumber(var.stash_type)
	if not typ then
		return false
	end
	local expect = "drx_sl_quest_item_" .. tostring(typ)
	local ok_sec, sec = pcall(function()
		return item_obj:section_name()
	end)
	if ok_sec and sec ~= expect then
		return true
	end
	return false
end

function patched_status(tsk, task_id)
	local result
	if type(orig_status) == "function" then
		result = orig_status(tsk, task_id)
	end

	if result ~= "fail" then
		return result
	end

	if not db.actor then
		return result
	end

	local var = load_task_var(task_id)
	if not is_vanish_fail(var) then
		return result
	end

	if rearm_stash(tsk, task_id, var) then
		return nil
	end
	return result
end

local function install()
	if not task_status_functor or type(task_status_functor.drx_sl_quest_item_task_status) ~= "function" then
		printf("%s task_status_functor.drx_sl_quest_item_task_status not found - guard NOT installed", LOG_TAG)
		return false
	end
	if orig_status then
		return true
	end
	if task_status_functor.drx_sl_quest_item_task_status == patched_status then
		return true
	end
	orig_status = task_status_functor.drx_sl_quest_item_task_status
	task_status_functor.drx_sl_quest_item_task_status = patched_status
	log("v%s status wrapped", VERSION)
	return true
end

local function uninstall()
	if orig_status and task_status_functor and task_status_functor.drx_sl_quest_item_task_status == patched_status then
		task_status_functor.drx_sl_quest_item_task_status = orig_status
	end
	orig_status = nil
end

function install_tick()
	install()
	return true
end

local function schedule_late_install()
	if type(RemoveTimeEvent) == "function" then
		pcall(RemoveTimeEvent, EVENT_ID, INSTALL_ACTION)
	end
	if type(CreateTimeEvent) == "function" then
		CreateTimeEvent(EVENT_ID, INSTALL_ACTION, INSTALL_DELAY, install_tick)
	end
end

function actor_on_first_update()
	install()
end

function on_game_start()
	install()
	schedule_late_install()
	if callbacks_registered then
		return
	end
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	callbacks_registered = true
	log("загружен v%s", VERSION)
end

function on_game_end()
	if type(RemoveTimeEvent) == "function" then
		pcall(RemoveTimeEvent, EVENT_ID, INSTALL_ACTION)
	end
	if callbacks_registered then
		UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = false
	end
	uninstall()
end
