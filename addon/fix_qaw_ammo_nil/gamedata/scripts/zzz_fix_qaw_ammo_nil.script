-- load-order: ����� haru_quick_action_wheel_mcm
-- QAW Ammo Active Item Nil Guard
-- Anomaly 1.5.3 / Anthology 2.1
--
-- QAmmoWheelOption:OnClick closes the wheel then CreateTimeEvent(0.1) calls
-- LoadInActiveWeapon. That path does db.actor:active_item() with no nil check.
-- If the actor has no active item after the delay (holster / slot change /
-- attachment anim), Lua fatals:
--   haru_quick_action_wheel_mcm.script:1426 attempt to index local 'wpn' (a nil value)
-- Same race exists in QMagazineWheelOption:LoadInActiveWeapon.
-- AttachmentWheelOption:OnClick already guards wpn; ammo/mag paths did not.

local LOG_TAG = "[fix_qaw_ammo_nil]"
local VERSION = "1.0.0"
local LOG_INTERVAL_MS = 1000

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig_ammo = nil
local orig_mag = nil
local installed = false
local skip_count = 0
local last_log_tg = 0

local function log_skip(kind)
	skip_count = skip_count + 1
	local now = time_global()
	if (now - last_log_tg) < LOG_INTERVAL_MS then
		return
	end
	last_log_tg = now
	printf(
		"%s skip %s LoadInActiveWeapon: no active item (batch_total=%d)",
		LOG_TAG,
		kind,
		skip_count
	)
end

local function active_weapon()
	local actor = db.actor
	if not actor then
		return nil
	end
	return actor:active_item()
end

function guarded_ammo_load_in_active_weapon(self)
	if not active_weapon() then
		log_skip("ammo")
		return
	end
	return orig_ammo(self)
end

function guarded_mag_load_in_active_weapon(self, obj)
	if not active_weapon() then
		log_skip("mag")
		return
	end
	return orig_mag(self, obj)
end

local function add_class_target(list, seen, obj, via)
	if obj == nil then
		return
	end
	if seen[obj] then
		for i = 1, #list do
			if list[i].obj == obj then
				list[i].via = list[i].via .. " + " .. via
				return
			end
		end
		return
	end
	seen[obj] = true
	list[#list + 1] = { obj = obj, via = via }
end

local function class_targets(bare_name)
	local list = {}
	local seen = {}
	add_class_target(list, seen, rawget(_G, bare_name), "_G." .. bare_name)
	local mod = rawget(_G, "haru_quick_action_wheel_mcm")
	if type(mod) == "table" then
		add_class_target(list, seen, mod[bare_name], "haru_quick_action_wheel_mcm." .. bare_name)
	end
	-- Bare name via __index=_G of this script env (same as BusyHands UIInventory).
	add_class_target(list, seen, _G[bare_name], "env " .. bare_name)
	return list
end

local function install()
	if installed then
		return true
	end

	local ammo_ok = false
	local mag_ok = false

	local ammo_targets = class_targets("QAmmoWheelOption")
	for i = 1, #ammo_targets do
		local cls = ammo_targets[i].obj
		local via = ammo_targets[i].via
		if type(cls) == "table" and type(cls.LoadInActiveWeapon) == "function" then
			if cls.LoadInActiveWeapon ~= guarded_ammo_load_in_active_weapon then
				orig_ammo = orig_ammo or cls.LoadInActiveWeapon
				cls.LoadInActiveWeapon = guarded_ammo_load_in_active_weapon
			end
			ammo_ok = true
			printf("%s QAmmoWheelOption.LoadInActiveWeapon patched via %s", LOG_TAG, via)
		end
	end

	local mag_targets = class_targets("QMagazineWheelOption")
	for i = 1, #mag_targets do
		local cls = mag_targets[i].obj
		local via = mag_targets[i].via
		if type(cls) == "table" and type(cls.LoadInActiveWeapon) == "function" then
			if cls.LoadInActiveWeapon ~= guarded_mag_load_in_active_weapon then
				orig_mag = orig_mag or cls.LoadInActiveWeapon
				cls.LoadInActiveWeapon = guarded_mag_load_in_active_weapon
			end
			mag_ok = true
			printf("%s QMagazineWheelOption.LoadInActiveWeapon patched via %s", LOG_TAG, via)
		end
	end

	if not ammo_ok then
		printf("%s QAmmoWheelOption.LoadInActiveWeapon not found - guard NOT installed", LOG_TAG)
		return false
	end

	-- Magazine class is optional (mags tab); ammo path is the crash from the report.
	if not mag_ok then
		printf("%s QMagazineWheelOption.LoadInActiveWeapon not found - ammo guard only", LOG_TAG)
	end

	installed = true
	printf("%s guard installed v%s", LOG_TAG, VERSION)
	return true
end

local function uninstall()
	if not installed then
		return
	end

	local ammo_targets = class_targets("QAmmoWheelOption")
	for i = 1, #ammo_targets do
		local cls = ammo_targets[i].obj
		if type(cls) == "table" and orig_ammo and cls.LoadInActiveWeapon == guarded_ammo_load_in_active_weapon then
			cls.LoadInActiveWeapon = orig_ammo
		end
	end

	local mag_targets = class_targets("QMagazineWheelOption")
	for i = 1, #mag_targets do
		local cls = mag_targets[i].obj
		if type(cls) == "table" and orig_mag and cls.LoadInActiveWeapon == guarded_mag_load_in_active_weapon then
			cls.LoadInActiveWeapon = orig_mag
		end
	end

	installed = false
	orig_ammo = nil
	orig_mag = nil
end

function on_game_start()
	install()
end

function on_game_end()
	uninstall()
end

install()
