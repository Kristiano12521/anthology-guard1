-- load-order: после _g.script
-- Early printe hook: startup errors (itms_manager) run before aaa_diag_log_spam.script.

local LOG_TAG = "[diag_log_spam]"

local PRINTE_PATTERNS = {
	"item_combination",
	"wrong section names",
	"callback doesn't exist",
	"no game object",
	"no server object",
}

local function format_printe_msg(fmt, ...)
	if select("#", ...) > 0 then
		local ok, msg = pcall(string.format, tostring(fmt), ...)
		if ok then
			return msg
		end
	end
	return tostring(fmt)
end

local function printe_pattern_key(msg)
	for _, pat in ipairs(PRINTE_PATTERNS) do
		if string.find(msg, pat, 1, true) then
			return pat
		end
	end
	return nil
end

_G.__diag_log_spam = _G.__diag_log_spam or {}
local state = _G.__diag_log_spam

if not state.early_printe_hook then
	state.early_printe_hook = true
	state.traced_printe = state.traced_printe or {}
	state.orig_printe = _G.printe

	local function early_printe(fmt, ...)
		local msg = format_printe_msg(fmt, ...)
		local key = printe_pattern_key(msg)
		if key and not state.traced_printe[key] then
			state.traced_printe[key] = true
			printf("%s TRACE printe:%s | %s", LOG_TAG, key, msg)
			local cs = _G.callstack
			if type(cs) == "function" then
				cs()
			end
		end
		return state.orig_printe(fmt, ...)
	end

	_G.printe = early_printe
	state.wrapped_printe = early_printe
	printf("%s early printe hook", LOG_TAG)
end
