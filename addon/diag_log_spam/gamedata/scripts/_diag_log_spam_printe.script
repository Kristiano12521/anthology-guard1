-- load-order: posle _g.script
-- Early printe hook: startup errors (itms_manager) run before aaa_diag_log_spam.script.

local LOG_TAG = "[diag_log_spam]"

local PRINTE_PATTERNS = {
	"item_combination",
	"wrong section names",
	"callback doesn't exist",
	"no game object",
	"no server object",
}

local function format_printe_msg(fmt, ...)
	if select("#", ...) > 0 then
		local ok, msg = pcall(string.format, tostring(fmt), ...)
		if ok then
			return msg
		end
	end
	return tostring(fmt)
end

local function printe_pattern_key(msg)
	for _, pat in ipairs(PRINTE_PATTERNS) do
		if string.find(msg, pat, 1, true) then
			return pat
		end
	end
	return nil
end

-- callstack(c1, to_str) in _g.script: always starts debug.traceback('', 2); c1 trims to first frame only.
-- No skip parameter. Use debug.traceback with a higher level to skip our wrappers.
local function format_traceback(str)
	str = string.gsub(str, "%.%.%.(.-)\\scripts\\", "... ")
	for ss in string.gmatch(str, ":(%d*):") do
		local num = string.gsub(ss, ":", "")
		str = string.gsub(str, ":" .. num .. ":", " (line: " .. num .. ")")
	end
	str = string.gsub(str, "^(.-):", "")
	return str
end

local function printf_traceback(trace_level)
	if type(debug) ~= "table" or type(debug.traceback) ~= "function" then
		return
	end
	local str = format_traceback(debug.traceback("", trace_level))
	for line in string.gmatch(str, "[^\r\n]+") do
		line = string.gsub(line, "^%s+", "")
		if line ~= "" and not string.find(line, "^stack traceback", 1, true) then
			printf("%s   %s", LOG_TAG, line)
		end
	end
end

_G.__diag_log_spam = _G.__diag_log_spam or {}
local state = _G.__diag_log_spam
state.printf_traceback = printf_traceback

if not state.early_printe_hook then
	state.early_printe_hook = true
	state.traced_printe = state.traced_printe or {}
	state.orig_printe = _G.printe

	local function early_printe(fmt, ...)
		local msg = format_printe_msg(fmt, ...)
		local key = printe_pattern_key(msg)
		if key and not state.traced_printe[key] then
			state.traced_printe[key] = true
			printf("%s TRACE printe:%s | %s", LOG_TAG, key, msg)
			-- level 3: (1) debug.traceback, (2) early_printe@74, (3) printe caller
			printf_traceback(3)
		end
		return state.orig_printe(fmt, ...)
	end

	_G.printe = early_printe
	state.wrapped_printe = early_printe
	printf("%s early printe hook", LOG_TAG)
end
