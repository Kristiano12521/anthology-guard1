-- MCM page for Seamless Inventory Sort - Anomaly Anthology 2.1.
-- Values are read in seamless_inventory_sort_anthology.script via
--   ui_mcm.get("seamless_sort/<subgroup>/<id>")
-- MCM is optional; the script falls back to its own defaults when it is absent.

local BANNER = "ui_options_slider_player"

function on_mcm_load()
    return {
        id = "seamless_sort",
        gr = {
            { id = "siss_general", sh = true, gr = {
                { id = "title", type = "slide", link = BANNER, text = "ui_mcm_menu_siss_general", size = {512,50}, spacing = 20 },
                { id = "desc",  type = "desc",  text = "ui_mcm_seamless_sort_siss_general_desc" },
                { id = "enable",        type = "check", val = 1, def = true },
                { id = "win_inventory", type = "check", val = 1, def = true },
                { id = "win_loot",      type = "check", val = 1, def = true },
                { id = "win_trade",     type = "check", val = 1, def = true },
                { id = "fav_junk",      type = "check", val = 1, def = true },
                { id = "no_slot_jump",  type = "check", val = 1, def = true },
            }},

            { id = "siss_auto", sh = true, gr = {
                { id = "title", type = "slide", link = BANNER, text = "ui_mcm_menu_siss_auto", size = {512,50}, spacing = 20 },
                { id = "desc",  type = "desc",  text = "ui_mcm_seamless_sort_siss_auto_desc" },
                { id = "auto_fav",     type = "check", val = 1, def = true },
                { id = "auto_fav_own", type = "check", val = 1, def = true },
            }},

            { id = "siss_gaps", sh = true, gr = {
                { id = "title", type = "slide", link = BANNER, text = "ui_mcm_menu_siss_gaps", size = {512,50}, spacing = 20 },
                { id = "desc",  type = "desc",  text = "ui_mcm_seamless_sort_siss_gaps_desc" },
                { id = "keep_gaps",      type = "check", val = 1, def = true },
                { id = "keep_disasm",    type = "check", val = 1, def = true },
                { id = "disasm_delay",   type = "track", val = 2, min = 0, max = 8, step = 0.5, def = 0 },
                { id = "ammo_parts_row", type = "check", val = 1, def = true },
                { id = "ap_order",       type = "track", val = 2, min = 1, max = 15, step = 0.5, def = 9.5 },
            }},

            { id = "siss_loot", sh = true, gr = {
                { id = "title", type = "slide", link = BANNER, text = "ui_mcm_menu_siss_loot", size = {512,50}, spacing = 20 },
                { id = "desc",  type = "desc",  text = "ui_mcm_seamless_sort_siss_loot_desc" },
                { id = "body_mode", type = "list", val = 0, def = "sort", content = {
                    { "sort" }, { "never" }, { "ltt_keep" }, { "ltt_after" },
                }},
            }},

            { id = "siss_hl", sh = true, gr = {
                { id = "title", type = "slide", link = BANNER, text = "ui_mcm_menu_siss_hl", size = {512,50}, spacing = 20 },
                { id = "desc",  type = "desc",  text = "ui_mcm_seamless_sort_siss_hl_desc" },
                { id = "hl_new",   type = "check", val = 1, def = true },
                { id = "hl_new_r", type = "track", val = 2, min = 0, max = 255, step = 1, def = 0 },
                { id = "hl_new_g", type = "track", val = 2, min = 0, max = 255, step = 1, def = 210 },
                { id = "hl_new_b", type = "track", val = 2, min = 0, max = 255, step = 1, def = 230 },
                { id = "hl_new_a", type = "track", val = 2, min = 0, max = 255, step = 1, def = 60 },
            }},

            { id = "siss_antifreeze", sh = true, gr = {
                { id = "title", type = "slide", link = BANNER, text = "ui_mcm_menu_siss_antifreeze", size = {512,50}, spacing = 20 },
                { id = "desc", type = "desc", text = "ui_mcm_seamless_sort_siss_antifreeze_desc" },
                { id = "af_enabled",        type = "check", val = 1, def = true },
                { id = "af_trade_enabled",  type = "check", val = 1, def = false },
                { id = "af_deferred_limit", type = "track", val = 2, min = 50, max = 1000, step = 25, def = 120 },
                { id = "af_frame_budget",   type = "track", val = 2, min = 1, max = 8, step = 1, def = 2 },
                { id = "af_sort_step",      type = "track", val = 2, min = 10, max = 400, step = 10, def = 80 },
                { id = "af_icon_step",      type = "track", val = 2, min = 1, max = 100, step = 1, def = 12 },
                { id = "af_indicator",      type = "check", val = 1, def = false },
                { id = "af_safe_compare",   type = "check", val = 1, def = true },
            }},

            { id = "siss_perf", sh = true, gr = {
                { id = "title", type = "slide", link = BANNER, text = "ui_mcm_menu_siss_perf", size = {512,50}, spacing = 20 },
                { id = "desc",  type = "desc",  text = "ui_mcm_seamless_sort_siss_perf_desc" },
                { id = "perf_mode", type = "list", val = 0, def = "balanced", content = {
                    { "instant" }, { "balanced" }, { "fps" },
                }},
                { id = "trade_policy", type = "list", val = 0, def = "additions", content = {
                    { "full" }, { "additions" }, { "off" },
                }},
                { id = "trade_max_items", type = "track", val = 2, min = 0, max = 1000, step = 50, def = 300 },
                { id = "osc_guard",    type = "check", val = 1, def = true },
                { id = "osc_limit",    type = "track", val = 2, min = 3,   max = 20, step = 1,   def = 8 },
                { id = "osc_cooldown", type = "track", val = 2, min = 0.5, max = 5,  step = 0.5, def = 1.5 },
            }},

            { id = "siss_trade_diag", sh = true, gr = {
                { id = "title", type = "slide", link = BANNER, text = "ui_mcm_menu_siss_trade_diag", size = {512,50}, spacing = 20 },
                { id = "desc", type = "desc", text = "ui_mcm_seamless_sort_siss_trade_diag_desc" },
                { id = "trade_diag_enabled", type = "check", val = 1, def = false },
                { id = "trade_diag_interval", type = "track", val = 2, min = 2, max = 20, step = 1, def = 5 },
                { id = "trade_diag_slow_ms", type = "track", val = 2, min = 2, max = 30, step = 1, def = 8 },
                { id = "trade_fast_unhighlight", type = "check", val = 1, def = true },
            }},
        }
    }
end
