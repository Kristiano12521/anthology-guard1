-- load-order: после dynamic_npc_armor_visuals.script
-- Dynamic Armor Visuals Nil Guard
-- Anomaly 1.5.3 / Anthology 2.1
--
-- ActorMenu_on_item_after_move can deliver item=nil during Action_Move_All
-- (ish_fast_transfer move-all): CheckItem fails for an already-moved child id,
-- but ui_inventory still SendScriptCallback. Original handler does item:id()
-- without a nil check -> LUA error at line 166.
-- Unlike fix_minigun_dead_parent, this is plain nil indexing, not engine member
-- access on destroyed userdata: item == nil before calling original is enough.

local LOG_TAG = "[fix_dynamic_armor_visuals_nil]"
local VERSION = "1.0.0"
local CALLBACK = "ActorMenu_on_item_after_move"
local LOG_INTERVAL_MS = 1000

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig_fn = nil
local installed = false
local skip_count = 0
local last_log_tg = 0

local function log_skip(npc_id)
	skip_count = skip_count + 1
	local now = time_global()
	if (now - last_log_tg) < LOG_INTERVAL_MS then
		return
	end
	last_log_tg = now
	printf(
		"%s skip nil item (npc_id=%s, batch_total=%d)",
		LOG_TAG,
		tostring(npc_id),
		skip_count
	)
end

function guarded_actor_on_item_take_from_box(npc_id, item, ...)
	if item == nil then
		log_skip(npc_id)
		return
	end
	return orig_fn(npc_id, item, ...)
end

local function steal_callback(name, old_fn, new_fn)
	if type(UnregisterScriptCallback) == "function" and type(old_fn) == "function" and old_fn ~= new_fn then
		UnregisterScriptCallback(name, old_fn)
	end
	if type(RegisterScriptCallback) == "function" then
		RegisterScriptCallback(name, new_fn)
		return true
	end
	return false
end

local function install()
	if installed then
		return true
	end

	local mod = rawget(_G, "dynamic_npc_armor_visuals")
	if not (mod and type(mod.actor_on_item_take_from_box) == "function") then
		printf(
			"%s dynamic_npc_armor_visuals.actor_on_item_take_from_box not found - guard NOT installed",
			LOG_TAG
		)
		return false
	end

	if mod.actor_on_item_take_from_box == guarded_actor_on_item_take_from_box then
		installed = true
		return true
	end

	orig_fn = mod.actor_on_item_take_from_box
	mod.actor_on_item_take_from_box = guarded_actor_on_item_take_from_box

	if not steal_callback(CALLBACK, orig_fn, guarded_actor_on_item_take_from_box) then
		mod.actor_on_item_take_from_box = orig_fn
		orig_fn = nil
		printf("%s RegisterScriptCallback missing - guard NOT installed", LOG_TAG)
		return false
	end

	installed = true
	printf("%s guard installed v%s", LOG_TAG, VERSION)
	return true
end

local function uninstall()
	local mod = rawget(_G, "dynamic_npc_armor_visuals")
	if not installed or not orig_fn then
		return
	end

	if type(UnregisterScriptCallback) == "function" then
		UnregisterScriptCallback(CALLBACK, guarded_actor_on_item_take_from_box)
	end
	if type(RegisterScriptCallback) == "function" then
		RegisterScriptCallback(CALLBACK, orig_fn)
	end
	if mod then
		mod.actor_on_item_take_from_box = orig_fn
	end

	installed = false
	orig_fn = nil
end

function on_game_start()
	install()
end

function on_game_end()
	uninstall()
end
