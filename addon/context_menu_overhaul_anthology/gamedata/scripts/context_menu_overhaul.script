      end
    end
  end
end
--- Whether the row at `index` is one this addon inserted rather than a menu entry.
function is_inert_row(widget, index)
  local rows = widget.cmo_inert_rows
  if not rows then
    return false
  end
  do
    local i = 0
    while i < #rows do
      if rows[i + 1] == index then
        return true
      end
      i = i + 1
    end
  end
  return false
end
vanilla_update = cell_properties.Update
--- Re-sizes the hover strip, which vanilla takes from the text control and which no longer spans the row.
function update(self)
  vanilla_update(self)
  local wpo = context_menu_overhaul_wpo
  if wpo and type(wpo.highlight) == "function" then
    local ok, claimed = pcall(wpo.highlight, self)
    if ok and claimed then
      return
    elseif not ok and not wpo_fallback_logged then
      wpo_fallback_logged = true
      cmo_log("WPO highlight disabled after error: %s", tostring(claimed))
    end
  end
  if not self.highlight:IsShown() then
    return
  end
  do
    local i = 0
    while i < self.list_box:GetSize() do
      local item = self.list_box:GetItemByIndex(i)
      if item and item:IsCursorOverWindow() then
        if is_inert_row(self, i) then
          self.highlight:Show(false)
          return
        end
        self.highlight:SetWndSize(vec(
          self.form:GetWidth() - self.PDH,
          item:GetHeight()
        ))
        return
      end
      i = i + 1
    end
  end
end
--- Layout twin of {@link fill_list} for the submenus addons open on their own subclass: geometry only, since those rows carry no property id, functor or config key. Weapon Parts Overhaul's field strip is the one exception, handed off to {@link strip_try_fill }.
function sub_fill_list(self, action_list, name_list, params_list)
  local wpo = context_menu_overhaul_wpo
  self.cmo_column = nil
  if self.cmo_list_y == nil then
    self.cmo_list_y = self.list_box:GetWndPos().y
  end

  local is_fs = false
  local is_maintenance = false
  if wpo then
    if type(wpo.is_field_strip) == "function" then
      local ok, value = pcall(wpo.is_field_strip, action_list)
      is_fs = ok and value or false
    end
    if not is_fs and type(wpo.is_maintenance) == "function" then
      local ok, value = pcall(wpo.is_maintenance, action_list)
      is_maintenance = ok and value or false
    end
  end

  if is_fs or is_maintenance then
    local icons_enabled = is_fs and settings.field_strip_icons or settings.maintenance_icons
    local icons_available = false
    if icons_enabled and wpo and type(wpo.can_use_icons) == "function" then
      local ok, value = pcall(wpo.can_use_icons)
      icons_available = ok and value or false
    end

    if icons_available and type(wpo.fill_icons) == "function" then
      local ok, result = pcall(wpo.fill_icons, self, action_list, name_list, params_list)
      if ok and result then
        return
      end
      if not wpo_fallback_logged then
        wpo_fallback_logged = true
        cmo_log("WPO icon menu failed; using text fallback: %s", tostring(result))
      end
    end

    if wpo and type(wpo.clear) == "function" then
      pcall(wpo.clear, self)
    end
    if wpo and type(wpo.fill_text) == "function" then
      local ok, err = pcall(wpo.fill_text, self, action_list, name_list, params_list)
      if ok then
        return
      end
      if not wpo_fallback_logged then
        wpo_fallback_logged = true
        cmo_log("WPO text menu failed; using vanilla submenu: %s", tostring(err))
      end
    end
  elseif wpo and type(wpo.clear) == "function" then
    pcall(wpo.clear, self)
  end

  vanilla_fill_list(self, action_list, name_list, params_list)
  finish_layout(self)
end
--- Layout twin of {@link add_item_to_list}: reserves the submenu's icon column, unless a field strip claims the row.
function sub_add_item_to_list(self, index, str_id, func, params)
  if self.cmo_strip_text then
    add_item_to_list(
      self,
      index,
      str_id,
      func,
      params
    )
    return
  end
  vanilla_add_item(
    self,
    index,
    str_id,
    func,
    params
  )
  local item = self.list_box:GetItemByIndex(self.list_box:GetSize() - 1)
  if item then
    self.cmo_column = reserve_column(item)
  end
end
--- Reads `key` off a value that may be a luabind class, where indexing a missing key can raise.
function safe_index(value, key)
  local ok, result = pcall(function() return value[key] end)
  local ____ok_11
  if ok then
    ____ok_11 = result
  else
    ____ok_11 = nil
  end
  return ____ok_11
end
--- Applies the layout to every subclass of the widget, found rather than named. Anomaly's
-- `class "X" (Y)` copies the base's methods into the subclass when defined ? before
-- `on_game_start` ? so assigning onto the base never reaches one; each is recognised instead
-- by still holding the vanilla methods. The base and any deliberately-overridden subclass no
-- longer match and are skipped.
function namespace_may_hold_ui(name)
  if type(name) ~= "string" then
    return false
  end
  local lower = string.lower(name)
  return lower == "utils_ui"
    or lower == "utils_ui_custom"
    or string.find(lower, "ui", 1, true) ~= nil
    or string.find(lower, "item", 1, true) ~= nil
    or string.find(lower, "weapon", 1, true) ~= nil
    or string.find(lower, "repair", 1, true) ~= nil
    or string.find(lower, "wpo", 1, true) ~= nil
end
function method_matches(value, key, current, initial)
  local method = safe_index(value, key)
  return method == current or method == initial
end
--- Applies geometry wrappers only to UI-related subclasses that still carry the
--- base FillList/AddItemToList pair. A marker prevents duplicate wrapping.
function patch_subclasses()
  local patched = 0
  local globals = _G
  for name, namespace in pairs(globals) do
    do
      if name == "_G" or type(namespace) ~= "table" or not namespace_may_hold_ui(name) then
        goto __continue138
      end
      for class_name, value in pairs(namespace) do
        do
          if type(value) == "function" then
            goto __continue140
          end
          local already_patched = safe_index(value, "cmo_anthology_patched")
            and safe_index(value, "FillList") == sub_fill_list
            and safe_index(value, "AddItemToList") == sub_add_item_to_list
            and safe_index(value, "Update") == update
          if already_patched then
            goto __continue140
          end
          if not method_matches(value, "FillList", vanilla_fill_list, initial_fill_list)
            or not method_matches(value, "AddItemToList", vanilla_add_item, initial_add_item)
            or not method_matches(value, "Update", vanilla_update, initial_update) then
            goto __continue140
          end
          local cls = value
          local ok = pcall(function()
            cls.FillList = sub_fill_list
            cls.AddItemToList = sub_add_item_to_list
            cls.Update = update
            cls.cmo_anthology_patched = true
          end)
          if not ok then
            goto __continue140
          end
          local wpo = context_menu_overhaul_wpo
          if wpo and type(wpo.patch) == "function" then
            pcall(wpo.patch, cls)
          end
          patched = patched + 1
          cmo_log("patched submenu class: %s.%s", tostring(name), tostring(class_name))
        end
        ::__continue140::
      end
    end
    ::__continue138::
  end
  return patched
end
function install_hooks()
  local inventory_class = ui_inventory and ui_inventory.UIInventory
  local current_cells = utils_ui and utils_ui.UICellProperties
  if not (inventory_class and current_cells) then
    cmo_log("installation blocked: UIInventory or UICellProperties is unavailable")
    return false
  end

  local current_init = safe_index(inventory_class, "InitProperties")
  local current_fill = safe_index(current_cells, "FillList")
  local current_add = safe_index(current_cells, "AddItemToList")
  local current_update = safe_index(current_cells, "Update")
  if hooks_installed
    and current_init == init_properties
    and current_fill == fill_list
    and current_add == add_item_to_list
    and current_update == update then
    patch_subclasses()
    return true
  elseif hooks_installed then
    cmo_log("a later addon replaced one or more hooks; chaining the current methods again")
  end
  if type(current_init) ~= "function"
    or type(current_fill) ~= "function"
    or type(current_add) ~= "function"
    or type(current_update) ~= "function" then
    cmo_log("installation blocked: one or more base UI methods are unavailable")
    return false
  end

  if current_init ~= init_properties then
    vanilla_init_properties = current_init
  end
  if current_fill ~= fill_list then
    vanilla_fill_list = current_fill
  end
  if current_add ~= add_item_to_list then
    vanilla_add_item = current_add
  end
  if current_update ~= update then
    vanilla_update = current_update
  end

  cell_properties = current_cells
  local wpo = context_menu_overhaul_wpo
  if wpo and type(wpo.set_base_methods) == "function" then
    pcall(wpo.set_base_methods, vanilla_fill_list, vanilla_add_item)
  end

  inventory_class.InitProperties = init_properties
  current_cells.FillList = fill_list
  current_cells.AddItemToList = add_item_to_list
  current_cells.Update = update
  pcall(function() current_cells.cmo_anthology_patched = true end)

  local subclasses = patch_subclasses()
  local wpo_icons = false
  if wpo and type(wpo.can_use_icons) == "function" then
    local ok, value = pcall(wpo.can_use_icons)
    wpo_icons = ok and value or false
  end
  hooks_installed = true
  cmo_log(
    "installed late | subclasses=%s | mags_redux=%s | toxic_air=%s | wpo_icons=%s",
    tostring(subclasses),
    tostring(type(magazines) == "table"),
    tostring(type(toxic_air) == "table"),
    tostring(wpo_icons)
  )
  return true
end
--- Quick Action Wheel integration.
--- * Keeps one original-labelled context action.
--- * Uses the currently selected manual tab when possible.
--- * Routes dynamic-tab additions to an enabled manual tab.
--- * Registers after QAW initialization and removes its temporary callback.
cmo_qaw_first_update_registered = false
cmo_qaw_update_registered = false
cmo_qaw_retry_count = 0
cmo_qaw_max_retries = 120
cmo_qaw_log_once = {}

function cmo_qaw_log(key, fmt, ...)
  if cmo_qaw_log_once[key] then
    return
  end
  cmo_qaw_log_once[key] = true
  cmo_log("QAW integration | " .. fmt, ...)
end

function cmo_qaw_module()
  return haru_quick_action_wheel_mcm
end

function cmo_qaw_manager()
  local mod = cmo_qaw_module()
  return mod and mod.TAB_MANAGER or nil
end

function cmo_qaw_current_tab()
  local mgr = cmo_qaw_manager()
  if not mgr then
    return nil, nil
  end

  local tab = mgr.temp_tab or mgr.current_tab
  local category = mgr.dynamic_tabs and mgr.dynamic_tabs[tab] or "manual"
  return tab, category
end

function cmo_qaw_valid_manual_tab(mgr, tab)
  return type(tab) == "number"
    and type(mgr.tabs) == "table"
    and type(mgr.tabs[tab]) == "table"
    and not (mgr.dynamic_tabs and mgr.dynamic_tabs[tab])
end

function cmo_qaw_target_tab()
  local mod = cmo_qaw_module()
  local mgr = cmo_qaw_manager()
  if not mod or not mgr then
    return nil, "not_ready"
  end

  local current = cmo_qaw_current_tab()
  if cmo_qaw_valid_manual_tab(mgr, current) then
    return current, "current_manual"
  end

  local cfg = mod.MCM_SETTINGS or {}

  if cfg.manual_1_enabled ~= false
    and cmo_qaw_valid_manual_tab(mgr, cfg.manual_1_tab) then
    return cfg.manual_1_tab, "primary_manual"
  end

  if cfg.manual_2_enabled ~= false
    and cmo_qaw_valid_manual_tab(mgr, cfg.manual_2_tab) then
    return cfg.manual_2_tab, "secondary_manual"
  end

  local count = mgr.tab_count or #mgr.tabs
  for i = 1, count do
    if cmo_qaw_valid_manual_tab(mgr, i) then
      return i, "fallback_manual"
    end
  end

  return nil, "no_manual_tab"
end

function cmo_qaw_get_class(obj)
  local mgr = cmo_qaw_manager()
  if not mgr or not obj or type(mgr.CanAddItem) ~= "function" then
    return nil
  end

  local ok, result = pcall(mgr.CanAddItem, mgr, obj, obj:section())
  if not ok then
    cmo_qaw_log(
      "can_add_error_" .. tostring(obj:section()),
      "CanAddItem failed for section=%s | %s",
      tostring(obj:section()),
      tostring(result)
    )
    return nil
  end

  return result or nil
end

function cmo_qaw_is_duplicate(mgr, tab, obj, class_name)
  local tab_data = mgr and mgr.tabs and mgr.tabs[tab] or nil
  if not tab_data or not obj or not class_name then
    return false
  end

  local class_def = mgr.classes and mgr.classes[class_name] or nil
  if class_def and class_def.is_obj then
    return tab_data.__ids and tab_data.__ids[obj:id()] == true or false
  end

  return tab_data.__sections and tab_data.__sections[obj:section()] == true or false
end

function cmo_qaw_can_add(obj, bag, mode)
  local mod = cmo_qaw_module()
  local mgr = cmo_qaw_manager()
  if not mod or not mgr or not obj then
    return false
  end

  local target = cmo_qaw_target_tab()
  local class_name = cmo_qaw_get_class(obj)
  if not target or not class_name then
    return false
  end

  local limit = (mod.MCM_SETTINGS and mod.MCM_SETTINGS.tab_slot) or 10
  local count = mgr.tabs[target] and #mgr.tabs[target] or limit
  if count >= limit then
    return false
  end

  return not cmo_qaw_is_duplicate(mgr, target, obj, class_name)
end

function cmo_qaw_label(obj, bag, mode)
  return "ui_haru_add_item_to_qaw"
end

function cmo_qaw_add(obj, bag, mode)
  local mgr = cmo_qaw_manager()
  if not mgr or not obj then
    return
  end

  local target, route = cmo_qaw_target_tab()
  local class_name = cmo_qaw_get_class(obj)
  if not target or not class_name then
    return
  end

  mgr:AddItem(target, obj, obj:section())

  local added = cmo_qaw_is_duplicate(mgr, target, obj, class_name)
  cmo_log(
    "QAW action | section=%s id=%s target_tab=%s route=%s class=%s added=%s",
    tostring(obj:section()),
    tostring(obj:id()),
    tostring(target),
    tostring(route),
    tostring(class_name),
    tostring(added)
  )
end

--- Update the table QAW passes to custom_functor_autoinject.
function cmo_qaw_patch_source_table()
  local mod = cmo_qaw_module()
  local data = mod and mod.add_to_qaw_functor or nil
  if type(data) ~= "table" then
    return false
  end

  data[1] = "add_to_qaw"
  data[2] = cmo_qaw_can_add
  data[3] = cmo_qaw_label
  data[4] = cmo_qaw_can_add
  data[5] = cmo_qaw_add
  data[6] = false

  cmo_qaw_log("source_patched", "source functor table patched before/alongside QAW startup")
  return true
end

function cmo_qaw_get_live_functor()
  local injector = custom_functor_autoinject
  if injector and type(injector.get_functor_by_name) == "function" then
    local ok, entry, slot = pcall(injector.get_functor_by_name, "add_to_qaw")
    if ok and entry then
      return entry, slot
    end
  end

  local gui = ui_inventory and ui_inventory.GUI or nil
  if gui and type(gui.get_functor_by_name) == "function" then
    local ok, entry, slot = pcall(gui.get_functor_by_name, gui, "add_to_qaw")
    if ok and entry then
      return entry, slot
    end
  end

  return nil, nil
end

function cmo_qaw_live_functor_is_ours()
  local entry, slot = cmo_qaw_get_live_functor()
  if not entry then
    return false, slot
  end

  local verified =
    entry.cond_name == cmo_qaw_can_add
    and entry.func_name == cmo_qaw_label
    and entry.cond_action == cmo_qaw_can_add
    and entry.func_action == cmo_qaw_add

  return verified, slot
end

function cmo_qaw_register_live(stage)
  cmo_qaw_patch_source_table()

  local mod = cmo_qaw_module()
  local mgr = cmo_qaw_manager()
  local injector = custom_functor_autoinject
  if not mod or not mgr
    or not injector
    or type(injector.add_functor) ~= "function" then
    return false
  end

  local ok, err = pcall(
    injector.add_functor,
    "add_to_qaw",
    cmo_qaw_can_add,
    cmo_qaw_label,
    cmo_qaw_can_add,
    cmo_qaw_add,
    false
  )

  if not ok then
    cmo_qaw_log(
      "register_error",
      "live registration failed at stage=%s | %s",
      tostring(stage),
      tostring(err)
    )
    return false
  end

  local verified, slot = cmo_qaw_live_functor_is_ours()
  if not verified then
    return false
  end

  local current, category = cmo_qaw_current_tab()
  local target, route = cmo_qaw_target_tab()
  cmo_qaw_log(
    "verified",
    "live override verified | stage=%s slot=%s current_tab=%s category=%s target_tab=%s route=%s",
    tostring(stage),
    tostring(slot),
    tostring(current),
    tostring(category),
    tostring(target),
    tostring(route)
  )
  return true
end

function cmo_qaw_stop_update_retry()
  if cmo_qaw_update_registered
    and type(UnregisterScriptCallback) == "function" then
    UnregisterScriptCallback("actor_on_update", cmo_qaw_actor_on_update)
  end
  cmo_qaw_update_registered = false
end

function cmo_qaw_actor_on_update(binder, delta)
  cmo_qaw_retry_count = cmo_qaw_retry_count + 1

  if cmo_qaw_register_live("actor_on_update") then
    cmo_qaw_stop_update_retry()
    return
  end

  if cmo_qaw_retry_count >= cmo_qaw_max_retries then
    cmo_qaw_stop_update_retry()
    cmo_qaw_log(
      "retry_exhausted",
      "late override was not verified after %s frames",
      tostring(cmo_qaw_retry_count)
    )
  end
end

function cmo_qaw_schedule_next_frame()
  cmo_qaw_retry_count = 0
  if type(RegisterScriptCallback) == "function"
    and not cmo_qaw_update_registered then
    RegisterScriptCallback("actor_on_update", cmo_qaw_actor_on_update)
    cmo_qaw_update_registered = true
  end
end

function cmo_qaw_actor_on_first_update(binder, delta)
  if cmo_qaw_first_update_registered
    and type(UnregisterScriptCallback) == "function" then
    UnregisterScriptCallback("actor_on_first_update", cmo_qaw_actor_on_first_update)
  end
  cmo_qaw_first_update_registered = false

  --- Register on the following frame after UI functors are initialized.
  cmo_qaw_schedule_next_frame()
end

function cmo_qaw_schedule_late_registration(stage)
  cmo_qaw_patch_source_table()

  if stage == "game_load" then
    cmo_qaw_schedule_next_frame()
    return
  end

  if type(RegisterScriptCallback) == "function"
    and not cmo_qaw_first_update_registered then
    RegisterScriptCallback("actor_on_first_update", cmo_qaw_actor_on_first_update)
    cmo_qaw_first_update_registered = true
  end
end

--- The main script loads settings early. A late zzzzzz bootstrap installs the hooks
--- after inventory/menu addons have finished replacing their own methods.
function on_game_start()
  load_settings()
  rebuild_label_lookup()
  if not option_callback_registered then
    RegisterScriptCallback("on_option_change", load_settings)
    option_callback_registered = true
  end

  --- Do not register the live functor here: QAW registers the same name later.
  --- Patch QAW's source table now; the late bootstrap verifies the live slot.
  cmo_qaw_patch_source_table()
end

function on_game_load()
  cmo_qaw_patch_source_table()
  rebuild_label_lookup()
end

function on_game_end()
  if option_callback_registered and type(UnregisterScriptCallback) == "function" then
    UnregisterScriptCallback("on_option_change", load_settings)
  end
  option_callback_registered = false
  cmo_qaw_stop_update_retry()
  if cmo_qaw_first_update_registered and type(UnregisterScriptCallback) == "function" then
    UnregisterScriptCallback("actor_on_first_update", cmo_qaw_actor_on_first_update)
  end
  cmo_qaw_first_update_registered = false
  rebuild_label_lookup()
  pending_keys_mismatch_logged = false
end

