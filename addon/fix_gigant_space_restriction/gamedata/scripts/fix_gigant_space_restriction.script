-- Gigant Space Restriction Crash Fix
-- Anomaly 1.5.3 / Anthology 2.1
--
-- CPseudoGigant::reinit fatals in CSpaceRestrictionBridge::initialized when
-- a gigant goes online again after a level leave/return. First load of a save
-- already on that level works: the client object is restored, not rebuilt.
-- Re-entry calls net_Spawn / CRestrictedObject and path-builder reinit.
--
-- Lua binders run after that spawn, so actor_on_update cannot win the race.
-- CSE m_out/m_in_space_restrictors are not exported (lua_help has no such
-- properties on cse_alife_monster_abstract). Writing them is a no-op.
--
-- This addon never keys off numeric ALife ids (id_cleaner remaps them).
-- Off-level and current-level-offline gigants stay offline via
-- set_switch_online(false) + se_monster.can_switch_online wrap until
-- actor_on_first_update on their level. Leaving a level re-quarantines
-- current-level gigants. Dangling client restrictors, a dead graph vertex
-- or a missing smart terrain: alife_release (squad-safe) while offline.

local LOG_TAG = "[fix_gigant_space_restriction]"
local VERSION = "1.1.0"
local EVENT_ID = "fix_gigant_space_restriction"
local PROCESS_ACTION = "process"
local PROCESS_DELAY = 0.05
local INVALID_ID = 65535
-- bind_anomaly_field.script:569-575
local RESTRICTOR_TYPE_IN = 4
local RESTRICTOR_TYPE_OUT = 5

local callbacks_registered = false
local orig_can_switch_online = nil
local level_ready = false
local process_scheduled = false

local known_ids = {}
local known_names = {}
local quarantined = {}
local dangling_seen = {}
local released = {}

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

local function reset_state()
	known_ids = {}
	known_names = {}
	quarantined = {}
	dangling_seen = {}
	released = {}
	level_ready = false
	process_scheduled = false
	if type(RemoveTimeEvent) == "function" then
		pcall(RemoveTimeEvent, EVENT_ID, PROCESS_ACTION)
	end
end

local function get_sim()
	if type(alife) ~= "function" then
		return nil
	end
	local ok, sim = pcall(alife)
	return ok and sim or nil
end

local function object_id(se_obj)
	if not se_obj then
		return nil
	end
	return se_obj.id
end

local function object_name(se_obj)
	if not se_obj then
		return nil
	end
	local ok, name = pcall(function()
		return se_obj:name()
	end)
	return ok and name or nil
end

local function object_section(se_obj)
	if not se_obj then
		return nil
	end
	local ok, section = pcall(function()
		return se_obj:section_name()
	end)
	return ok and section or nil
end

local function object_clsid(se_obj)
	if not se_obj then
		return nil
	end
	local ok, value = pcall(function()
		return se_obj:clsid()
	end)
	return ok and value or nil
end

local function object_online(se_obj)
	if not se_obj then
		return nil
	end
	local ok, value = pcall(function()
		return se_obj.online
	end)
	if ok then
		return value
	end
	return nil
end

local function object_level(sim, se_obj)
	if not (sim and se_obj and se_obj.m_game_vertex_id) then
		return nil
	end
	local ok, name = pcall(function()
		local gg = game_graph()
		if not gg then
			return nil
		end
		local gv = gg:vertex(se_obj.m_game_vertex_id)
		if not gv then
			return nil
		end
		return sim:level_name(gv:level_id())
	end)
	return ok and name or nil
end

local function current_level_name()
	if not (level and type(level.name) == "function") then
		return nil
	end
	local ok, name = pcall(level.name)
	return ok and name or nil
end

local function se_by_id(sim, id)
	if not (sim and id) then
		return nil
	end
	local ok, se_obj = pcall(function()
		return sim:object(id)
	end)
	return ok and se_obj or nil
end

local function is_gigant(se_obj)
	if clsid and clsid.gigant_s then
		if object_clsid(se_obj) == clsid.gigant_s then
			return true
		end
	end
	local section = object_section(se_obj)
	return type(section) == "string" and string.find(section, "^gigant") ~= nil
end

local function remember_name(se_obj)
	local name = object_name(se_obj)
	local id = object_id(se_obj)
	if type(name) == "string" and name ~= "" and id then
		known_names[name] = id
	end
end

local function remember_gigant(se_obj)
	local id = object_id(se_obj)
	if id then
		known_ids[id] = true
	end
	return id
end

local function queued_ids()
	local ids = {}
	for id, _ in pairs(known_ids) do
		ids[#ids + 1] = id
	end
	return ids
end

local function on_current_level(sim, se_obj)
	local here = current_level_name()
	if not here then
		return false
	end
	return object_level(sim, se_obj) == here
end

local function graph_vertex_ok(se_obj)
	if not se_obj then
		return true
	end
	local ok, good = pcall(function()
		local gg = game_graph()
		if not gg or se_obj.m_game_vertex_id == nil then
			return true
		end
		return gg:vertex(se_obj.m_game_vertex_id) ~= nil
	end)
	return (not ok) or good
end

local function smart_ok(sim, se_obj)
	if not (sim and se_obj) then
		return true
	end
	local sid = se_obj.m_smart_terrain_id
	if sid == nil or sid == INVALID_ID then
		return true
	end
	return se_by_id(sim, sid) ~= nil
end

local function restrictor_type(kind)
	if kind == "in" then
		return RESTRICTOR_TYPE_IN
	end
	return RESTRICTOR_TYPE_OUT
end

local function set_can_switch_online(sim, id, enabled)
	if not (sim and id) then
		return false
	end
	if type(sim.set_switch_online) ~= "function" then
		return false
	end
	local ok = pcall(function()
		sim:set_switch_online(id, enabled)
	end)
	return ok
end

local function get_game_object(id)
	if not id then
		return nil
	end
	if level and type(level.object_by_id) == "function" then
		local ok, go = pcall(level.object_by_id, id)
		if ok and go then
			return go
		end
	end
	if db and db.storage and db.storage[id] then
		return db.storage[id].object
	end
	return nil
end

local function parse_restriction_names(raw)
	local names = {}
	if type(raw) ~= "string" or raw == "" then
		return names
	end
	if type(parse_names) == "function" then
		local ok, parsed = pcall(parse_names, raw)
		if ok and type(parsed) == "table" then
			for i = 1, #parsed do
				local name = parsed[i]
				if type(name) == "string" and name ~= "" then
					names[#names + 1] = name
				end
			end
			return names
		end
	end
	for part in string.gmatch(raw, "[^,]+") do
		local name = string.match(part, "^%s*(.-)%s*$")
		if name and name ~= "" then
			names[#names + 1] = name
		end
	end
	return names
end

local function read_game_restriction_names(go)
	local names = {}
	if not go then
		return names
	end
	local getters = {
		"out_restrictions",
		"in_restrictions",
		"base_out_restrictions",
		"base_in_restrictions",
	}
	for i = 1, #getters do
		local getter = getters[i]
		if type(go[getter]) == "function" then
			local ok, raw = pcall(function()
				return go[getter](go)
			end)
			if ok then
				local parsed = parse_restriction_names(raw)
				for j = 1, #parsed do
					names[#names + 1] = parsed[j]
				end
			end
		end
	end
	return names
end

local function dangling_client_restrictors(sim, se_obj, go)
	local missing = {}
	local names = read_game_restriction_names(go)
	if #names == 0 then
		return missing
	end
	local gigant_level = object_level(sim, se_obj)
	for i = 1, #names do
		local name = names[i]
		local rid = known_names[name]
		if not rid then
			missing[#missing + 1] = name
		elseif gigant_level then
			local other = se_by_id(sim, rid)
			if object_level(sim, other) ~= gigant_level then
				missing[#missing + 1] = name
			end
		end
	end
	return missing
end

local function strip_dynamic_restrictions(sim, id)
	if not (sim and id) then
		return
	end
	if type(sim.remove_all_restrictions) == "function" then
		pcall(function()
			sim:remove_all_restrictions(id, restrictor_type("in"))
		end)
		pcall(function()
			sim:remove_all_restrictions(id, restrictor_type("out"))
		end)
	end
	local go = get_game_object(id)
	if go and type(go.remove_all_restrictions) == "function" then
		pcall(function()
			go:remove_all_restrictions()
		end)
	end
end

local function clear_smart_if_dangling(sim, se_obj)
	if smart_ok(sim, se_obj) then
		return true
	end
	local ok = pcall(function()
		se_obj.m_smart_terrain_id = INVALID_ID
	end)
	return ok and smart_ok(sim, se_obj)
end

local function quarantine(sim, se_obj, reason)
	local id = object_id(se_obj)
	if not id or released[id] then
		return
	end
	local first = quarantined[id] == nil
	quarantined[id] = reason or "queued"
	set_can_switch_online(sim, id, false)
	if not first then
		return
	end
	log(
		"quarantine id=%s name=%s section=%s reason=%s",
		tostring(id),
		tostring(object_name(se_obj)),
		tostring(object_section(se_obj)),
		tostring(quarantined[id])
	)
end

local function allow_online(sim, se_obj)
	local id = object_id(se_obj)
	if not id then
		return
	end
	quarantined[id] = nil
	set_can_switch_online(sim, id, true)
end

local function release_gigant(sim, se_obj, reason)
	local id = object_id(se_obj)
	if not (sim and se_obj and id) then
		return false
	end
	if object_online(se_obj) == true then
		log("skip release, still online id=%s", tostring(id))
		return false
	end

	log(
		"release id=%s name=%s section=%s reason=%s",
		tostring(id),
		tostring(object_name(se_obj)),
		tostring(object_section(se_obj)),
		tostring(reason)
	)

	local released_ok = false
	if type(alife_release) == "function" then
		local ok, result = pcall(alife_release, se_obj)
		released_ok = ok and result and true or false
	end
	if not released_ok then
		released_ok = pcall(function()
			sim:release(se_obj, true)
		end)
	end

	quarantined[id] = nil
	dangling_seen[id] = nil
	if released_ok then
		released[id] = true
		known_ids[id] = nil
	end
	return released_ok
end

local function inspect_online(sim, se_obj)
	local id = object_id(se_obj)
	if not id then
		return
	end
	local go = get_game_object(id)
	local missing = dangling_client_restrictors(sim, se_obj, go)
	if #missing > 0 then
		dangling_seen[id] = table.concat(missing, ",")
		strip_dynamic_restrictions(sim, id)
		log(
			"dangling restrictors id=%s names=%s",
			tostring(id),
			dangling_seen[id]
		)
	end
end

local function process_one(sim, se_obj, reason)
	local id = object_id(se_obj)
	if not id or released[id] then
		return
	end
	if not is_gigant(se_obj) then
		known_ids[id] = nil
		quarantined[id] = nil
		return
	end

	if not graph_vertex_ok(se_obj) then
		if object_online(se_obj) == true then
			quarantine(sim, se_obj, "invalid_game_vertex")
			return
		end
		if release_gigant(sim, se_obj, "invalid_game_vertex") then
			log("removed unsafe gigant id=%s via=%s", tostring(id), tostring(reason))
		end
		return
	end

	if not clear_smart_if_dangling(sim, se_obj) then
		if object_online(se_obj) == true then
			quarantine(sim, se_obj, "dangling_smart_terrain")
			return
		end
		if release_gigant(sim, se_obj, "dangling_smart_terrain") then
			log("removed unsafe gigant id=%s via=%s", tostring(id), tostring(reason))
		end
		return
	end

	if object_online(se_obj) == true then
		inspect_online(sim, se_obj)
		if dangling_seen[id] then
			quarantine(sim, se_obj, "dangling_restrictors:" .. dangling_seen[id])
		end
		return
	end

	if dangling_seen[id] then
		strip_dynamic_restrictions(sim, id)
		if release_gigant(sim, se_obj, "dangling_restrictors:" .. dangling_seen[id]) then
			log("removed unsafe gigant id=%s via=%s", tostring(id), tostring(reason))
		end
		return
	end

	if not on_current_level(sim, se_obj) then
		if not quarantined[id] then
			quarantine(sim, se_obj, "off_level")
		end
		return
	end

	if not level_ready then
		if not quarantined[id] then
			quarantine(sim, se_obj, "level_not_ready")
		end
		return
	end

	allow_online(sim, se_obj)
	log(
		"safe id=%s name=%s via=%s",
		tostring(id),
		tostring(object_name(se_obj)),
		tostring(reason)
	)
end

local function process_all(sim, reason)
	if not sim then
		return
	end
	local ids = queued_ids()
	for i = 1, #ids do
		local id = ids[i]
		local se_obj = se_by_id(sim, id)
		if se_obj then
			process_one(sim, se_obj, reason)
		else
			known_ids[id] = nil
			quarantined[id] = nil
			dangling_seen[id] = nil
			released[id] = true
		end
	end
end

function process_tick()
	process_scheduled = false
	local sim = get_sim()
	if not sim then
		return true
	end
	process_all(sim, "queued")
	return true
end

local function schedule_process()
	if process_scheduled then
		return
	end
	if type(CreateTimeEvent) ~= "function" then
		process_tick()
		return
	end
	process_scheduled = true
	CreateTimeEvent(EVENT_ID, PROCESS_ACTION, PROCESS_DELAY, process_tick)
end

local function quarantine_current_level(sim, reason)
	if not sim then
		return
	end
	level_ready = false
	local ids = queued_ids()
	for i = 1, #ids do
		local id = ids[i]
		if not released[id] then
			local se_obj = se_by_id(sim, id)
			if se_obj and is_gigant(se_obj) and on_current_level(sim, se_obj) then
				if object_online(se_obj) == true then
					inspect_online(sim, se_obj)
				end
				quarantine(sim, se_obj, reason)
			end
		end
	end
end

function patched_can_switch_online(self, ...)
	if select("#", ...) == 0 and self then
		local id = self.id
		if id and quarantined[id] then
			return false
		end
	end
	if orig_can_switch_online then
		return orig_can_switch_online(self, ...)
	end
	if cse_alife_monster_base and type(cse_alife_monster_base.can_switch_online) == "function" then
		return cse_alife_monster_base.can_switch_online(self, ...)
	end
	return true
end

local function install_can_switch_online()
	if type(se_monster) ~= "table" then
		log("se_monster table missing; can_switch_online wrap skipped")
		return
	end
	if se_monster.can_switch_online == patched_can_switch_online then
		return
	end
	orig_can_switch_online = orig_can_switch_online or se_monster.can_switch_online
	se_monster.can_switch_online = patched_can_switch_online
	log("wrapped se_monster.can_switch_online")
end

local function uninstall_can_switch_online()
	if type(se_monster) == "table" and se_monster.can_switch_online == patched_can_switch_online then
		se_monster.can_switch_online = orig_can_switch_online
	end
end

function server_entity_on_register(se_obj, type_name)
	remember_name(se_obj)
	if not is_gigant(se_obj) then
		return
	end

	local id = remember_gigant(se_obj)
	if not id or released[id] then
		return
	end

	local sim = get_sim()
	if not graph_vertex_ok(se_obj) then
		quarantine(sim, se_obj, "invalid_game_vertex")
		schedule_process()
		return
	end
	if not smart_ok(sim, se_obj) then
		quarantine(sim, se_obj, "dangling_smart_terrain")
		schedule_process()
		return
	end
	if object_online(se_obj) == true then
		return
	end
	if on_current_level(sim, se_obj) and level_ready then
		process_one(sim, se_obj, "server_entity_on_register")
		return
	end
	quarantine(sim, se_obj, on_current_level(sim, se_obj) and "level_not_ready" or "off_level")
	schedule_process()
end

function actor_on_first_update()
	level_ready = true
	local sim = get_sim()
	process_all(sim, "actor_on_first_update")
end

function on_before_level_changing()
	quarantine_current_level(get_sim(), "on_before_level_changing")
end

function on_level_changing()
	quarantine_current_level(get_sim(), "on_level_changing")
end

function on_game_load()
	reset_state()
end

function on_game_start()
	reset_state()
	install_can_switch_online()
	if callbacks_registered then
		return
	end
	RegisterScriptCallback("server_entity_on_register", server_entity_on_register)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("on_before_level_changing", on_before_level_changing)
	RegisterScriptCallback("on_level_changing", on_level_changing)
	RegisterScriptCallback("on_game_load", on_game_load)
	callbacks_registered = true
	log("loaded v%s", VERSION)
end

function on_game_end()
	if type(RemoveTimeEvent) == "function" then
		pcall(RemoveTimeEvent, EVENT_ID, PROCESS_ACTION)
	end
	uninstall_can_switch_online()
	if not callbacks_registered then
		reset_state()
		return
	end
	UnregisterScriptCallback("server_entity_on_register", server_entity_on_register)
	UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
	UnregisterScriptCallback("on_before_level_changing", on_before_level_changing)
	UnregisterScriptCallback("on_level_changing", on_level_changing)
	UnregisterScriptCallback("on_game_load", on_game_load)
	callbacks_registered = false
	reset_state()
end
