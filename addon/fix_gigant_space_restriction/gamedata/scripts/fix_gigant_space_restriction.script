-- Gigant Space Restriction Crash Fix
-- Anomaly 1.5.3 / Anthology 2.1
--
-- CPseudoGigant::reinit fatals in CSpaceRestriction while the client object
-- is constructed. CRestrictedObject::net_Spawn copies
-- CSE_ALifeMonsterAbstract.m_out/in_space_restrictors and then
-- space_restriction_manager().restrict(). Lua binders run after that, so
-- actor_on_first_update cannot win the race.
--
-- ZIP v1.0.1 deleted a hardcoded ALife id (40604). id_cleaner remaps ids:
-- later loads saw conserva / lights_hanging_lamp on that id and the script
-- no-op'd every session. Dead City needed a different id (24062) for the
-- same crash class.
--
-- This addon never keys off numeric ids. On server_entity_on_register it
-- quarantines a current-level gigant that still carries static restrictor
-- strings (or a broken graph/smart) via set_switch_online(false) and a
-- can_switch_online wrap. After ALife has registered, it clears dangling
-- restrictors and lets a healthy monster back online. If the strings cannot
-- be cleared, the object is released with alife_release (squad-safe).

local LOG_TAG = "[fix_gigant_space_restriction]"
local VERSION = "1.0.0"
local EVENT_ID = "fix_gigant_space_restriction"
local PROCESS_ACTION = "process"
local PROCESS_DELAY = 0.05
local INVALID_ID = 65535
local RESTRICTOR_TYPE_IN = 4
local RESTRICTOR_TYPE_OUT = 5

local callbacks_registered = false
local orig_can_switch_online = nil
local known_names = {}
local quarantined = {}
local processed = {}
local process_scheduled = false

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

local function reset_state()
	known_names = {}
	quarantined = {}
	processed = {}
	process_scheduled = false
	if type(RemoveTimeEvent) == "function" then
		pcall(RemoveTimeEvent, EVENT_ID, PROCESS_ACTION)
	end
end

local function get_sim()
	if type(alife) ~= "function" then
		return nil
	end
	local ok, sim = pcall(alife)
	return ok and sim or nil
end

local function object_id(se_obj)
	if not se_obj then
		return nil
	end
	return se_obj.id
end

local function object_name(se_obj)
	if not se_obj then
		return nil
	end
	local ok, name = pcall(function()
		return se_obj:name()
	end)
	return ok and name or nil
end

local function object_section(se_obj)
	if not se_obj then
		return nil
	end
	local ok, section = pcall(function()
		return se_obj:section_name()
	end)
	return ok and section or nil
end

local function object_clsid(se_obj)
	if not se_obj then
		return nil
	end
	local ok, value = pcall(function()
		return se_obj:clsid()
	end)
	return ok and value or nil
end

local function object_online(se_obj)
	if not se_obj then
		return nil
	end
	local ok, value = pcall(function()
		return se_obj.online
	end)
	if ok then
		return value
	end
	return nil
end

local function object_level(sim, se_obj)
	if not (sim and se_obj and se_obj.m_game_vertex_id) then
		return nil
	end
	local ok, name = pcall(function()
		local gg = game_graph()
		if not gg then
			return nil
		end
		local gv = gg:vertex(se_obj.m_game_vertex_id)
		if not gv then
			return nil
		end
		return sim:level_name(gv:level_id())
	end)
	return ok and name or nil
end

local function current_level_name()
	if not (level and type(level.name) == "function") then
		return nil
	end
	local ok, name = pcall(level.name)
	return ok and name or nil
end

local function se_by_id(sim, id)
	if not (sim and id) then
		return nil
	end
	local ok, se_obj = pcall(function()
		return sim:object(id)
	end)
	return ok and se_obj or nil
end

local function is_gigant(se_obj)
	local section = object_section(se_obj)
	if type(section) == "string" and string.find(section, "^gigant") then
		return true
	end
	if clsid and clsid.gigant_s then
		return object_clsid(se_obj) == clsid.gigant_s
	end
	return false
end

local function read_field_string(se_obj, field)
	if not se_obj then
		return nil, false
	end
	local ok, value = pcall(function()
		return se_obj[field]
	end)
	if not ok then
		return nil, false
	end
	if value == nil then
		return nil, false
	end
	if type(value) == "string" then
		return value, true
	end
	local as_text = tostring(value)
	if as_text == nil or as_text == "nil" or string.find(as_text, "^userdata") then
		return nil, true
	end
	return as_text, true
end

local function write_field_string(se_obj, field, value)
	if not se_obj then
		return false
	end
	local ok = pcall(function()
		se_obj[field] = value
	end)
	if not ok then
		return false
	end
	local now = read_field_string(se_obj, field)
	if value == "" then
		return now == nil or now == ""
	end
	return now == value
end

local function split_names(raw)
	local names = {}
	if type(raw) ~= "string" or raw == "" then
		return names
	end
	for part in string.gmatch(raw, "[^,]+") do
		local name = string.match(part, "^%s*(.-)%s*$")
		if name and name ~= "" then
			names[#names + 1] = name
		end
	end
	return names
end

local function restrictor_type(kind)
	if RestrictionSpace then
		if kind == "in" then
			return RestrictionSpace.eRestrictorTypeIn or RESTRICTOR_TYPE_IN
		end
		return RestrictionSpace.eRestrictorTypeOut or RESTRICTOR_TYPE_OUT
	end
	if kind == "in" then
		return RESTRICTOR_TYPE_IN
	end
	return RESTRICTOR_TYPE_OUT
end

local function remember_name(se_obj)
	local name = object_name(se_obj)
	local id = object_id(se_obj)
	if type(name) == "string" and name ~= "" and id then
		known_names[name] = id
	end
end

local function dangling_restrictors(sim, se_obj)
	local out_raw, out_ok = read_field_string(se_obj, "m_out_space_restrictors")
	local in_raw, in_ok = read_field_string(se_obj, "m_in_space_restrictors")
	if not (out_ok or in_ok) then
		return nil
	end

	local gigant_level = object_level(sim, se_obj)
	local missing = {}
	local function check(raw)
		local names = split_names(raw)
		for i = 1, #names do
			local name = names[i]
			local rid = known_names[name]
			if not rid then
				missing[#missing + 1] = name
			elseif gigant_level then
				local other = se_by_id(sim, rid)
				if object_level(sim, other) ~= gigant_level then
					missing[#missing + 1] = name
				end
			end
		end
	end
	check(out_raw)
	check(in_raw)
	return missing
end

local function graph_vertex_ok(se_obj)
	if not se_obj then
		return true
	end
	local ok, good = pcall(function()
		local gg = game_graph()
		if not gg or se_obj.m_game_vertex_id == nil then
			return true
		end
		return gg:vertex(se_obj.m_game_vertex_id) ~= nil
	end)
	return (not ok) or good
end

local function smart_ok(sim, se_obj)
	if not (sim and se_obj) then
		return true
	end
	local sid = se_obj.m_smart_terrain_id
	if sid == nil or sid == INVALID_ID then
		return true
	end
	return se_by_id(sim, sid) ~= nil
end

local function on_current_level(sim, se_obj)
	local here = current_level_name()
	if not here then
		return false
	end
	return object_level(sim, se_obj) == here
end

local function needs_quarantine(sim, se_obj)
	if not graph_vertex_ok(se_obj) then
		return true, "invalid_game_vertex"
	end
	if not smart_ok(sim, se_obj) then
		return true, "dangling_smart_terrain"
	end

	local out_raw, out_ok = read_field_string(se_obj, "m_out_space_restrictors")
	local in_raw, in_ok = read_field_string(se_obj, "m_in_space_restrictors")
	if not (out_ok or in_ok) then
		-- Fields not exported: only current-level gigants are unsafe to spawn.
		if on_current_level(sim, se_obj) then
			return true, "restrictor_fields_unreadable"
		end
		return false, nil
	end

	if (out_raw and out_raw ~= "") or (in_raw and in_raw ~= "") then
		return true, "has_static_restrictors"
	end
	return false, nil
end

local function set_can_switch_online(sim, id, enabled)
	if not (sim and id) then
		return false
	end
	if type(sim.set_switch_online) ~= "function" then
		return false
	end
	local ok = pcall(function()
		sim:set_switch_online(id, enabled)
	end)
	return ok
end

local function quarantine(sim, se_obj, reason)
	local id = object_id(se_obj)
	if not id or quarantined[id] then
		return
	end
	quarantined[id] = reason or "queued"
	set_can_switch_online(sim, id, false)
	log(
		"quarantine id=%s name=%s section=%s reason=%s",
		tostring(id),
		tostring(object_name(se_obj)),
		tostring(object_section(se_obj)),
		tostring(quarantined[id])
	)
end

local function allow_online(sim, id)
	if not id then
		return
	end
	quarantined[id] = nil
	set_can_switch_online(sim, id, true)
end

local function clear_dynamic_restrictions(sim, id)
	if not (sim and id and type(sim.remove_all_restrictions) == "function") then
		return
	end
	pcall(function()
		sim:remove_all_restrictions(id, restrictor_type("in"))
	end)
	pcall(function()
		sim:remove_all_restrictions(id, restrictor_type("out"))
	end)
end

local function clear_static_restrictors(se_obj)
	local out_ok = write_field_string(se_obj, "m_out_space_restrictors", "")
	local in_ok = write_field_string(se_obj, "m_in_space_restrictors", "")
	return out_ok and in_ok
end

local function clear_smart_if_dangling(sim, se_obj)
	if smart_ok(sim, se_obj) then
		return true
	end
	local ok = pcall(function()
		se_obj.m_smart_terrain_id = INVALID_ID
	end)
	return ok and smart_ok(sim, se_obj)
end

local function release_gigant(sim, se_obj, reason)
	local id = object_id(se_obj)
	if not (sim and se_obj and id) then
		return false
	end
	if object_online(se_obj) == true then
		log("skip release, already online id=%s", tostring(id))
		return false
	end

	log(
		"release id=%s name=%s section=%s reason=%s",
		tostring(id),
		tostring(object_name(se_obj)),
		tostring(object_section(se_obj)),
		tostring(reason)
	)

	local ok = false
	if type(alife_release) == "function" then
		ok = pcall(alife_release, se_obj)
	end
	if not ok then
		ok = pcall(function()
			sim:release(se_obj, true)
		end)
	end

	quarantined[id] = nil
	processed[id] = true
	return ok
end

-- ok, detail. Does not strip restrictors that still exist in ALife.
local function heal_gigant(sim, se_obj)
	local id = object_id(se_obj)
	if not (sim and se_obj and id) then
		return false, "no_object"
	end

	if not graph_vertex_ok(se_obj) then
		return false, "invalid_game_vertex"
	end

	clear_smart_if_dangling(sim, se_obj)

	local missing = dangling_restrictors(sim, se_obj)
	if type(missing) == "table" and #missing == 0 then
		return true, "restrictors_ok"
	end

	clear_dynamic_restrictions(sim, id)
	local static_cleared = clear_static_restrictors(se_obj)

	if type(missing) == "table" and #missing > 0 then
		if static_cleared then
			return true, "cleared_dangling:" .. table.concat(missing, ",")
		end
		return false, "dangling_restrictors:" .. table.concat(missing, ",")
	end

	if static_cleared then
		return true, "cleared_unreadable_static"
	end
	return false, "static_restrictors_not_writable"
end

local function process_one(sim, se_obj, reason)
	local id = object_id(se_obj)
	if not id or processed[id] then
		return
	end
	if not is_gigant(se_obj) then
		processed[id] = true
		quarantined[id] = nil
		return
	end
	if object_online(se_obj) == true then
		processed[id] = true
		quarantined[id] = nil
		log("already online, skip id=%s", tostring(id))
		return
	end

	local ok, detail = heal_gigant(sim, se_obj)
	if ok then
		allow_online(sim, id)
		processed[id] = true
		log(
			"safe id=%s name=%s via=%s detail=%s",
			tostring(id),
			tostring(object_name(se_obj)),
			tostring(reason),
			tostring(detail)
		)
		return
	end

	if release_gigant(sim, se_obj, detail) then
		log("removed unsafe gigant id=%s via=%s", tostring(id), tostring(reason))
	else
		log("ERROR could not heal or release id=%s detail=%s", tostring(id), tostring(detail))
	end
end

local function queued_ids()
	local ids = {}
	for id, _ in pairs(quarantined) do
		ids[#ids + 1] = id
	end
	return ids
end

function process_tick()
	process_scheduled = false
	local sim = get_sim()
	if not sim then
		return true
	end

	local ids = queued_ids()
	for i = 1, #ids do
		local id = ids[i]
		local se_obj = se_by_id(sim, id)
		if se_obj then
			process_one(sim, se_obj, "queued")
		else
			quarantined[id] = nil
			processed[id] = true
		end
	end
	return true
end

local function schedule_process()
	if process_scheduled then
		return
	end
	if type(CreateTimeEvent) ~= "function" then
		process_tick()
		return
	end
	process_scheduled = true
	CreateTimeEvent(EVENT_ID, PROCESS_ACTION, PROCESS_DELAY, process_tick)
end

function patched_can_switch_online(self, ...)
	if self then
		local id = self.id
		if id and quarantined[id] then
			return false
		end
	end
	if orig_can_switch_online then
		return orig_can_switch_online(self, ...)
	end
	if cse_alife_monster_base and type(cse_alife_monster_base.can_switch_online) == "function" then
		return cse_alife_monster_base.can_switch_online(self, ...)
	end
	return true
end

local function install_can_switch_online()
	if type(se_monster) ~= "table" then
		log("se_monster table missing; can_switch_online wrap skipped")
		return
	end
	if se_monster.can_switch_online == patched_can_switch_online then
		return
	end
	orig_can_switch_online = orig_can_switch_online or se_monster.can_switch_online
	se_monster.can_switch_online = patched_can_switch_online
	log("wrapped se_monster.can_switch_online")
end

local function uninstall_can_switch_online()
	if type(se_monster) == "table" and se_monster.can_switch_online == patched_can_switch_online then
		se_monster.can_switch_online = orig_can_switch_online
	end
end

function server_entity_on_register(se_obj, type_name)
	remember_name(se_obj)
	if not is_gigant(se_obj) then
		return
	end

	local id = object_id(se_obj)
	if not id or processed[id] then
		return
	end

	local sim = get_sim()
	local risky, reason = needs_quarantine(sim, se_obj)
	if not risky then
		return
	end

	quarantine(sim, se_obj, reason)
	schedule_process()
end

function actor_on_first_update()
	schedule_process()
end

function on_before_level_changing()
	local sim = get_sim()
	if not sim then
		return
	end
	local ids = queued_ids()
	for i = 1, #ids do
		local id = ids[i]
		local se_obj = se_by_id(sim, id)
		if se_obj then
			process_one(sim, se_obj, "on_before_level_changing")
		else
			quarantined[id] = nil
			processed[id] = true
		end
	end
end

function on_game_load()
	reset_state()
end

function on_game_start()
	reset_state()
	install_can_switch_online()
	if callbacks_registered then
		return
	end
	RegisterScriptCallback("server_entity_on_register", server_entity_on_register)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("on_before_level_changing", on_before_level_changing)
	RegisterScriptCallback("on_game_load", on_game_load)
	callbacks_registered = true
	log("loaded v%s", VERSION)
end

function on_game_end()
	if type(RemoveTimeEvent) == "function" then
		pcall(RemoveTimeEvent, EVENT_ID, PROCESS_ACTION)
	end
	uninstall_can_switch_online()
	if not callbacks_registered then
		reset_state()
		return
	end
	UnregisterScriptCallback("server_entity_on_register", server_entity_on_register)
	UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
	UnregisterScriptCallback("on_before_level_changing", on_before_level_changing)
	UnregisterScriptCallback("on_game_load", on_game_load)
	callbacks_registered = false
	reset_state()
end
