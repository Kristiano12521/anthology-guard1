-- Trader Restock Callback Fix
-- Anomaly 1.5.3 / Anthology 2.1
--
-- load-order: ˜˜˜˜˜ axr_main.script
-- aaa_* file-load runs before barter_core / exo_loot on_game_start
-- Register. axr_main file_list_open_ex has no extra sort, so
-- on_game_start order is not a safe place to first-Add.
--
-- Declares trader_on_restock at file load. Chain-wraps
-- trader_autoinject.timed_update in on_game_start and Sends if the
-- original did not. Campfires overlay strips Add and Send; vanilla
-- and BHS Send inside timed_update. Later BHS Add is a no-op via
-- axr_main.callback_add wrap.

local LOG_TAG = "[fix_trader_restock_callback]"
local VERSION = "1.0.3"
local CALLBACK = "trader_on_restock"

local declare_result = "pending"
local orig_timed = nil
local wrap_status = "pending"
local wrap_ran = false
local subscriber_got = false
local warned_no_subscriber = false

-- intercepts is local in axr_main.script:49; there is no callback_exists.
-- callback_add (axr_main.script:246) on a live name prints
-- "![axr_main callback_add] callback %s already exists!" via _G.printf
-- (_g.script:612) and callstack(), and keeps the table.
-- A bare `printf = ...` writes this file's env, not _G - axr_main never
-- sees it. Wrap _G.printf / _G.callstack for our Add. After the first
-- Add, wrap axr_main.callback_add so a later BHS Add is a no-op.
local orig_callback_add = nil
local wrapped_callback_add = nil
local restock_declared = false

local function wrap_callback_add()
	if wrapped_callback_add then
		return
	end
	if type(axr_main) ~= "table" or type(axr_main.callback_add) ~= "function" then
		return
	end
	orig_callback_add = axr_main.callback_add
	wrapped_callback_add = function(name)
		if name == CALLBACK and restock_declared then
			return
		end
		orig_callback_add(name)
		if name == CALLBACK then
			restock_declared = true
		end
	end
	axr_main.callback_add = wrapped_callback_add
end

local function unwrap_callback_add()
	if orig_callback_add and type(axr_main) == "table"
		and axr_main.callback_add == wrapped_callback_add then
		axr_main.callback_add = orig_callback_add
	end
	orig_callback_add = nil
	wrapped_callback_add = nil
end

local function declare()
	if type(AddScriptCallback) ~= "function" then
		return "missing"
	end

	local duplicate = false
	local orig_printf = _G.printf
	local orig_callstack = _G.callstack

	_G.printf = function(fmt, ...)
		if type(fmt) == "string"
			and string.find(fmt, "callback_add", 1, true)
			and string.find(fmt, "already exists", 1, true)
		then
			duplicate = true
			return
		end
		if orig_printf then
			return orig_printf(fmt, ...)
		end
	end
	_G.callstack = function() end

	local ok, err = pcall(AddScriptCallback, CALLBACK)

	_G.printf = orig_printf
	_G.callstack = orig_callstack

	restock_declared = true
	wrap_callback_add()

	if not ok then
		if orig_printf then
			orig_printf("%s AddScriptCallback failed: %s", LOG_TAG, tostring(err))
		end
		return "error"
	end
	if duplicate then
		return "exists"
	end
	return "added"
end

declare_result = declare()
printf("%s trader_on_restock %s v%s", LOG_TAG, declare_result, VERSION)

local function reset_session()
	wrap_ran = false
	subscriber_got = false
	warned_no_subscriber = false
end

local function on_restock_probe()
	subscriber_got = true
end

-- Vanilla timed_update and BHS patched_timed_update pass a game_object.
-- BHS CreateTimeEvent may pass a numeric id; if orig already bailed on a
-- dead id, do not Send that number to exo_loot.spawn_psus.
local function is_npc_object(npc)
	if npc == nil or type(npc) == "number" then
		return false
	end
	local ok, id = pcall(function()
		return npc:id()
	end)
	return ok and type(id) == "number"
end

-- Orig Send is inside orig, before we run. A session flag cannot see it.
-- SendScriptCallback (_g.script:112) dispatches through axr_main.make_callback
-- (axr_main.script:280). Vanilla trader_autoinject.script:66 and BHS
-- zzzzzz patch :183 both call SendScriptCallback; Campfires timed_update
-- does not. Hook make_callback only for the orig call.
local function orig_already_sent(npc)
	local sent = false
	local orig_make = nil
	if type(axr_main) == "table" and type(axr_main.make_callback) == "function" then
		orig_make = axr_main.make_callback
		axr_main.make_callback = function(name, ...)
			if name == CALLBACK then
				sent = true
			end
			return orig_make(name, ...)
		end
	end

	local ok, result = pcall(orig_timed, npc)

	if orig_make then
		axr_main.make_callback = orig_make
	end

	return ok, result, sent
end

local function patched_timed_update(npc)
	wrap_ran = true

	local ok, result, sent = orig_already_sent(npc)
	if not ok then
		printf("%s timed_update orig failed: %s", LOG_TAG, tostring(result))
		result = true
	elseif not sent and is_npc_object(npc) and type(SendScriptCallback) == "function" then
		SendScriptCallback(CALLBACK, npc)
	end

	if wrap_ran and not subscriber_got and not warned_no_subscriber then
		printf("%s trader_on_restock wrap ran but subscriber got nothing", LOG_TAG)
		warned_no_subscriber = true
	end

	if result == nil then
		return true
	end
	return result
end

local function install_wrap()
	if orig_timed then
		return "already"
	end
	if type(trader_autoinject) ~= "table" then
		return "skipped: no trader_autoinject"
	end
	if type(trader_autoinject.timed_update) ~= "function" then
		return "skipped: no timed_update"
	end
	orig_timed = trader_autoinject.timed_update
	trader_autoinject.timed_update = patched_timed_update
	return "installed"
end

local function uninstall_wrap()
	if orig_timed and type(trader_autoinject) == "table"
		and trader_autoinject.timed_update == patched_timed_update then
		trader_autoinject.timed_update = orig_timed
	end
	orig_timed = nil
end

function on_game_start()
	local previous = declare_result
	declare_result = declare()
	if declare_result ~= previous then
		printf("%s trader_on_restock %s v%s", LOG_TAG, declare_result, VERSION)
	end

	if type(RegisterScriptCallback) == "function" then
		RegisterScriptCallback(CALLBACK, on_restock_probe)
		RegisterScriptCallback("on_game_load", reset_session)
	end

	wrap_status = install_wrap()
	printf("%s Send wrap %s", LOG_TAG, wrap_status)
end

function on_game_end()
	if type(UnregisterScriptCallback) == "function" then
		UnregisterScriptCallback(CALLBACK, on_restock_probe)
		UnregisterScriptCallback("on_game_load", reset_session)
	end
	uninstall_wrap()
	unwrap_callback_add()
end
