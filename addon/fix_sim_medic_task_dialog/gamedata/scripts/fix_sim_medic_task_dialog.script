-- Sim specials: restore simulation task turn-in/cancel; kill duplicate
-- "any work?" when both ordered and sim give dialogs are listed.
-- Anomaly 1.5.3 / Anthology 2.1
--
-- Many specials list dm_ordered_task_* and also pick up
-- dm_sim_ordered_task_* (character_dialogs.xml / earlier inject).
-- Both give dialogs use the same player line -> duplicate menu entry.
--
-- Fix: always remove sim give (and dialog2) when ordered give is present;
-- add sim completed/cancel only if ordered completed exists without sim completed.

local LOG_TAG = "[fix_sim_medic_task_dialog]"
local VERSION = "1.0.2"

printf("%s loaded v%s", LOG_TAG, VERSION)

local ORDERED_GIVE = "dm_ordered_task_dialog"
local ORDERED_GIVE2 = "dm_ordered_task_dialog2"
local ORDERED_DONE = "dm_ordered_task_completed_dialog"
local SIM_GIVE = "dm_sim_ordered_task_dialog"
local SIM_GIVE2 = "dm_sim_ordered_task_dialog2"
local SIM_DONE = "dm_sim_ordered_task_completed_dialog"
local SIM_CANCEL = "dm_sim_ordered_task_cancel_dialog"

function on_specific_character_dialog_list(character_id, dialog_list)
	if not dialog_list or type(dialog_list.has) ~= "function" then
		return
	end

	local has_ordered_give = dialog_list:has(ORDERED_GIVE) or dialog_list:has(ORDERED_GIVE2)
	if has_ordered_give and type(dialog_list.remove) == "function" then
		local removed = false
		if dialog_list:has(SIM_GIVE) then
			dialog_list:remove(SIM_GIVE)
			removed = true
		end
		if dialog_list:has(SIM_GIVE2) then
			dialog_list:remove(SIM_GIVE2)
			removed = true
		end
		if removed then
			printf("%s removed duplicate sim give for %s", LOG_TAG, tostring(character_id))
		end
	end

	if not dialog_list:has(ORDERED_DONE) then
		return
	end
	if dialog_list:has(SIM_DONE) then
		return
	end
	if type(dialog_list.add) ~= "function" then
		return
	end

	dialog_list:add(SIM_DONE)
	dialog_list:add(SIM_CANCEL)
	printf("%s injected sim turn-in/cancel for %s", LOG_TAG, tostring(character_id))
end

function on_game_start()
	RegisterScriptCallback("on_specific_character_dialog_list", on_specific_character_dialog_list)
	printf("%s callback installed", LOG_TAG)
end

function on_game_end()
	UnregisterScriptCallback("on_specific_character_dialog_list", on_specific_character_dialog_list)
end
