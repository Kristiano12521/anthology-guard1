-- load-order: after trader_autoinject (vendor, [FIX] Campfires Anthology Compat)
-- Anthology Busy Hands Stability Fix v0.6.0 - trader_autoinject patch
--
-- Vendor trader_autoinject.script is not replaced. Functions that take an
-- npc are re-resolved from an id, because a trader can go offline between
-- levels and the old userdata is no longer valid.
-- timed_update is published by id: CreateTimeEvent passes the id, and the
-- callback looks the npc up again. If the object is gone, restock stops.
-- Furniture traders (Sidorovich, Forester) are reported as community
-- stalker. get_trader_type, supply_level and spawn_items call the original
-- only after the npc is resolved again.
--

local VERSION = "0.6.8"

local function busyhands_object_id(value)
	if type(value) == "number" then
		local id = math.floor(value)
		if id > 0 and id < 65535 then
			return id
		end
		return nil
	end

	if not value then
		return nil
	end

	local ok, id = pcall(function() return value:id() end)
	if not ok or type(id) ~= "number" then
		return nil
	end

	id = math.floor(id)
	if id <= 0 or id >= 65535 then
		return nil
	end
	return id
end

local function busyhands_resolve_trader(value)
	local id = busyhands_object_id(value)
	if not id then
		return nil, nil
	end
	local npc = level.object_by_id(id)
	if not npc then
		return nil, id
	end
	return npc, id
end

local function t2c(t)
	if not t then return nil end
	local ct = game.CTime()
	ct:set(t.Y, t.M, t.D, t.h, t.m, t.s, t.ms)
	return ct
end


local furniture = {
	["esc_m_trader"] = true,
	["red_m_lesnik"] = true
}

local blacklisted_comms = {
	["trader"] = true,
	["monster"] = true
}

-- timed_update/update/... are locals inside trader_autoinject.script (module env),
-- not bare _G. Resolve before wrapping trade_manager.update so CreateTimeEvent
-- never captures nil (see docs/pitfalls.md).
local function trader_autoinject_module()
	if type(trader_autoinject) == "table" then
		return trader_autoinject
	end
	return nil
end

local function resolve_trader_fn(name)
	local mod = trader_autoinject_module()

	if type(name) == "string" and type(_G[name]) == "function" then
		return _G[name], "bare " .. name
	end
	if mod and type(mod[name]) == "function" then
		return mod[name], "trader_autoinject." .. name
	end

	return nil, nil
end

local function publish_trader_fn(name, fn)
	local mod = trader_autoinject_module()
	if mod then
		mod[name] = fn
	end
	_G[name] = fn
end

local function install()
	if type(trade_manager) ~= "table" or type(trade_manager.update) ~= "function" then
		printf("[BusyHandsFix v%s] trade_manager.update was not found - trader_autoinject guards NOT installed", VERSION)
		return 0
	end

	local installed_count = 0

	local original_get_real_community = resolve_trader_fn("get_real_community")
	if original_get_real_community then
		local patched_get_real_community = function(npc, default)
			local live_npc = busyhands_resolve_trader(npc)
			if not live_npc then
				return default
			end
			npc = live_npc

			if furniture[npc:name()] then
				return "stalker"
			end
			local community = character_community(npc)
			if not blacklisted_comms[community] then
				return community
			end
			local squad = get_object_squad(npc)
			local squad_community = squad and squad:get_squad_community()
			if squad_community and not blacklisted_comms[squad_community] then
				return squad_community
			end
			return default
		end
		publish_trader_fn("get_real_community", patched_get_real_community)
		installed_count = installed_count + 1
	end

	local original_update = resolve_trader_fn("update")

	local original_timed_update = resolve_trader_fn("timed_update")
	local patched_timed_update = nil
	if original_timed_update then
		patched_timed_update = function(npc_or_id)
			local npc, id = busyhands_resolve_trader(npc_or_id)
			if not npc then
				printf("[BusyHandsFix v%s] Trader restock cancelled: object %s is no longer online", VERSION, tostring(id or npc_or_id))
				return true
			end
			if original_update then
				original_update(npc)
			end
			SendScriptCallback("trader_on_restock", npc)
			return true
		end
		publish_trader_fn("timed_update", patched_timed_update)
		installed_count = installed_count + 1
	else
		printf("[BusyHandsFix v%s] timed_update was not found via bare/_G/trader_autoinject - ID-based CreateTimeEvent will be skipped", VERSION)
	end

	local original_trade_manager_update = trade_manager.update
	trade_manager.update = function(npc, force_refresh)
		local live_npc, id = busyhands_resolve_trader(npc)
		if not live_npc then
			return
		end
		npc = live_npc

		local ok_alive, is_alive = pcall(function() return npc:alive() end)
		if not ok_alive or not is_alive then
			return
		end

		local reup_time = trade_manager.get_trade_profile(id, "resupply_time")
		original_trade_manager_update(npc, force_refresh)
		local restock_time = game_difficulties.get_eco_factor("restock") or 24
		if force_refresh then restock_time = 0 end
		if reup_time and game.get_game_time():diffSec(t2c(reup_time)) < (restock_time * 3600) then
			return
		end
		disable_info("sleep_active")

		if patched_timed_update then
			CreateTimeEvent("custom_update" .. id, "custom_resupply" .. id, 0.1, patched_timed_update, id)
		else
			printf("[BusyHandsFix v%s] trade_manager.update: CreateTimeEvent skipped for trader %s - timed_update not resolved", VERSION, tostring(id))
		end
	end
	installed_count = installed_count + 1

	local original_get_trader_type = resolve_trader_fn("get_trader_type")
	if original_get_trader_type then
		local patched = function(npc)
			local live_npc = busyhands_resolve_trader(npc)
			if not live_npc then
				return -1
			end
			return original_get_trader_type(live_npc)
		end
		publish_trader_fn("get_trader_type", patched)
		installed_count = installed_count + 1
	end

	local original_supply_level = resolve_trader_fn("supply_level")
	if original_supply_level then
		local patched = function(npc, as_number)
			local live_npc = busyhands_resolve_trader(npc)
			if not live_npc then
				return nil
			end
			return original_supply_level(live_npc, as_number)
		end
		publish_trader_fn("supply_level", patched)
		installed_count = installed_count + 1
	end

	local original_spawn_items = resolve_trader_fn("spawn_items")
	if original_spawn_items then
		local patched = function(npc, to_spawn, check_existing)
			local live_npc = busyhands_resolve_trader(npc)
			if not live_npc or type(to_spawn) ~= "table" then
				return
			end
			return original_spawn_items(live_npc, to_spawn, check_existing)
		end
		publish_trader_fn("spawn_items", patched)
		installed_count = installed_count + 1
	end

	if AddScriptCallback then
		AddScriptCallback("trader_on_restock")
	end

	return installed_count
end

local installed_count = install()
if installed_count > 0 then
	ANTHOLOGY_BHS_TRADER_AUTOINJECT_PATCH_VERSION = VERSION
	_G.ANTHOLOGY_BHS_TRADER_AUTOINJECT_PATCH_VERSION = VERSION
	printf("[BusyHandsFix v%s] trader_autoinject patched: %s functions (function-level, vendor file untouched)", VERSION, installed_count)
end
