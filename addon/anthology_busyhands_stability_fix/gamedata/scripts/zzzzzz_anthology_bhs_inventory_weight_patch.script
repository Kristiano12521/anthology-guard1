-- Anthology Busy Hands Stability Fix v0.6.12 - UIInventory weight / IsInvOwner guard
-- load-order: после stash_capacities (Anthology База.Данные) и ui_inventory
--
-- Classes & Talents calls ui_inventory.GUI:UpdateWeight() every second from
-- actor_on_update even after the loot UI is closed. GUI still holds the last
-- partner userdata. On level change that corpse/box is destroyed; IsStalker
-- then does o:clsid() -> BusyHandsDebug (Accessing destroyed object).
--
-- Stack from xray_nikit 2026-09-13:
--   endurance_weight_upd -> stash_capacities.UpdateWeight -> original_update_weight
--   -> IsInvOwner -> IsStalker -> clsid on destroyed id
--
-- v0.6.12: class "UIInventory" is luabind userdata, not a plain table.
-- 0.6.11 required type(...) == "table" and never installed (log 14.09).
-- Lookup matches SortingPlus: bare / _G / ui_inventory.UIInventory.
--
-- Vendor files untouched. Method-level monkey-patch on UIInventory only.

local VERSION = "0.6.12"

local logged_is_inv_owner = false
local logged_update_weight = false

local function partner_alive(npc)
	if not npc then
		return false
	end
	local ok = pcall(function()
		return npc:clsid()
	end)
	return ok
end

local function add_ui_inventory_target(list, seen, obj, via)
	if obj == nil then
		return
	end
	if seen[obj] then
		for i = 1, #list do
			if list[i].obj == obj then
				list[i].via = list[i].via .. " + " .. via
				return
			end
		end
		return
	end
	seen[obj] = true
	list[#list + 1] = { obj = obj, via = via }
end

local ui_inventory_targets = {}
local ui_inventory_seen = {}
add_ui_inventory_target(ui_inventory_targets, ui_inventory_seen, UIInventory, "bare UIInventory")
if type(_G) == "table" then
	add_ui_inventory_target(ui_inventory_targets, ui_inventory_seen, _G.UIInventory, "_G.UIInventory")
end
if type(ui_inventory) == "table" then
	add_ui_inventory_target(ui_inventory_targets, ui_inventory_seen, ui_inventory.UIInventory, "ui_inventory.UIInventory")
end

local function wrap_is_inv_owner(original)
	return function(self, npc)
		if npc and not partner_alive(npc) then
			if not logged_is_inv_owner then
				logged_is_inv_owner = true
				printf("[BusyHandsFix v%s] IsInvOwner skipped destroyed partner", VERSION)
			end
			return false
		end
		local ok, result = pcall(original, self, npc)
		if not ok then
			if not logged_is_inv_owner then
				logged_is_inv_owner = true
				printf("[BusyHandsFix v%s] IsInvOwner cancelled: %s", VERSION, tostring(result))
			end
			return false
		end
		return result
	end
end

local function wrap_update_weight(original)
	return function(self, ...)
		local ok, err = pcall(original, self, ...)
		if not ok then
			if not logged_update_weight then
				logged_update_weight = true
				printf("[BusyHandsFix v%s] UpdateWeight cancelled: %s", VERSION, tostring(err))
			end
		end
	end
end

local is_inv_owner_installed = false
local update_weight_installed = false

for ui_i = 1, #ui_inventory_targets do
	local cls = ui_inventory_targets[ui_i].obj
	local via = ui_inventory_targets[ui_i].via
	if cls and type(cls.IsInvOwner) == "function" then
		cls.IsInvOwner = wrap_is_inv_owner(cls.IsInvOwner)
		is_inv_owner_installed = true
		printf("[BusyHandsFix v%s] UIInventory.IsInvOwner patched via %s (method-level, ui_inventory.script untouched)", VERSION, via)
	end
	if cls and type(cls.UpdateWeight) == "function" then
		cls.UpdateWeight = wrap_update_weight(cls.UpdateWeight)
		update_weight_installed = true
		printf("[BusyHandsFix v%s] UIInventory.UpdateWeight patched via %s (method-level, stash_capacities / ui_inventory untouched)", VERSION, via)
	end
end

if not is_inv_owner_installed then
	printf("[BusyHandsFix v%s] UIInventory.IsInvOwner was not found via bare UIInventory / _G.UIInventory / ui_inventory.UIInventory - guard NOT installed", VERSION)
end
if not update_weight_installed then
	printf("[BusyHandsFix v%s] UIInventory.UpdateWeight was not found via bare UIInventory / _G.UIInventory / ui_inventory.UIInventory - guard NOT installed", VERSION)
end

-- Marker only when at least one method wrapped (verify must not lie).
if is_inv_owner_installed or update_weight_installed then
	ANTHOLOGY_BHS_INVENTORY_WEIGHT_PATCH_VERSION = VERSION
end
