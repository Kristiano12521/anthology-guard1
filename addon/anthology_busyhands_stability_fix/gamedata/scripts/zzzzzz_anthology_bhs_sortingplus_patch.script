-- Anthology Busy Hands Stability Fix v0.5.0 - SortingPlus LMode_Init patch
-- load-order: after zzz_rax_sortingplus_mcm
--
-- RULE 2/3: zzz_rax_sortingplus_mcm.script (674 lines, vendor
-- SortingPlus addon) stays original and is NOT replaced. We patch ONLY
-- one class method, ui_inventory.UIInventory.LMode_Init, via
-- a monkey-patch on the public class table.
--
-- Bug: the original unconditionally calls obj:name() and passes obj
-- on into self:Reset(obj)/self:LMode_TransferInfo(obj). If obj is a corpse
-- freed by the engine between frames (after a long fight), the native call
-- throws -> BusyHandsDebug.
--
-- The method uses nothing private from the file except one local
-- snd_open (local snd_open = sound_object([[interface\inv_open]])) -
-- which we reproduce here. It is a trivial resource constructor, not logic.

local VERSION = "0.6.5"
ANTHOLOGY_BHS_SORTINGPLUS_PATCH_VERSION = VERSION

local snd_open = sound_object([[interface\inv_open]])

local function busyhands_safe_obj_name(obj)
	if not obj then return nil end
	local ok, value = pcall(function() return obj:name() end)
	return ok and value or nil
end

local function patched_lmode_init(self, obj)
	local obj_name = busyhands_safe_obj_name(obj)
	if not obj_name then
		printf("[BusyHandsFix v%s] SortingPlus LMode_Init cancelled: loot object is nil or destroyed", VERSION)
		return
	end

	self:Print(nil, "LMode_Init | obj: %s", obj_name)
	self.mode = "loot"

	-- Reset() also hits native methods on obj. Guard it as a last barrier
	-- against a state race between the check above and this call.
	local ok_reset, reset_err = pcall(function() self:Reset(obj) end)
	if not ok_reset then
		printf("[BusyHandsFix v%s] SortingPlus LMode_Init cancelled in Reset: %s", VERSION, tostring(reset_err))
		return
	end

	if (not self.box_init_update.state) then
		self.box_init_update.tg = time_global()
		self.box_init_update.state = true
		self:LMode_ResetInventories(true)
		return
	end
	self.box_init_update.state = false

	self:LMode_ResetInventories()
	self:UpdateInfo(true)

	local ok_info, info_err = pcall(function() self:LMode_TransferInfo(obj) end)
	if not ok_info then
		printf("[BusyHandsFix v%s] SortingPlus skipped corpse info transfer: %s", VERSION, tostring(info_err))
	end

	self:PlaySND(snd_open)
end

-- class "UIInventory" (CUIScriptWnd) lives in _G, not on the module table
-- (run_string 31.08.2026: ui_inventory.UIInventory = nil). Console env may
-- differ from a script env, so both paths are patched like find_close_cover.
local function add_ui_inventory_target(list, seen, obj, via)
	if obj == nil then
		return
	end
	if seen[obj] then
		for i = 1, #list do
			if list[i].obj == obj then
				list[i].via = list[i].via .. " + " .. via
				return
			end
		end
		return
	end
	seen[obj] = true
	list[#list + 1] = { obj = obj, via = via }
end

local ui_inventory_targets = {}
local ui_inventory_seen = {}
add_ui_inventory_target(ui_inventory_targets, ui_inventory_seen, UIInventory, "bare UIInventory")
if type(_G) == "table" then
	add_ui_inventory_target(ui_inventory_targets, ui_inventory_seen, _G.UIInventory, "_G.UIInventory")
end
if type(ui_inventory) == "table" then
	add_ui_inventory_target(ui_inventory_targets, ui_inventory_seen, ui_inventory.UIInventory, "ui_inventory.UIInventory")
end

local ui_inventory_installed = false
for ui_i = 1, #ui_inventory_targets do
	local cls = ui_inventory_targets[ui_i].obj
	local via = ui_inventory_targets[ui_i].via
	if cls and type(cls.LMode_Init) == "function" then
		cls.LMode_Init = patched_lmode_init
		ui_inventory_installed = true
		printf("[BusyHandsFix v%s] UIInventory.LMode_Init patched via %s (method-level, zzz_rax_sortingplus_mcm.script untouched)", VERSION, via)
	end
end
if not ui_inventory_installed then
	printf("[BusyHandsFix v%s] UIInventory.LMode_Init was not found via bare UIInventory / _G.UIInventory / ui_inventory.UIInventory - guard NOT installed", VERSION)
end
