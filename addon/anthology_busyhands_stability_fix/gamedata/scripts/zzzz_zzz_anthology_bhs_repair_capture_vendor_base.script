-- Anthology Busy Hands Stability Fix v0.5.3 - repair chain vendor-base capture
-- load-order: after zzzz_arti_jamming_repairs
--
-- This file must load strictly between zzzz_arti_jamming_repairs.script
-- and zzzzz_arti_outfit_repair.script. The filename is chosen so it lands
-- in that alphabetic slot ("zzzz_" is 4 z letters, like jamming, but
-- "zzz" after the underscore sorts after "arti"; 4 z letters still
-- sort before the 5 z letters of outfit_repair). IF you rename any
-- of the three files this logic breaks silently. Do not rename
-- zzzz_arti_jamming_repairs.script / zzzzz_arti_outfit_repair.script /
-- this file relative to the others without revisiting load-order.
--
-- WHY (an Anthology 2.1 bug independent of BusyHandsFix):
--
-- Both vendor files, zzzz_arti_jamming_repairs.script and
-- zzzzz_arti_outfit_repair.script, patch item_repair.UIRepair.OnItemSelect
-- by chaining through ONE shared GLOBAL name with no local:
--   RepairOnItemSelect = item_repair.UIRepair.OnItemSelect
--   function item_repair.UIRepair:OnItemSelect(n) ... RepairOnItemSelect(self,n) end
--
-- jamming_repairs (4z, loads first) captures the original (vendor base,
-- call it V) into RepairOnItemSelect, then installs ITS version (J).
-- outfit_repair (5z, loads second) reads the CURRENT value of
-- item_repair.UIRepair.OnItemSelect (already J, not V!) into the SAME
-- RepairOnItemSelect, wiping V with no way to restore it,
-- and installs its own version (O).
--
-- Result: at runtime O calls RepairOnItemSelect(self,n) and correctly
-- lands in J (the global is J at that moment). But J itself also
-- calls RepairOnItemSelect(self,n), expecting V, and the global was
-- already overwritten to J. J calls itself:
-- INFINITE RECURSION -> stack overflow -> CTD.
--
-- Triggers EVERY time has_parts(obj_1) == false in O, that is
-- almost any normal armor/outfit repair through this addon
-- (has_parts is weapon parts, not armor). Likely the most
-- common crash in this addon set.
--
-- The real fix is in zzzzzz_anthology_bhs_repair_recursion_fix.script
-- (loads last, after both vendor files). This file only SAVES V
-- under a safe name while it still exists.
-- There is nowhere else to recover it later.

-- Env of zzzz_arti_jamming_repairs is visible as _G[filename] (axr_main).
-- RepairOnItemSelect is a non-local assign in that file, so it SHOULD be
-- module.RepairOnItemSelect. run_string 31.08.2026: that field is nil, and
-- the bare global is nil too. Cannot read V from jamming. File name / slot
-- zzzz_zzz_ is not changed (loads after jamming, before outfit).
-- Fallback: current UIRepair.OnItemSelect at this slot (vendor, or keep_crafting
-- wrap, if jamming never wrote the method).
local function resolve_ui_repair_class()
	if UIRepair ~= nil then
		return UIRepair, "bare UIRepair"
	end
	if type(_G) == "table" and _G.UIRepair ~= nil then
		return _G.UIRepair, "_G.UIRepair"
	end
	if type(item_repair) == "table" and item_repair.UIRepair ~= nil then
		return item_repair.UIRepair, "item_repair.UIRepair"
	end
	return nil, nil
end

local function resolve_vendor_base_on_item_select()
	local module = zzzz_arti_jamming_repairs
	if type(module) == "table" and type(module.RepairOnItemSelect) == "function" then
		return module.RepairOnItemSelect, "zzzz_arti_jamming_repairs.RepairOnItemSelect"
	end
	if type(RepairOnItemSelect) == "function" then
		return RepairOnItemSelect, "bare RepairOnItemSelect"
	end
	local cls, cls_via = resolve_ui_repair_class()
	if cls ~= nil and type(cls.OnItemSelect) == "function" then
		return cls.OnItemSelect, cls_via .. ".OnItemSelect"
	end
	return nil, nil
end

-- Bare assign lives on this file's env, not _G (same as other BHS markers).
-- Recursion-fix reads _G first, then this module table.
local vendor_base, resolved_via = resolve_vendor_base_on_item_select()
if vendor_base then
	ANTHOLOGY_BHS_REPAIR_VENDOR_BASE_ON_ITEM_SELECT = vendor_base
	if type(_G) == "table" then
		_G.ANTHOLOGY_BHS_REPAIR_VENDOR_BASE_ON_ITEM_SELECT = vendor_base
	end
	printf("[BusyHandsFix v0.6.6] Captured OnItemSelect via %s before outfit_repair overwrites the shared RepairOnItemSelect global", resolved_via)
else
	printf("[BusyHandsFix v0.6.6] RepairOnItemSelect was not found via jamming module / bare global / UIRepair.OnItemSelect - repair chain capture NOT installed (patch not functional in this build if jamming never exported the original)")
end
