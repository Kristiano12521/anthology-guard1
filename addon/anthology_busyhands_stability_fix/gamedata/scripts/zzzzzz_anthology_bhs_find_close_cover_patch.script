-- Anthology Busy Hands Stability Fix v0.6.7 - find_close_cover runtime patch
-- load-order: after utils_obj
--
-- RULE 2/3: a real monkey-patch of ONE global function.
-- utils_obj.script (965 lines) stays the original vendor file and is
-- NOT replaced. Every other function in that file (lmove,
-- send_to_nearest_accessible_vertex, find_random_cover, find_cover_in_rand_
-- direction, and so on) is untouched and still receives Anthology updates.
--
-- Bug: the original calls npc:best_cover(...) with no guard. If npc
-- is dead or offline (typical: a companion died mid-fight between
-- frames), the native call throws -> [BusyHandsDebug] Runtime
-- Error -> tempsave + Disconnect. Stack from the bug report:
--   utils_obj.script(551): find_close_cover
--   axr_fight_from_cover.script(139): try_go_cover
--
-- IMPORTANT: this is NOT harmless log spam. After this error the
-- user logs also show "Saving spawns... tempsave.scop saved - Disconnect",
-- so the game is kicked to the menu, same as mon_sleep.

local VERSION = "0.6.7"
ANTHOLOGY_BHS_FIND_COVER_PATCH_VERSION = VERSION

-- Mini-copy of the private validate(npc,vid) from utils_obj.script (5 lines,
-- self-contained, no calls into other locals of that file.
-- Uses only the public global db.used_level_vertex_ids).
-- Public valid_vertex(npc,vid) from utils_obj.script is used as-is,
-- not copied. It is declared without local and is global.
local function validate_cover_vertex(npc, vid)
	if vid and vid < 4294967295 and npc:accessible(vid) and vid ~= npc:level_vertex_id() then
		return db.used_level_vertex_ids[vid] == nil or db.used_level_vertex_ids[vid] == npc:id()
	end
	return false
end

local function patched_find_close_cover(npc, base_position, pos, cover_dist, mn, mx)
	if not (npc and base_position and pos) then
		return nil
	end

	local ok_alive, alive = pcall(function() return npc:alive() end)
	if not ok_alive or not alive then
		return nil
	end

	local cover
	cover_dist = not cover_dist and 5 or cover_dist
	while not cover and cover_dist < 30 do
		local ok_cover, result = pcall(function()
			return npc:best_cover(base_position, pos, cover_dist, mn or 1, mx or 60)
		end)
		if not ok_cover then
			printf("[BusyHandsFix v%s] find_close_cover: best_cover rejected invalid state", VERSION)
			return nil
		end
		cover = result

		if cover then
			local ok_vid, vid = pcall(function() return cover:level_vertex_id() end)
			local ok_valid, is_valid = false, false
			if ok_vid and vid then
				ok_valid, is_valid = pcall(validate_cover_vertex, npc, vid)
			end
			if not (ok_vid and ok_valid and is_valid) then
				cover = nil
			end
		end
		cover_dist = cover_dist + 1
	end

	if not cover then
		return nil
	end

	local ok_vid, vid = pcall(function() return cover:level_vertex_id() end)
	if not ok_vid or not vid then
		return nil
	end

	-- valid_vertex is a public function from utils_obj.script, not copied.
	local ok_result, result = pcall(valid_vertex, npc, vid)
	return ok_result and result or nil
end

-- Patch at file top level (not in on_game_start), for the same reason and
-- load gap as crow_spawner_patch: this file sorts after
-- utils_obj.script in script load order.
--
-- IMPORTANT: real callers (axr_fight_from_cover.script:138) go through
-- utils_obj.find_close_cover(...), not a bare find_close_cover(...).
-- Patch BOTH paths. It is unknown whether utils_obj is a live proxy to _G
-- (then a global patch is also visible via utils_obj.*) or a one-shot
-- snapshot table built when the file loaded (then it must be patched
-- separately, or callers keep hitting the old
-- version). Duplicating the patch is harmless either way.
local via = nil
if type(find_close_cover) == "function" then
	find_close_cover = patched_find_close_cover
	via = "find_close_cover"
end
if type(utils_obj) == "table" and type(utils_obj.find_close_cover) == "function" then
	utils_obj.find_close_cover = patched_find_close_cover
	if via then
		via = via .. " + utils_obj.find_close_cover"
	else
		via = "utils_obj.find_close_cover"
	end
end
if via then
	printf("[BusyHandsFix v%s] find_close_cover patched via %s (function-level, utils_obj.script untouched)", VERSION, via)
else
	printf("[BusyHandsFix v%s] find_close_cover was not found via find_close_cover / utils_obj.find_close_cover - guard NOT installed", VERSION)
end
