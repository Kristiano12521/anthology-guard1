-- Anthology Busy Hands Stability Fix v0.5.0 - item_repair.UIRepair patch
-- load-order: after zz_item_repair_keep_crafting_window_open
--
-- RULE 2/3: zz_item_repair_keep_crafting_window_open.script (vendor
-- monkey-patch addon over item_repair.script) stays original and is NOT
-- replaced. We patch ONLY 6 methods of item_repair.UIRepair, which
-- the vendor file already chains (InitControlsSuper/ResetSuper).
-- We add one more layer of that chain and do not touch the file.
--
-- Bug: several methods keep self.obj as a direct reference to
-- userdata of a spent/destroyed repair kit (utils_item.discharge
-- frees the object) and keep calling native methods on it
-- (obj:condition() and so on) from deferred callbacks (CreateTimeEvent).
-- By the time they run the object may already be invalid.
--
-- All 6 methods use only self:*/self.* and public globals
-- (db.actor, utils_item, utils_xml, ui_item, game_statistics,
-- utils_obj.play_sound). The only private dependency of the vendor
-- file is local degrade_factor = item_repair.degrade_factor or 0.2,
-- a trivial constant, reproduced below.

local VERSION = "0.6.5"
ANTHOLOGY_BHS_ITEM_REPAIR_PATCH_VERSION = VERSION

local degrade_factor = item_repair.degrade_factor or 0.2

-- --------------------------------------------------------------------------
-- Shared guard helpers (same idea as the loose copy in v0.4.4)
-- --------------------------------------------------------------------------

local function find_actor_item(section, preferred_id)
	if not section or not db or not db.actor then return nil end

	local preferred = nil
	local fallback = nil

	db.actor:iterate_inventory(function(_, item)
		if preferred then return end

		if item:section() == section then
			local id = item:id()
			if preferred_id and id == preferred_id then
				preferred = item
			elseif not fallback then
				fallback = item
			end
		end
	end, nil)

	return preferred or fallback
end

local function rebind_repair_object(self)
	if not self then return nil end

	local section = self.section or self.repair_section
	if not section then
		self.obj = nil
		self.repair_obj_id = nil
		return nil
	end

	local previous_id = self.repair_obj_id
	local found = find_actor_item(section, previous_id)

	self.obj = found
	if found then
		local found_id = found:id()
		self.repair_obj_id = found_id
		self.repair_section = section

		if previous_id and found_id ~= previous_id then
			printf("[BusyHandsFix v%s] Repair UI switched consumed kit %s -> %s", VERSION, tostring(previous_id), tostring(found_id))
		end
	else
		self.repair_obj_id = nil
		if previous_id then
			printf("[BusyHandsFix v%s] Repair UI closed: repair kit %s no longer exists", VERSION, tostring(previous_id))
		end
	end

	return found
end

local function delayed_collect_valid_items(self, section)
	if not self then return true end

	if not self:CollectValidItems(nil, section) then
		if self.OnCancel then
			self:OnCancel()
		end
	end

	return true
end

-- --------------------------------------------------------------------------
-- Method patches. Each wraps the current version (a chain, like the
-- vendor file itself), rather than replacing from scratch.
-- --------------------------------------------------------------------------

-- class "UIRepair" (CUIScriptWnd) lives in _G, not on the module table
-- (run_string 31.08.2026: item_repair.UIRepair = nil). Console env may
-- differ from a script env, so both paths are patched like find_close_cover.
local function add_ui_repair_target(list, seen, obj, via)
	if obj == nil then
		return
	end
	if seen[obj] then
		for i = 1, #list do
			if list[i].obj == obj then
				list[i].via = list[i].via .. " + " .. via
				return
			end
		end
		return
	end
	seen[obj] = true
	list[#list + 1] = { obj = obj, via = via }
end

local function install(UIRepair)

	local InitControlsSuper = UIRepair.InitControls
	if InitControlsSuper then
		UIRepair.InitControls = function(self)
			InitControlsSuper(self)
			self.repair_obj_id = nil
			self.repair_section = nil
		end
	end

	local ResetSuper = UIRepair.Reset
	if ResetSuper then
		UIRepair.Reset = function(self, obj, section)
			ResetSuper(self, obj, section)

			self.repair_section = section
			self.repair_obj_id = nil

			-- Bind only via a fresh walk of the actor inventory.
			-- The deferred callback below does not receive repair-kit userdata, so
			-- a spent object cannot outlive it in the event queue.
			local live_obj = find_actor_item(section, nil)
			if live_obj then
				self.obj = live_obj
				self.repair_obj_id = live_obj:id()
			end

			CreateTimeEvent("totally_not_random_event" .. random_number(1, 1000000), "update_ui_delay" .. random_number(1, 1000000), 0.1, delayed_collect_valid_items, self, section)
			return true
		end
	end

	-- CollectValidItems is replaced wholesale (not wrapped around
	-- the original). The original unconditionally calls obj:condition() on
	-- self.obj, and we must revalidate self.obj first and, if that is
	-- impossible, return false BEFORE that call, not after.
	UIRepair.CollectValidItems = function(self, obj, section)
		section = section or self.section or self.repair_section
		if not section then return false end

		self.section = section
		self.repair_section = section

		local repair_obj = rebind_repair_object(self)
		if not repair_obj then
			return false
		end

		empty_table(self.multiUseItemsObj)
		local parts_id = {}
		local function search(temp, item)
			if (item:section() == section) and (not parts_id[item:id()]) then
				local cnt = IsItem("multiuse", section, nil) and item:get_remaining_uses() or 1
				local id = item:id()
				parts_id[id] = cnt
				self.multiUseItemsObj[#self.multiUseItemsObj + 1] = {
					[id] = cnt
				}
			end
		end
		db.actor:iterate_inventory(search, nil)

		self.multiUseItemsUses = 0
		for _, cnt in pairs(parts_id) do
			self.multiUseItemsUses = self.multiUseItemsUses + cnt
		end

		local uses
		local color = ""
		if (IsItem("multiuse", section, nil)) then
			self.condition = 1
			self.isMultiUse = true
			if self.multiUseItemsUses > 3 then
				color = utils_xml.get_color("d_green")
			elseif self.multiUseItemsUses > 2 then
				color = utils_xml.get_color("pda_yellow")
			elseif self.multiUseItemsUses > 1 then
				color = utils_xml.get_color("d_orange")
			else
				color = utils_xml.get_color("d_red")
			end
			uses = self.multiUseItemsUses
		else
			self.isMultiUse = false
			self.condition = repair_obj:condition()
			if self.condition > degrade_factor * 2 then
				color = utils_xml.get_color("d_green")
			elseif self.condition > degrade_factor then
				color = utils_xml.get_color("pda_yellow")
			else
				color = utils_xml.get_color("d_red")
			end
			uses = string.format("%s%%", math.ceil(self.condition * 100))
		end

		local str = color .. ui_item.get_sec_name(section) .. " (" .. uses .. ")"
		self.cap_menu:SetText(str)

		return true
	end

	UIRepair.UpdateUi = function(self)
		-- Repair/helper items can be freed
		-- asynchronously. Revalidate self.obj before the rest of the
		-- method touches it.
		if not rebind_repair_object(self) then
			self:OnCancel()
			return true
		end

		if ((self.isMultiUse and (self.multiUseItemsUses == 1 or (self.multiUseItemsUses == 2 and self.section == self.partSection))) or (not self.isMultiUse and self.condition <= degrade_factor)) then
			self:OnCancel()
			return true
		end

		self:InitInventory(1)
		self:CollectValidItems(nil, self.section)

		if (not self.CC[1]:GetObj(self.cont_1_last_idx)) then
			self.cont_1_last_idx = self.cont_1_last_idx - 1
		end
		if (self.cont_1_last_idx <= 0) then
			self:OnCancel()
			return true
		end
		self.CC[1]:On_Select(self.cont_1_last_idx)

		local cont_2_last_idx = nil
		if (self.cont_2_last_idx) then
			cont_2_last_idx = self.cont_2_last_idx
		end

		self:On_CC_Mouse1(1, self.cont_1_last_idx)

		self.cont_2_last_idx = cont_2_last_idx
		if (self.cont_2_last_idx) then
			if (not self.CC[2]:GetObj(self.cont_2_last_idx)) then
				self.cont_2_last_idx = self.cont_2_last_idx - 1
			end
			if (self.cont_2_last_idx > 0 and self.CC[2]:GetObj(self.cont_2_last_idx)) then
				self.CC[2]:On_Select(self.cont_2_last_idx)
				self:On_CC_Mouse1(2, self.cont_2_last_idx, true)
			end
		end
		return true
	end

	UIRepair.OnRepair = function(self)
		local obj_1 = self.CC[1]:GetCell_Selected(true)
		local obj_2 = self.CC[2]:GetCell_Selected(true)

		if not (obj_1 and self.con_val[4]) then return end

		obj_1:set_condition(self.con_val[4] / 100)
		if obj_2 then
			utils_item.discharge(obj_2)
		end

		if not self:CollectValidItems(nil, self.section) then
			self:OnCancel()
			return
		end

		if self.isMultiUse then
			local item_id = nil
			local item_uses = nil

			-- Prefer the kit already bound to the window. If it is gone,
			-- take the first live one of the same section.
			for _, group in ipairs(self.multiUseItemsObj) do
				for id, amount in pairs(group) do
					if not item_id then
						item_id = id
						item_uses = amount
					end
					if self.repair_obj_id and id == self.repair_obj_id then
						item_id = id
						item_uses = amount
						break
					end
				end
				if self.repair_obj_id and item_id == self.repair_obj_id then
					break
				end
			end

			local next_id = item_id
			if item_uses == 1 then
				next_id = nil
				for _, group in ipairs(self.multiUseItemsObj) do
					for id, _ in pairs(group) do
						if id ~= item_id then
							next_id = id
							break
						end
					end
					if next_id then break end
				end
			end

			local item = find_actor_item(self.section, item_id)
			if item then
				-- Do not hold or reuse the object in the same frame as
				-- discharge. The engine may free its userdata immediately.
				utils_item.discharge(item)
				self.obj = nil
				self.repair_obj_id = next_id
			else
				self.obj = nil
				self.repair_obj_id = nil
			end
		else
			local repair_obj = rebind_repair_object(self)
			if not repair_obj then
				self:OnCancel()
				return
			end

			local repair_id = self.repair_obj_id
			utils_item.degrade(repair_obj, degrade_factor)
			self.obj = nil
			self.repair_obj_id = repair_id
		end

		self.hasCraftedItem = true
		game_statistics.increment_statistic("self_repairs")
		utils_obj.play_sound("interface\\inv_properties_2")

		if (self.last_cont and self.last_idx) then
			self.btn_repair:Enable(false)
			CreateTimeEvent("totally_not_random_event" .. random_number(1, 1000000), "update_ui_delay" .. random_number(1, 1000000), 0.1, self.UpdateUi, self)
		end
	end

	-- OnCancel is replaced wholesale, not wrapped around the original.
	-- The patch clears repair_obj_id/repair_section/obj BETWEEN partSection and
	-- HideDialog(), as the original does, not after the whole method.
	UIRepair.OnCancel = function(self)
		if (self.hasCraftedItem and self.use_actor_effects and actor_effects) then
			actor_effects.play_item_fx(self.section .. "_dummy")
		end

		utils_obj.play_sound("interface\\inv_close")

		self.hasCraftedItem = false
		self.last_cont = nil
		self.last_idx = nil
		self.cont_1_last_idx = 0
		self.cont_2_last_idx = nil
		self.multiUseItemsObj = {}
		self.multiUseItemsUses = 0
		self.partSection = nil
		self.repair_obj_id = nil
		self.repair_section = nil
		self.obj = nil

		self:HideDialog()

		Unregister_UI("UIRepair")
	end

	return true
end

local ui_repair_targets = {}
local ui_repair_seen = {}
add_ui_repair_target(ui_repair_targets, ui_repair_seen, UIRepair, "bare UIRepair")
if type(_G) == "table" then
	add_ui_repair_target(ui_repair_targets, ui_repair_seen, _G.UIRepair, "_G.UIRepair")
end
if type(item_repair) == "table" then
	add_ui_repair_target(ui_repair_targets, ui_repair_seen, item_repair.UIRepair, "item_repair.UIRepair")
end

local ui_repair_installed = false
for ui_r = 1, #ui_repair_targets do
	if install(ui_repair_targets[ui_r].obj) then
		ui_repair_installed = true
		printf("[BusyHandsFix v%s] UIRepair patched via %s: InitControls/Reset/CollectValidItems/UpdateUi/OnRepair/OnCancel (method-level, zz_item_repair_keep_crafting_window_open.script untouched)", VERSION, ui_repair_targets[ui_r].via)
	end
end
if not ui_repair_installed then
	printf("[BusyHandsFix v%s] UIRepair was not found via bare UIRepair / _G.UIRepair / item_repair.UIRepair - guard NOT installed", VERSION)
end
