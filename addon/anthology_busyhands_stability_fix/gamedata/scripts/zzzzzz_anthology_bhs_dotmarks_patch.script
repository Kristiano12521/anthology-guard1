-- Anthology Busy Hands Stability Fix v0.5.0 - DotMarks ui_inventory.start guard
-- load-order: after z_ui_inventory_dotmarks
--
-- RULE 2/3: z_ui_inventory_dotmarks.script (58 lines, vendor DotMarks
-- addon) stays original and is NOT replaced. We wrap
-- ui_inventory.start with ONE MORE layer on top, the same monkey-patch
-- chain DotMarks already uses around the original ui_inventory.start.
--
-- Our wrapper runs OUTSIDE DotMarks: if the object is invalid we
-- stop BEFORE entering the DotMarks version and never let it call
-- obj:section()/obj:name() on userdata that may already be destroyed. So
-- we do not need to know or duplicate DotMarks internals (idm, dm,
-- whitelist, and so on). Unlike mon_sleep, this is a pure entry wrapper.

local VERSION = "0.5.0"
ANTHOLOGY_BHS_DOTMARKS_PATCH_VERSION = VERSION

local function busyhands_object_valid(obj)
	if not obj then
		return false
	end
	local ok = pcall(function() return obj:section() end)
	return ok
end

if type(ui_inventory) == "table" and type(ui_inventory.start) == "function" then
	local original_start = ui_inventory.start
	ui_inventory.start = function(mode, obj)
		if mode == "loot" and not busyhands_object_valid(obj) then
			printf("[BusyHandsFix v%s] ui_inventory.start blocked loot mode for nil or destroyed object", VERSION)
			return
		end
		return original_start(mode, obj)
	end
	printf("[BusyHandsFix v%s] ui_inventory.start entry guard installed (z_ui_inventory_dotmarks.script untouched)", VERSION)
else
	printf("[BusyHandsFix v%s] ui_inventory.start was not found - guard NOT installed", VERSION)
end
