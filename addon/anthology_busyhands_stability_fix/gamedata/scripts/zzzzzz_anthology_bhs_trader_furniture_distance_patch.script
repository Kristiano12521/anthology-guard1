-- Anthology Busy Hands Stability Fix - trader furniture distance check
-- load-order: after zzzzzz_anthology_bhs_trader_autoinject_patch
-- (OPTIONAL, NOT a crash fix)
--
-- This is NOT part of the stability work. It changes gameplay, and it
-- was in the first draft (v0.4.2) under a "sid/forester
-- fix" comment, but it is absent from the real vendor file (including
-- Campfires Anthology Compat v2). No confirmation it was
-- intentional. Added as its own file on request, just in
-- case, so it is not mixed with the crash fixes in
-- zzzzzz_anthology_bhs_trader_autoinject_patch.script.
--
-- What it does: trade_manager.update skips assortment refresh for
-- "furniture" NPCs (esc_m_trader - Sidorovich, red_m_lesnik - Forester) when
-- the actor is more than 20 meters away. Without this file those traders can
-- refresh stock even when the player is far from the shop.
--
-- HOW TO DISABLE: set ENABLED = false below. The file stays in the pack
-- but the effect is off.
-- HOW TO REMOVE: delete this file from gamedata/scripts.
-- It is self-contained; no other file references it.

local ENABLED = true

local VERSION = "0.6.1"

if not ENABLED then
	printf("[BusyHandsFix v%s] trader furniture distance check is present but disabled (ENABLED = false)", VERSION)
	return
end

local furniture = {
	["esc_m_trader"] = true,
	["red_m_lesnik"] = true
}

if type(trade_manager) == "table" and type(trade_manager.update) == "function" then
	-- Local variable, NOT a global (unlike the vendor "TraderUpdate"),
	-- so we do not repeat the shared-name collision from OnItemSelect
	-- (see zzzzzz_anthology_bhs_repair_recursion_fix.script).
	local original_trade_manager_update = trade_manager.update
	trade_manager.update = function(npc, force_refresh)
		local ok_name, npc_name = pcall(function() return npc:name() end)
		if ok_name and furniture[npc_name] then
			local ok_dist, too_far = pcall(function()
				return npc:position():distance_to(db.actor:position()) > 20
			end)
			if ok_dist and too_far then
				return
			end
		end
		return original_trade_manager_update(npc, force_refresh)
	end
	ANTHOLOGY_BHS_TRADER_FURNITURE_DISTANCE_PATCH_VERSION = VERSION
	printf("[BusyHandsFix v%s] trader furniture distance check installed (gameplay behavior, not a crash fix - see file header)", VERSION)
else
	printf("[BusyHandsFix v%s] trade_manager.update was not found - furniture distance check NOT installed", VERSION)
end
