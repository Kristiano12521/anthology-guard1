-- Anthology Busy Hands Stability Fix v0.6.0 - sr_crow_spawner runtime patch
-- load-order: ����� sr_crow_spawner
--
-- ПЕРЕПИСАНО в v0.6.0: пользователь прислал настоящий чистый вендорский
-- sr_crow_spawner.script (70 строк). Он оказался НАМНОГО проще, чем то, на
-- основе чего был построен патч v0.5.0-0.5.3 (тот был реконструирован по
-- уже сильно расширенной 186-строчной копии из черновика v0.4.8, где кто-то
-- до меня успел не просто пофиксить краш, а переписать половину алгоритма
-- отбора patrol path - лишний код, добавляющий риск расхождения с
-- вендором без всякой на то нужды). Этот патч - настоящий минимальный diff.
--
-- ПРАВИЛО 2/3: sr_crow_spawner.script остаётся оригинальным вендорским -
-- НЕ подменяется. Патчим ТОЛЬКО check_for_spawn_new_crow.
--
-- Причина бага (подтверждена стеком из баг-репорта: sr_crow_spawner.
-- script(50)): вызов ptr:level_vertex_id(0) на patrol path, который
-- принадлежит другому/ещё не готовому уровню (типично сразу после перехода
-- между локациями) - нативный вызов кидает исключение вместо возврата nil.
--
-- Фикс - pcall строго вокруг ЭТОЙ ОДНОЙ пары вызовов, больше НИЧЕГО в
-- алгоритме не меняется:

local VERSION = "0.6.5"
ANTHOLOGY_BHS_CROW_PATCH_VERSION = VERSION

local function patched_check_for_spawn_new_crow(self)
	if not (self.st.path_table) then
		return
	end
	local n = math.random(1, #self.st.path_table)
	local selected_path = self.st.path_table[n]
	local tg = time_global()
	if (selected_path) and (self.spawn_points_idle[selected_path] == nil or tg > self.spawn_points_idle[selected_path]) then
		local ptr = patrol(selected_path)
		if (ptr and ptr:point(0):distance_to_sqr(db.actor:position()) > 10000) then
			-- Вот и весь фикс: level_vertex_id(0)/game_vertex_id(0) на
			-- patrol, принадлежащем другому уровню, кидают исключение -
			-- ловим через pcall, ничего больше не трогаем.
			local ok, lvid, gvid = pcall(function()
				return ptr:level_vertex_id(0), ptr:game_vertex_id(0)
			end)
			if not ok then
				self.spawn_points_idle[selected_path] = time_global() + 300000
				return false
			end
			self.spawn_points_idle[selected_path] = time_global() + 10000
			alife_create("m_crow", ptr:point(0), lvid, gvid)
			return true
		end
	end
	return false
end

-- class "crowkiller" is userdata on the module (run_string 31.08.2026).
-- type(...) == "table" can never pass. Same lookup as
-- zzzz_anthology_crow_spawner_fix: _G.crowkiller, then sr_crow_spawner.crowkiller.
local function is_class_obj(obj)
	local t = type(obj)
	return t == "table" or t == "userdata"
end

local function resolve_crowkiller_class()
	if is_class_obj(_G.crowkiller) then
		return _G.crowkiller, "_G.crowkiller"
	end
	if is_class_obj(crowkiller) then
		return crowkiller, "bare crowkiller"
	end
	local module = sr_crow_spawner
	if type(module) == "table" and is_class_obj(module.crowkiller) then
		return module.crowkiller, "sr_crow_spawner.crowkiller"
	end
	return nil, nil
end

local crowkiller_class, resolved_via = resolve_crowkiller_class()
if crowkiller_class and crowkiller_class.check_for_spawn_new_crow then
	crowkiller_class.check_for_spawn_new_crow = patched_check_for_spawn_new_crow
	printf("[BusyHandsFix v%s] crowkiller:check_for_spawn_new_crow patched via %s (method-level, minimal pcall-only diff, sr_crow_spawner.script untouched)", VERSION, resolved_via)
else
	printf("[BusyHandsFix v%s] crowkiller class was not found via _G.crowkiller / bare crowkiller / sr_crow_spawner.crowkiller - guard NOT installed", VERSION)
end

