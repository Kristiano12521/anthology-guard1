-- Anthology Busy Hands Stability Fix v0.5.3 - repair OnItemSelect chain fix
-- load-order: ����� zzzzz_arti_outfit_repair
--
-- ПРАВИЛО 2/3: zzzz_arti_jamming_repairs.script и zzzzz_arti_outfit_repair.
-- script остаются оригинальными - НЕ подменяются. Патчим только конечную
-- точку - item_repair.UIRepair.OnItemSelect - но делаем это, полностью
-- реконструируя её логику здесь, а не вызывая исходные функции: см. ниже,
-- почему вызвать их напрямую нельзя.
--
-- ДВА НЕЗАВИСИМЫХ БАГА В ЭТИХ ДВУХ ФАЙЛАХ, ИСПРАВЛЕННЫЕ ЗДЕСЬ:
--
-- 1) БЕСКОНЕЧНАЯ РЕКУРСИЯ (подробное объяснение - в
--    zzzz_zzz_anthology_bhs_repair_capture_vendor_base.script, который
--    должен грузиться перед этим файлом). Оба вендорских файла патчат
--    OnItemSelect цепочкой через ОДНУ и ту же глобальную переменную
--    RepairOnItemSelect без local - второй патч стирает ссылку, которую
--    первый патч использует для вызова "следующего звена". Итог: обычный
--    ремонт брони/одежды (has_parts(obj_1) == false) уходит в бесконечную
--    рекурсию и роняет игру. Фикс: реконструируем обе функции здесь как
--    явные Lua-замыкания, полностью игнорируя сломанный общий global.
--
-- 2) self.obj:section() на потенциально невалидном self.obj (тот же класс
--    бага, что и в zzzzzz_anthology_bhs_item_repair_patch.script) - заменено
--    на self.section, которая всегда синхронно поддерживается актуальной
--    нашим патчем CollectValidItems/Reset.
--
-- ЗАВИСИМОСТИ: обе функции используют только self.*/публичные глобалы, за
-- одним исключением - jamming_repairs.script читает приватный
-- local ini_custom_repair = ini_file("repair\\importer.ltx"). Это загрузка
-- ресурса по фиксированному пути, не логика - воспроизведена как есть.
-- outfit_repair.script вообще не имеет ни одного top-level local (проверено).

local VERSION = "0.6.6"
ANTHOLOGY_BHS_REPAIR_CHAIN_PATCH_VERSION = VERSION

local ini_custom_repair = ini_file("repair\\importer.ltx")

-- Реконструкция jamming_repairs.script:OnItemSelect (J'), с явным
-- параметром next_fn вместо чтения сломанного глобала.
local function jamming_on_item_select(self, n, next_fn)
	local obj_1 = self.CC[1]:GetCell_Selected(true)
	local obj_n = self.CC[n]:GetCell_Selected(true)
	if not (obj_1 and obj_n) then
		return
	end
	local cond_1 = obj_1:condition()
	local sec_r = self.section
	if not sec_r then
		return
	end
	local threshold_repair = ini_custom_repair:section_exist(sec_r) and ini_custom_repair:r_float_ex(sec_r, "repair_threshold") or 0
	print_dbg("Cond of item is %s, threshold %s", cond_1, threshold_repair)
	local repair_add = a_repair_override.get_prop(sec_r, "repair_add_condition", 2) or 0
	self.add_condition = threshold_repair < cond_1 and repair_add or repair_add / 2
	if next_fn then
		next_fn(self, n)
	end
end

-- Реконструкция outfit_repair.script:OnItemSelect (O'), с явным
-- параметром next_fn вместо чтения сломанного глобала.
local function outfit_on_item_select(self, n, next_fn)
	local obj_1 = self.CC[1]:GetCell_Selected(true)
	local obj_n = self.CC[n]:GetCell_Selected(true)
	if not (obj_1 and obj_n) then
		return
	end

	if not has_parts(obj_1) then
		if next_fn then
			next_fn(self, n)
		end
		return
	end

	local sec = obj_n:section()
	local id = obj_n:id()

	local cond_1 = obj_1:condition()
	local sec_r = self.section
	if not sec_r then
		return
	end
	local item_tier = a_repair_override.get_prop(sec_r, "repair_tier", 2)
	if item_tier == 0 then item_tier = 5 end
	local outfit_tier = tier_outfit(obj_1:section())
	local repair_add = a_repair_override.get_prop(sec_r, "repair_add_condition", 2)
	self.add_condition = outfit_tier > item_tier and repair_add / 2 or repair_add
	print_dbg("Repair item tier %s, outfit tier %s. Add condition %s", item_tier, outfit_tier, self.add_condition)

	local con = 0
	if n == 2 then
		local is_part_match = (self.parts_match and sec == obj_1:section())
		con = is_part_match and obj_n:condition() or ini_sys:r_float_ex(sec, "repair_part_bonus") or self.part_bonus
		local rank = rank_component(sec)
		if (rank == 3 or rank == 4) and not is_part_match then
			con = 0.01 * (math_floor(obj_n:condition() / 0.2))
		end
		con = (game_achievements.has_achievement("mechanized_warfare")) and (con + 0.02) or con
		con = clamp(math_floor(con * 100) * self.parts_multi, 0, 100)
	end

	local name = ui_item.get_sec_name(sec)
	self.text_item[n]:SetText(name)

	self.con_val[1] = math.ceil((obj_1:condition()) * 100)
	self.con_val[2] = ((n == 2) and con) or 0
	self.con_val[3] = math_floor((self.add_condition) * 100)
	self.con_val[4] = clamp(self.con_val[1] + self.con_val[2] + self.con_val[3], 0, 100)
	local oldMaxCond = get_max_condition(obj_1)
	local diff = get_projected_max(obj_1, self.section, obj_n)
	local maxCond = average_cond(diff.new)
	print_dbg("Projected max is %s", maxCond)
	if IsItem("part", nil, obj_1) then
		self.con_val[4] = utils_item.get_cond_static(self.con_val[4])
	end

	self.con_txt[1]:SetText(utils_xml.get_color_con(self.con_val[1]) .. game.translate_string("st_ui_oldcon") .. ": " .. self.con_val[1] .. "/" .. oldMaxCond)
	self.con_txt[2]:SetText(self.clr_b .. game.translate_string("st_ui_bonus") .. ": +" .. self.con_val[2] .. "%")
	self.con_txt_base:SetText(game.translate_string("st_ui_repair") .. ": " .. self.con_val[3] .. "%")
	local color_con = self.con_val[4] > maxCond and utils_xml.get_color_con(1) or utils_xml.get_color_con(self.con_val[4])
	self.con_txt_new:SetText(color_con .. game.translate_string("st_ui_repair_new") .. ": " .. self.con_val[4] .. "/" .. maxCond)

	self.cell_item[n]:Set(obj_n)

	if (n == 1) and self.use_parts then
		self.cell_item[2]:Reset()
		self.text_item[2]:SetText("")
	end
	if get_config("ui") then
		self.info.text:SetText(generate_readout(diff.old, diff.new))
	end
	self.btn_repair:Enable(true)
end

local function add_ui_repair_target(list, seen, obj, via)
	if obj == nil then
		return
	end
	if seen[obj] then
		for i = 1, #list do
			if list[i].obj == obj then
				list[i].via = list[i].via .. " + " .. via
				return
			end
		end
		return
	end
	seen[obj] = true
	list[#list + 1] = { obj = obj, via = via }
end

-- Capture writes the marker on its own env (and _G). A bare read here
-- only sees _G via __index - same env vs _G miss as other BHS markers.
local function read_vendor_base()
	local key = "ANTHOLOGY_BHS_REPAIR_VENDOR_BASE_ON_ITEM_SELECT"
	if type(_G) == "table" and type(_G[key]) == "function" then
		return _G[key]
	end
	local cap = zzzz_zzz_anthology_bhs_repair_capture_vendor_base
	if type(cap) == "table" and type(cap[key]) == "function" then
		return cap[key]
	end
	return nil
end

local function install()
	local vendor_base = read_vendor_base()
	if type(vendor_base) ~= "function" then
		printf("[BusyHandsFix v%s] vendor base OnItemSelect was not captured (load-order marker missing) - repair chain fix NOT installed, recursion bug remains", VERSION)
		return false
	end

	local targets = {}
	local seen = {}
	add_ui_repair_target(targets, seen, UIRepair, "bare UIRepair")
	if type(_G) == "table" then
		add_ui_repair_target(targets, seen, _G.UIRepair, "_G.UIRepair")
	end
	if type(item_repair) == "table" then
		add_ui_repair_target(targets, seen, item_repair.UIRepair, "item_repair.UIRepair")
	end
	if #targets == 0 then
		printf("[BusyHandsFix v%s] UIRepair was not found via bare UIRepair / _G.UIRepair / item_repair.UIRepair - repair chain fix NOT installed", VERSION)
		return false
	end

	local chain = function(self, n)
		outfit_on_item_select(self, n, function(self2, n2)
			jamming_on_item_select(self2, n2, vendor_base)
		end)
	end

	for i = 1, #targets do
		targets[i].obj.OnItemSelect = chain
		printf("[BusyHandsFix v%s] repair chain UIRepair.OnItemSelect set via %s", VERSION, targets[i].via)
	end

	return true
end

if install() then
	printf("[BusyHandsFix v%s] item_repair.UIRepair.OnItemSelect chain rebuilt: outfit_repair -> jamming_repairs -> vendor base (recursion bug fixed, self.obj nil-safety applied)", VERSION)
end
