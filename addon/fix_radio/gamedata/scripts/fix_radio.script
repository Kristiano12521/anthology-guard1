-- Radio device fixes
-- Anomaly 1.5.3 / Anthology 2.1
--
-- 1) Hideout Furniture placeable radio: original constructor lists every
--    file in the station folder via getFS():file_list_open. MO2/VFS extra
--    files (.mohidden, non-ogg) become sound_object() junk. The ZIP 1.0.3
--    replaced the whole script and hard-coded 2 vanilla stations.
--    Do not wrap FS.file_list_open on the class: WTF lists dialog XMLs
--    through the same C++ method and the luabind call then CTDs
--    ("pure virtual function called"). Filter only while the HF
--    constructor runs, via a temporary getFS() proxy. Original HF file
--    stays. Disable Hideout_Furniture_Placeable_Radio_Fix.zip.
--
-- 2) World radios / notebooks: option sound/radio/zone only gated ph_sound
--    (Zone FM). Most base devices use ph_idle + play_sound and ignore it.
--    ph_sound defaults no_hit=true. ph_idle hit_on_bone requires exact bone 2.
--    No on_use in LTX for many devices. Toggle via physic_object_on_use_callback.
--    ph_idle: mute with stop_sounds (do not switch to @broken — kills scheme).
--    ph_sound: mute with volume 0 on Zone FM *_out.

local LOG_TAG = "[fix_radio]"
local VERSION = "1.0.7"
local TIP_ID = "st_fix_radio_use"

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig = {}
local installed = false
local callbacks_registered = false
local last_ph_sound_toggle = 0
local last_ph_idle_toggle = 0

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

local function module_of(name)
	return rawget(_G, name)
end

function patched_ui_get(id)
	if not orig.ui_get then
		return nil
	end
	local v = orig.ui_get(id)
	if id == "sound/radio/zone" then
		return v == true or v == 1 or v == "true"
	end
	return v
end

local function zone_enabled()
	if not (ui_options and ui_options.get) then
		return true
	end
	local v = ui_options.get("sound/radio/zone")
	return v == true or v == 1 or v == "true"
end

local function obj_name_lower(obj)
	if not obj then
		return ""
	end
	local ok, name = pcall(function()
		return obj:name()
	end)
	if ok and type(name) == "string" then
		return string.lower(name)
	end
	return ""
end

local function is_device_radio(obj)
	if not obj then
		return false
	end
	if IsStalker and IsStalker(obj) then
		return false
	end
	local n = obj_name_lower(obj)
	if n == "" then
		return false
	end
	if string.find(n, "radioactiv", 1, true) then
		return false
	end
	if string.find(n, "radio", 1, true) then
		return true
	end
	if string.find(n, "notebook", 1, true) then
		return true
	end
	if string.find(n, "laptop", 1, true) then
		return true
	end
	return false
end

local function set_use_tip(obj)
	if not (obj and obj.set_tip_text) then
		return
	end
	-- Translated text (vasgen_fairy_radio pattern): id-only tip can show blank
	-- if the string table is late/missing for a frame.
	local text = TIP_ID
	if game and game.translate_string then
		local t = game.translate_string(TIP_ID)
		if t and t ~= "" then
			text = t
		end
	end
	pcall(function()
		obj:set_tip_text(text)
	end)
	if obj.set_nonscript_usable then
		pcall(function()
			obj:set_nonscript_usable(false)
		end)
	end
end

------------------------------------------------------------
-- Sound folder listing
------------------------------------------------------------
local function is_ogg_name(name)
	if type(name) ~= "string" then
		return false
	end
	return string.sub(string.lower(name), -4) == ".ogg"
end

local function list_entry_name(item)
	if type(item) == "string" then
		return item
	end
	if type(item) == "userdata" and item.NameShort then
		local ok, short = pcall(function()
			return item:NameShort()
		end)
		if ok and type(short) == "string" then
			return short
		end
	end
	return nil
end

local function make_string_list(files)
	return {
		Size = function()
			return #files
		end,
		GetAt = function(_, idx)
			return files[idx + 1]
		end,
	}
end

local function probe_numbered(rel)
	local fs = getFS()
	if not (fs and rel) then
		return {}
	end
	if string.sub(rel, -1) ~= "\\" then
		rel = rel .. "\\"
	end
	local prefixes = { "track_", "session_" }
	local pi, n
	for pi = 1, #prefixes do
		local batch = {}
		for n = 1, 64 do
			local fname = prefixes[pi] .. tostring(n) .. ".ogg"
			if fs:exist("$game_sounds$", rel .. fname) ~= nil then
				batch[#batch + 1] = fname
			else
				break
			end
		end
		if #batch > 0 then
			return batch
		end
	end
	return {}
end

local function filter_radio_list(list, rel)
	local files = {}
	if list and list.Size then
		local count = list:Size() or 0
		local i
		for i = 0, count - 1 do
			local name = list_entry_name(list:GetAt(i))
			if is_ogg_name(name) then
				files[#files + 1] = name
			end
		end
	end
	table.sort(files)
	if #files == 0 then
		files = probe_numbered(rel)
	end
	return make_string_list(files)
end

local function is_radio_sound_path(fs_id, rel)
	if fs_id ~= "$game_sounds$" then
		return false
	end
	if type(rel) ~= "string" then
		return false
	end
	local l = string.lower(rel)
	if string.find(l, "radioactiv", 1, true) then
		return false
	end
	return string.find(l, "radio", 1, true) ~= nil
end

local function open_real_list(fs, a, b, c)
	if not fs then
		return nil
	end
	if c ~= nil then
		return fs:file_list_open(a, b, c)
	end
	return fs:file_list_open(a, b)
end

local function make_fs_proxy(real_fs)
	local proxy = {}
	setmetatable(proxy, {
		__index = function(_, key)
			if key == "file_list_open" then
				return function(_, a, b, c)
					local list = open_real_list(real_fs, a, b, c)
					if is_radio_sound_path(a, b) then
						return filter_radio_list(list, b)
					end
					return list
				end
			end
			local v = real_fs[key]
			if type(v) == "function" then
				return function(_, ...)
					return v(real_fs, ...)
				end
			end
			return v
		end,
	})
	return proxy
end

------------------------------------------------------------
-- Hideout Furniture constructor
------------------------------------------------------------
function patched_placeable_init(self, obj)
	if not orig.placeable_init then
		return
	end
	local real_fs = getFS()
	local prev_getFS = getFS
	if real_fs and type(prev_getFS) == "function" then
		local proxy = make_fs_proxy(real_fs)
		_G.getFS = function()
			return proxy
		end
	end
	local ok, err = pcall(orig.placeable_init, self, obj)
	if type(prev_getFS) == "function" then
		_G.getFS = prev_getFS
	end
	if not ok then
		error(err)
	end
end

local function install_placeable()
	local mod = module_of("placeable_radio")
	if not (mod and mod.placeable_radio_wrapper) then
		return false
	end
	local cls = mod.placeable_radio_wrapper
	if type(cls.__init) ~= "function" then
		return false
	end
	if cls.__init == patched_placeable_init then
		return true
	end
	orig.placeable_init = orig.placeable_init or cls.__init
	cls.__init = patched_placeable_init
	return true
end

------------------------------------------------------------
-- World radios: zone / hit / use
------------------------------------------------------------
local function ini_has_section(ini, section)
	if not (ini and section and ini.section_exist) then
		return false
	end
	local ok, has = pcall(function()
		return ini:section_exist(section)
	end)
	return ok and has
end

local function notify_toggle(muted)
	local msg
	if muted then
		msg = "Radio: OFF"
	else
		msg = "Radio: ON"
	end
	if actor_menu and actor_menu.set_msg then
		pcall(function()
			actor_menu.set_msg(1, msg, 2)
		end)
	end
end

local function theme_from_idle_ini(ini, section)
	if not (ini and section) then
		return nil
	end
	local keys = { "on_info", "on_info2", "on_info3", "on_info4", "on_info5" }
	local ki, key
	for ki = 1, #keys do
		key = keys[ki]
		local ok_has, has = pcall(function()
			return ini:line_exist(section, key)
		end)
		if ok_has and has then
			local ok_val, val = pcall(function()
				return ini:r_string_ex(section, key)
			end)
			if ok_val and type(val) == "string" then
				local theme = string.match(val, "play_sound%s*%(%s*([%w_]+)")
				if theme then
					return theme
				end
			end
		end
	end
	return nil
end

local function recover_radio_logic(obj)
	if not (obj and db and db.storage and xr_logic and xr_logic.activate_by_section) then
		return false
	end
	local bag = db.storage[obj:id()]
	if not bag or not bag.ini then
		return false
	end
	if bag.active_scheme then
		return true
	end
	local target
	if ini_has_section(bag.ini, "ph_idle@music") then
		target = "ph_idle@music"
	elseif ini_has_section(bag.ini, "ph_sound") then
		target = "ph_sound"
	end
	if not target then
		return false
	end
	xr_logic.activate_by_section(obj, bag.ini, target, bag.gulag_name, false)
	log("recover: %s -> %s", obj_name_lower(obj), target)
	return db.storage[obj:id()].active_scheme ~= nil
end

-- ph_idle radios: do NOT switch music<->broken on use. Switching to @broken
-- can leave active_scheme=nil (tip gone, further use ignored by binder).
-- Mute = stop_sounds + bag flag; unmute = play_sound(theme) from on_info.
local function toggle_ph_idle_radio(obj)
	local tg = time_global and time_global() or 0
	if tg > 0 and tg < last_ph_idle_toggle + 300 then
		return
	end
	last_ph_idle_toggle = tg

	if not (obj and db and db.storage) then
		return
	end
	local bag = db.storage[obj:id()]
	if not bag then
		log("idle use: no storage for %s", obj_name_lower(obj))
		return
	end

	local was_dead = bag.active_scheme == nil
	recover_radio_logic(obj)
	bag = db.storage[obj:id()]
	if not bag then
		return
	end

	-- After old broken-toggle left scheme nil: restore music once, don't mute.
	if was_dead then
		bag._fix_radio_muted = false
		local theme = theme_from_idle_ini(bag.ini, "ph_idle@music")
		if theme and xr_effects and xr_effects.play_sound then
			xr_effects.play_sound(db.actor, obj, { theme })
		end
		set_use_tip(obj)
		notify_toggle(false)
		log("idle use: recovered dead %s", obj_name_lower(obj))
		return
	end

	bag._fix_radio_muted = not bag._fix_radio_muted
	local id = obj:id()
	if bag._fix_radio_muted then
		if xr_sound and xr_sound.stop_sounds_by_id then
			xr_sound.stop_sounds_by_id(id)
		end
	else
		local ini = bag.ini
		local section = bag.active_section or "ph_idle@music"
		local theme = theme_from_idle_ini(ini, section)
		if not theme then
			theme = theme_from_idle_ini(ini, "ph_idle@music")
		end
		if theme and xr_effects and xr_effects.play_sound then
			xr_effects.play_sound(db.actor, obj, { theme })
		elseif ini and ini_has_section(ini, "ph_idle@music") and xr_logic and xr_logic.activate_by_section then
			bag.active_section = nil
			bag.active_scheme = nil
			xr_logic.activate_by_section(obj, ini, "ph_idle@music", bag.gulag_name, false)
		end
	end
	set_use_tip(obj)
	notify_toggle(bag._fix_radio_muted)
	log(
		"idle use: %s muted=%s scheme=%s",
		obj_name_lower(obj),
		tostring(bag._fix_radio_muted),
		tostring(bag.active_scheme)
	)
end

function patched_idle_hit(self, obj, amount, local_direction, who, bone_index)
	if self.st and self.st.hit_on_bone and self.st.hit_on_bone[bone_index] then
		return orig.idle_hit(self, obj, amount, local_direction, who, bone_index)
	end
	if is_device_radio(self.object) and self.st and self.st.hit_on_bone then
		local bone, data
		for bone, data in pairs(self.st.hit_on_bone) do
			if data and data.state and xr_logic then
				local section = xr_logic.pick_section_from_condlist(db.actor, self.object, data.state)
				if section then
					xr_logic.switch_to_section(obj, self.st.ini, section)
					return
				end
			end
		end
	end
	if orig.idle_hit then
		return orig.idle_hit(self, obj, amount, local_direction, who, bone_index)
	end
end

function patched_idle_use(self, obj, actor)
	if orig.idle_use then
		local handled = orig.idle_use(self, obj, actor)
		if handled then
			return handled
		end
	end
	-- Radio toggle is in physic_object_on_use_callback (also runs when
	-- active_section is nil). Consume use here to avoid double-handling.
	if is_device_radio(self.object) then
		return true
	end
end

function patched_idle_update(self, delta)
	if is_device_radio(self.object) then
		set_use_tip(self.object)
		local bag = db and db.storage and db.storage[self.object:id()]
		local muted = bag and bag._fix_radio_muted
		if (muted or not zone_enabled()) and xr_sound and xr_sound.stop_sounds_by_id then
			xr_sound.stop_sounds_by_id(self.object:id())
		end
	end
	if orig.idle_update then
		return orig.idle_update(self, delta)
	end
end

-- ph_sound fetches a track only when st.sound_set is true. Zone-off used to
-- stop the out-sound and leave sound_set false — re-arm when allowed again.
local function arm_ph_sound(self)
	if not self.st then
		return
	end
	self.st.sound_set = true
	self.st.pause_time = 0
end

-- Use-mute must NOT stop Zone FM *_out or flip destructed (vasgen_fairy_radio:
-- volume 0/1, track keeps running). destructed is only for hit / saved break.
local function apply_use_mute_volume(self)
	if not (self and self.played_sound) then
		return
	end
	if self._fix_radio_muted then
		pcall(function()
			self.played_sound.volume = 0
		end)
	end
end

local function find_ph_sound_action(obj)
	if not (obj and db and db.storage) then
		return nil
	end
	local bag = db.storage[obj:id()]
	if not bag or bag.active_scheme ~= "ph_sound" then
		return nil
	end
	local st = bag.ph_sound or bag[bag.active_scheme]
	if not (st and st.actions) then
		return nil
	end
	local action, active
	for action, active in pairs(st.actions) do
		if active then
			return action
		end
	end
	return nil
end

local function toggle_ph_sound_radio(obj)
	local tg = time_global and time_global() or 0
	if tg > 0 and tg < last_ph_sound_toggle + 300 then
		return
	end
	last_ph_sound_toggle = tg

	local action = find_ph_sound_action(obj)
	if not action then
		log("use: no ph_sound action for %s", obj_name_lower(obj))
		return
	end

	-- Old 1.0.x stored mute as destr — clear so the radio can play again.
	if action.destructed then
		action.destructed = false
		action._fix_radio_muted = false
		arm_ph_sound(action)
		set_use_tip(obj)
		notify_toggle(false)
		log("use: cleared destr on %s", obj_name_lower(obj))
		return
	end

	action._fix_radio_muted = not action._fix_radio_muted
	if action._fix_radio_muted then
		apply_use_mute_volume(action)
	elseif not action.played_sound then
		arm_ph_sound(action)
	end
	set_use_tip(obj)
	notify_toggle(action._fix_radio_muted)
	log(
		"use: %s muted=%s snd=%s",
		obj_name_lower(obj),
		tostring(action._fix_radio_muted),
		tostring(action.played_sound ~= nil)
	)
end

function physic_object_on_use_callback(obj, who)
	if not is_device_radio(obj) then
		return
	end
	local bag = db and db.storage and db.storage[obj:id()]
	if not bag then
		return
	end
	if bag.active_scheme == "ph_sound" then
		toggle_ph_sound_radio(obj)
		return
	end
	-- ph_idle, or dead logic (scheme nil after old music<->broken toggle)
	if bag.active_scheme == "ph_idle" or bag.active_scheme == nil then
		toggle_ph_idle_radio(obj)
	end
end

function patched_snd_hit(self, obj, amount, local_direction, who, bone_index)
	if is_device_radio(self.object) then
		if self.played_sound then
			self.played_sound:stop()
			self.played_sound = nil
		end
		self.destructed = true
		self._fix_radio_muted = false
		return
	end
	if orig.snd_hit then
		return orig.snd_hit(self, obj, amount, local_direction, who, bone_index)
	end
end

function patched_snd_update(self, delta)
	if is_device_radio(self.object) then
		set_use_tip(self.object)
	end
	if not zone_enabled() then
		if self.played_sound then
			self.played_sound:stop()
			self.played_sound = nil
		end
		self._fix_radio_zone_blocked = true
		return
	end
	if self._fix_radio_zone_blocked then
		self._fix_radio_zone_blocked = false
		if not self.destructed and not self._fix_radio_muted then
			arm_ph_sound(self)
		end
	elseif is_device_radio(self.object)
		and not self.destructed
		and not self._fix_radio_muted
		and self.played_sound == nil
		and self.st
		and self.st.sound_set == false
	then
		arm_ph_sound(self)
	end
	local result
	if orig.snd_update then
		result = orig.snd_update(self, delta)
	end
	if is_device_radio(self.object) then
		apply_use_mute_volume(self)
	end
	return result
end

function patched_play_sound(actor, obj, p)
	if obj and is_device_radio(obj) and not zone_enabled() then
		if xr_sound and xr_sound.stop_sounds_by_id then
			xr_sound.stop_sounds_by_id(obj:id())
		end
		return
	end
	if orig.play_sound then
		return orig.play_sound(actor, obj, p)
	end
end

local function class_of(mod_name, class_name)
	local mod = module_of(mod_name)
	if mod and mod[class_name] then
		return mod[class_name]
	end
	return module_of(class_name)
end

local function patch_method(mod_name, class_name, method, wrapper, orig_key)
	local cls = class_of(mod_name, class_name)
	if not cls then
		return false
	end
	if cls[method] == wrapper then
		return true
	end
	if type(cls[method]) ~= "function" then
		return false
	end
	if orig[orig_key] == nil then
		orig[orig_key] = cls[method]
	end
	cls[method] = wrapper
	return true
end

local function install_world()
	local ok = true
	ok = patch_method("ph_idle", "action_idle", "hit_callback", patched_idle_hit, "idle_hit") and ok
	ok = patch_method("ph_idle", "action_idle", "use_callback", patched_idle_use, "idle_use") and ok
	ok = patch_method("ph_idle", "action_idle", "update", patched_idle_update, "idle_update") and ok
	ok = patch_method("ph_sound", "snd_source", "hit_callback", patched_snd_hit, "snd_hit") and ok
	ok = patch_method("ph_sound", "snd_source", "update", patched_snd_update, "snd_update") and ok

	-- Clear leftover use_callback from fix_radio 1.0.3–1.0.5 if still hanging on class.
	local snd_cls = class_of("ph_sound", "snd_source")
	if snd_cls and snd_cls.use_callback ~= nil then
		snd_cls.use_callback = nil
	end

	-- Do not add snd_source.use_callback: vanilla has none, and class lookup for a
	-- newly added method is unreliable. Binder always SendScriptCallbacks
	-- physic_object_on_use_callback — that is the toggle path for Zone FM.

	local fx = module_of("xr_effects")
	if fx and type(fx.play_sound) == "function" and fx.play_sound ~= patched_play_sound then
		orig.play_sound = orig.play_sound or fx.play_sound
		fx.play_sound = patched_play_sound
	end

	if ui_options and type(ui_options.get) == "function" and ui_options.get ~= patched_ui_get then
		orig.ui_get = orig.ui_get or ui_options.get
		ui_options.get = patched_ui_get
	end
	return ok
end

local function restore_method(mod_name, class_name, method, orig_key)
	local cls = class_of(mod_name, class_name)
	if cls and orig[orig_key] ~= nil then
		cls[method] = orig[orig_key]
	end
end

function install()
	install_placeable()
	install_world()
	if not installed then
		installed = true
		log("loaded v%s", VERSION)
	end
	return true
end

function uninstall()
	local hf = module_of("placeable_radio")
	if hf and hf.placeable_radio_wrapper and orig.placeable_init then
		hf.placeable_radio_wrapper.__init = orig.placeable_init
	end
	restore_method("ph_idle", "action_idle", "hit_callback", "idle_hit")
	restore_method("ph_idle", "action_idle", "use_callback", "idle_use")
	restore_method("ph_idle", "action_idle", "update", "idle_update")
	restore_method("ph_sound", "snd_source", "hit_callback", "snd_hit")
	restore_method("ph_sound", "snd_source", "update", "snd_update")
	local fx = module_of("xr_effects")
	if fx and orig.play_sound then
		fx.play_sound = orig.play_sound
	end
	if ui_options and orig.ui_get then
		ui_options.get = orig.ui_get
	end
	installed = false
end

function actor_on_first_update()
	install()
end

function on_game_start()
	install()
	if not callbacks_registered then
		RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
		RegisterScriptCallback("physic_object_on_use_callback", physic_object_on_use_callback)
		callbacks_registered = true
	end
end

function on_game_end()
	if callbacks_registered then
		UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
		UnregisterScriptCallback("physic_object_on_use_callback", physic_object_on_use_callback)
		callbacks_registered = false
	end
	uninstall()
end
