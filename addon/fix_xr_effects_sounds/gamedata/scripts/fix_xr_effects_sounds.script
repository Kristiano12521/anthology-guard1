local function install()
    if type(xr_effects) ~= "table" then
        printf(LOG_TAG .. " xr_effects not found - not installed")
        return false
    end

    local wrapped = 0
    local missing = 0

    local function wrap(name, fn)
        if type(xr_effects[name]) ~= "function" then
            printf(LOG_TAG .. " missing %s", name)
            missing = missing + 1
            return
        end
        if xr_effects[name] == fn then
            return
        end
        orig[name] = orig[name] or xr_effects[name]
        xr_effects[name] = fn
        wrapped = wrapped + 1
    end

    for name, fn in pairs(s2d_patches) do
        wrap(name, fn)
    end
    wrap("x18_gluk", patched.x18_gluk)
    wrap("weapon_shoot_mod", patched.weapon_shoot_mod)
    wrap("weapon_shoot_mod_sniper", patched.weapon_shoot_mod_sniper)

    printf(LOG_TAG .. " wrapped %s functions, missing %s", tostring(wrapped), tostring(missing))
    return wrapped > 0
end

local function uninstall()
    if type(xr_effects) ~= "table" then
        return
    end
    for name, fn in pairs(orig) do
        xr_effects[name] = fn
    end
end

function on_game_start()
    install()
end

function on_game_end()
    uninstall()
end

