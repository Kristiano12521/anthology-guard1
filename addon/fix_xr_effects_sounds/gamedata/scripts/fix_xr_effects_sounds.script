-- XR Effects Sound Paths Fix
-- Anomaly 1.5.3 / Anthology 2.1
--
-- Anthology 2.1 xr_effects.script turned \t / \n inside [[ ]] paths
-- into real TAB / newline. Restore the intended Windows paths.
-- Originals are not called: they still open the broken path.

local LOG_TAG = "[fix_xr_effects_sounds]"
local orig = {}
local patched = {}

local function play_s2d(slot_name, path, delay)
    local snd = sound_object(path)
    xr_effects[slot_name] = snd
    snd:play_at_pos(db.actor, vector():set(0, 0, 0), delay or 0, sound_object.s2d)
end

local function play_weap(snd, obj)
    snd:play_at_pos(obj, db.actor:position(), 0, sound_object.s3d)
end

function patched.x18_gluk(actor, npc)
    level.add_pp_effector("blink.ppe", 234, false)
    local sound_obj_l = xr_sound.get_safe_sound_object("affects\\psy_blackout_l")
    local sound_obj_r = xr_sound.get_safe_sound_object("affects\\psy_blackout_r")
    local snd_obj = xr_sound.get_safe_sound_object("affects\\tinnitus3a")
    snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0, 1.0)
    sound_obj_l:play_no_feedback(db.actor, sound_object.s2d, 0, vector():set(-1, 0, 1), 1.0, 1.0)
    sound_obj_r:play_no_feedback(db.actor, sound_object.s2d, 0, vector():set(1, 0, 1), 1.0, 1.0)
    level.add_cam_effector("camera_effects\\earthquake.anm", 1974, false, "")
end

function patched.weapon_shoot_mod(actor, obj, p)
    local sound_shoot_svd = sound_object("weapons\\n_svd_shot")
    local sound_shoot_ak74 = sound_object("weapons\\n_ak74_shot")
    local sound_shoot_spas12 = sound_object("weapons\\n_spas12_shot")
    local sound_shoot_pm = sound_object("weapons\\n_pm_shot")
    local sound_shoot_vintorez = sound_object("weapons\\n_vintorez_shot")
    local sound_shoot_usp = sound_object("weapons\\n_usp_shot")
    local sound_explode = sound_object("weapons\\t_f1_explosion")
    local weap = p[1]
    if weap == "svd" then
        play_weap(sound_shoot_svd, obj)
    elseif weap == "ak74" then
        play_weap(sound_shoot_ak74, obj)
    elseif weap == "spas12" then
        play_weap(sound_shoot_spas12, obj)
    elseif weap == "pm" then
        play_weap(sound_shoot_pm, obj)
    elseif weap == "vintorez" then
        play_weap(sound_shoot_vintorez, obj)
    elseif weap == "explode" then
        play_weap(sound_explode, obj)
    elseif weap == "usp" then
        play_weap(sound_shoot_usp, obj)
    end
end

function patched.weapon_shoot_mod_sniper(actor, obj, p)
    local sound_svd = sound_object("weapons\\n_svd_shot")
    local sound_svu = sound_object("weapons\\n_svu_shot")
    local weap = p[1]
    if weap == "svd1" or weap == "svd2" or weap == "svd3" or weap == "svd4" or weap == "svd5"
        or weap == "svd6" or weap == "svd7" or weap == "svd8" or weap == "svd9" or weap == "svd10" then
        play_weap(sound_svd, obj)
    elseif weap == "svu1" or weap == "svu2" or weap == "svu3" or weap == "svu4" or weap == "svu5"
        or weap == "svu6" or weap == "svu7" or weap == "svu8" or weap == "svu9" or weap == "svu10" then
        play_weap(sound_svu, obj)
    end
end

