-- Autocomplete DRX SL Guard
-- Anomaly 1.5.3 / Anthology 2.1
--
-- Autocomplete Tasks treats general_bounty_task at stage_complete as done and
-- calls set_task_completed in the field. DRX SL bounties (simulation_task_*)
-- run drx_sl_* from on_complete; that path hung on kurchatov_37 after killing
-- the target. Vanilla bounty / assault / spring-clean stay eligible.

local LOG_TAG = "[fix_autocomplete_drx_sl]"
local VERSION = "1.0.0"
local CORE_NAME = "z_autocomplete_tasks_core"
local MARKER = "drx_sl_"
local FIELDS = { "on_init", "on_complete", "on_fail" }

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig_should = nil
local installed = false
local skipped = {}

local function core()
	local ns = rawget(_G, CORE_NAME)
	if type(ns) == "table" and type(ns.should_autocomplete) == "function" then
		return ns
	end
	return nil
end

local function field_has_drx_sl(ini, tid, field)
	if not ini:line_exist(tid, field) then
		return false
	end
	local value = ini:r_string_ex(tid, field)
	if not value then
		return false
	end
	return string.find(string.lower(tostring(value)), MARKER, 1, true) ~= nil
end

local function is_drx_sl_task(tid)
	if type(tid) ~= "string" or tid == "" then
		return false
	end
	local ini = task_manager and task_manager.task_ini
	if not ini then
		return false
	end
	local ok, hit = pcall(function()
		if not ini:section_exist(tid) then
			return false
		end
		for i = 1, #FIELDS do
			if field_has_drx_sl(ini, tid, FIELDS[i]) then
				return true
			end
		end
		return false
	end)
	return ok and hit
end

function patched_should_autocomplete(tid, stage)
	if is_drx_sl_task(tid) then
		if not skipped[tid] then
			skipped[tid] = true
			printf("%s skip autocomplete tid=%s reason=drx_sl_effect", LOG_TAG, tid)
		end
		return false
	end
	return orig_should(tid, stage)
end

local function install()
	if installed then
		return true
	end
	local ns = core()
	if not ns then
		printf("%s %s.should_autocomplete not found - guard NOT installed", LOG_TAG, CORE_NAME)
		return false
	end
	if ns.should_autocomplete == patched_should_autocomplete then
		installed = true
		return true
	end
	orig_should = orig_should or ns.should_autocomplete
	ns.should_autocomplete = patched_should_autocomplete
	installed = true
	printf("%s should_autocomplete wrapped", LOG_TAG)
	return true
end

local function uninstall()
	local ns = rawget(_G, CORE_NAME)
	if orig_should and type(ns) == "table" then
		ns.should_autocomplete = orig_should
	end
	installed = false
	orig_should = nil
end

local function on_game_load()
	skipped = {}
end

local function actor_on_first_update()
	install()
end

function on_game_start()
	install()
	RegisterScriptCallback("on_game_load", on_game_load)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end

function on_game_end()
	UnregisterScriptCallback("on_game_load", on_game_load)
	UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
	uninstall()
end
