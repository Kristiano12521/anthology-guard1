; fix_indeikam_breeding: distinct names + missing Brunko breeding sections.
; Why: items_artefacts_upgrades.ltx is only #included (not a DLTX root), so
;      mod_items_artefacts_upgrades_*.ltx never loads. Put sections here via
;      mod_system_* like the working Kristiano AIO / fix_quest_stash pattern.
; Names: remap inv_name to *_anth_fix so language-pack st_af_indeikam_name
;      cannot win. af_indeikam = Indian Stone, af_indeikam3 = Patterned Stone.
; Breeding stats: same as af_oblivion_breeding_* neighbors.
; @[...] creates section if missing (Modded Exes).

![af_indeikam]
inv_name                     = st_af_indeikam_name_anth_fix
inv_name_short               = st_af_indeikam_name_anth_fix

![af_indeikam3]
inv_name                     = st_af_indeikam3_name_anth_fix
inv_name_short               = st_af_indeikam3_name_anth_fix

![af_indeikam3_af_iam]
inv_name                     = st_af_indeikam3_af_iam_name_anth_fix
inv_name_short               = st_af_indeikam3_af_iam_name_anth_fix

![af_indeikam3_af_aac]
inv_name                     = st_af_indeikam3_af_aac_name_anth_fix
inv_name_short               = st_af_indeikam3_af_aac_name_anth_fix

![af_indeikam3_af_aam]
inv_name                     = st_af_indeikam3_af_aam_name_anth_fix
inv_name_short               = st_af_indeikam3_af_aam_name_anth_fix

![af_indeikam3_lead_box]
inv_name                     = st_af_indeikam3_lead_box_name_anth_fix
inv_name_short               = st_af_indeikam3_lead_box_name_anth_fix

@[af_indeikam_breeding_1]:af_indeikam
$spawn                       = "af\unique\af_indeikam_1"
