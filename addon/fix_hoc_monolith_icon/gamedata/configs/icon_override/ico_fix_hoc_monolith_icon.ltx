; HoC Icons maps monolith_outfit to ui_stalker2_armors (24,6) via mod_system_zzzzzzz.
; That cell is the Wind of Freedom sprite. icon_override is read before ini_sys.
; Child stalker_monolith_outfit is a separate lookup (no LTX inherit in this ini).

[monolith_outfit]
icons_texture   = ui\ui_icon_equipment
inv_grid_x      = 90
inv_grid_y      = 3
inv_grid_width  = 2
inv_grid_height = 3
inv_grid_scale  = 1

[stalker_monolith_outfit]
icons_texture   = ui\ui_icon_equipment
inv_grid_x      = 90
inv_grid_y      = 3
inv_grid_width  = 2
inv_grid_height = 3
inv_grid_scale  = 1
