-- load-order: after stash_capacities.script
-- Stash Capacities Nil Guard
-- Anomaly 1.5.3 / Anthology 2.1
--
-- Hideout Furniture stash_capacities.actor_on_item_after_move is local.
-- Action_Move_All (ish_fast_transfer loot) sets weight_add, then Action_Move
-- can SendScriptCallback ActorMenu_on_item_after_move with obj=nil after
-- CheckItem fails on a released child id. Line 92 does obj:weight() -> FATAL
-- lua_pcall_failed. before_move already returns on nil; after_move does not.
--
-- The handler is not a module global, so the arti_frames slot wrap does not
-- apply. Hook _G.RegisterScriptCallback while their on_game_start runs, and
-- if they already registered, steal the closure from axr_main intercepts
-- (debug.getupvalue on callback_set; same path as fix_misc_script_errors).

local LOG_TAG = "[fix_stash_capacities_nil]"
local VERSION = "1.0.1"
local MODULE_NAME = "stash_capacities"
local AFTER_MOVE = "ActorMenu_on_item_after_move"
local SOURCE_MARK = "stash_capacities"
local LOG_INTERVAL_MS = 1000

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig_on_game_start = nil
local orig_after_move = nil
local installed = false
local after_move_wrapped = false
local callbacks_registered = false
local skip_count = 0
local last_log_tg = 0

local function log_skip(npc_id)
	skip_count = skip_count + 1
	local now = time_global()
	if (now - last_log_tg) < LOG_INTERVAL_MS then
		return
	end
	last_log_tg = now
	printf(
		"%s skip nil obj (npc_id=%s, batch_total=%s)",
		LOG_TAG,
		tostring(npc_id),
		tostring(skip_count)
	)
end

function guarded_after_move(npc_id, obj, ...)
	if obj == nil then
		log_skip(npc_id)
		return
	end
	if not orig_after_move then
		return
	end
	return orig_after_move(npc_id, obj, ...)
end

local function is_stash_callback(fn)
	if type(fn) ~= "function" or fn == guarded_after_move then
		return false
	end
	if not (debug and type(debug.getinfo) == "function") then
		return false
	end
	local info = debug.getinfo(fn, "S")
	if not info then
		return false
	end
	-- short_src is capped (~60 bytes) and is always set, so it hides source.
	local src = tostring(info.source or "") .. " " .. tostring(info.short_src or "")
	return string.find(src, SOURCE_MARK, 1, true) ~= nil
end

local function module_of(name)
	local mod = rawget(_G, name)
	if type(mod) ~= "table" then
		mod = _G[name]
	end
	if type(mod) ~= "table" then
		return nil
	end
	return mod
end

local function intercepts_bucket()
	if not (debug and type(debug.getupvalue) == "function") then
		return nil
	end
	local axr = module_of("axr_main")
	if not (axr and type(axr.callback_set) == "function") then
		return nil
	end
	local i = 1
	while true do
		local name, val = debug.getupvalue(axr.callback_set, i)
		if not name then
			break
		end
		if name == "intercepts" and type(val) == "table" then
			local bucket = val[AFTER_MOVE]
			if type(bucket) == "table" then
				return bucket
			end
			return nil
		end
		i = i + 1
	end
	return nil
end

local function try_wrap_registered_after_move()
	local bucket = intercepts_bucket()
	if not bucket then
		return after_move_wrapped
	end

	local raws = {}
	for fn, _ in pairs(bucket) do
		if fn == guarded_after_move then
			after_move_wrapped = true
		elseif is_stash_callback(fn) then
			raws[#raws + 1] = fn
		end
	end
	if #raws == 0 then
		return after_move_wrapped
	end

	for i = 1, #raws do
		orig_after_move = raws[i]
		if type(UnregisterScriptCallback) == "function" then
			UnregisterScriptCallback(AFTER_MOVE, raws[i])
		end
	end
	if type(RegisterScriptCallback) ~= "function" then
		printf("%s RegisterScriptCallback missing - guard NOT installed", LOG_TAG)
		return false
	end
	RegisterScriptCallback(AFTER_MOVE, guarded_after_move)
	after_move_wrapped = true
	printf("%s wrapped existing after_move (late) v%s", LOG_TAG, VERSION)
	return true
end

local function steal_after_move(raw_fn)
	if not is_stash_callback(raw_fn) then
		return raw_fn
	end
	orig_after_move = raw_fn
	after_move_wrapped = true
	return guarded_after_move
end

function patched_on_game_start()
	local prev_register = _G.RegisterScriptCallback
	_G.RegisterScriptCallback = function(name, fn)
		if name == AFTER_MOVE then
			fn = steal_after_move(fn)
		end
		return prev_register(name, fn)
	end

	local ok, err = true, nil
	if orig_on_game_start then
		ok, err = pcall(orig_on_game_start)
	end

	_G.RegisterScriptCallback = prev_register

	if after_move_wrapped then
		printf("%s wrapped after_move nil-guard v%s", LOG_TAG, VERSION)
	end
	if not ok then
		error(err)
	end
end

local saved_register = nil

local function hooked_register(name, fn)
	if name == AFTER_MOVE and type(fn) == "function" then
		fn = steal_after_move(fn)
	end
	return saved_register(name, fn)
end

local function arm_register_hook()
	if saved_register then
		return
	end
	if type(RegisterScriptCallback) ~= "function" then
		return
	end
	saved_register = RegisterScriptCallback
	_G.RegisterScriptCallback = hooked_register
end

local function disarm_register_hook()
	if saved_register and _G.RegisterScriptCallback == hooked_register then
		_G.RegisterScriptCallback = saved_register
	end
	saved_register = nil
end

local function install(silent)
	local mod = module_of(MODULE_NAME)
	if not (mod and type(mod.on_game_start) == "function") then
		if not silent then
			printf("%s %s.on_game_start not found - guard NOT installed", LOG_TAG, MODULE_NAME)
		end
		return false
	end

	if mod.on_game_start ~= patched_on_game_start then
		orig_on_game_start = mod.on_game_start
		mod.on_game_start = patched_on_game_start
		installed = true
		printf("%s wrapped %s.on_game_start v%s", LOG_TAG, MODULE_NAME, VERSION)
	else
		installed = true
	end

	try_wrap_registered_after_move()
	return true
end

local function uninstall()
	if after_move_wrapped and type(UnregisterScriptCallback) == "function" then
		UnregisterScriptCallback(AFTER_MOVE, guarded_after_move)
	end
	if orig_after_move and type(RegisterScriptCallback) == "function" then
		RegisterScriptCallback(AFTER_MOVE, orig_after_move)
	end
	orig_after_move = nil
	after_move_wrapped = false

	local mod = module_of(MODULE_NAME)
	if mod and orig_on_game_start and mod.on_game_start == patched_on_game_start then
		mod.on_game_start = orig_on_game_start
	end
	orig_on_game_start = nil
	installed = false
end

function actor_on_first_update()
	if not installed then
		install(true)
	end
	try_wrap_registered_after_move()
	disarm_register_hook()
	if after_move_wrapped then
		printf("%s guard installed v%s", LOG_TAG, VERSION)
	else
		printf("%s after_move nil-guard NOT installed (callback not found)", LOG_TAG)
	end
end

-- File load is before any on_game_start. HF registers the local callback
-- from stash_capacities.on_game_start via the global RegisterScriptCallback.
arm_register_hook()
install(true)

function on_game_start()
	install(false)
	if not callbacks_registered then
		RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = true
	end
end

function on_game_end()
	if callbacks_registered then
		UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = false
	end
	uninstall()
end
