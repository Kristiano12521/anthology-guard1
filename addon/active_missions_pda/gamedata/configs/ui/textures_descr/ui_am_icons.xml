<w>
	<!-- Category glyphs for the Active Missions tab.
	     Generated by make-icons.ps1 -- 1024x512 sheet, 8 columns of 128px cells.
	     The order here must match the $Glyphs array in that script. -->
	<file name="ui\am_category_icons">
		<texture id="ui_am_icon_story"    x="0"   y="0"   width="128" height="128" />
		<texture id="ui_am_icon_fetch"    x="128" y="0"   width="128" height="128" />
		<texture id="ui_am_icon_delivery" x="256" y="0"   width="128" height="128" />
		<texture id="ui_am_icon_bounty"   x="384" y="0"   width="128" height="128" />
		<texture id="ui_am_icon_hunt"     x="512" y="0"   width="128" height="128" />
		<texture id="ui_am_icon_assault"  x="640" y="0"   width="128" height="128" />
		<texture id="ui_am_icon_defense"  x="768" y="0"   width="128" height="128" />
		<texture id="ui_am_icon_rescue"   x="896" y="0"   width="128" height="128" />

		<texture id="ui_am_icon_survey"   x="0"   y="128" width="128" height="128" />
		<texture id="ui_am_icon_stash"    x="128" y="128" width="128" height="128" />
		<texture id="ui_am_icon_payment"  x="256" y="128" width="128" height="128" />
		<texture id="ui_am_icon_spy"      x="384" y="128" width="128" height="128" />
		<texture id="ui_am_icon_fate"     x="512" y="128" width="128" height="128" />
		<texture id="ui_am_icon_sabotage" x="640" y="128" width="128" height="128" />
		<texture id="ui_am_icon_survival" x="768" y="128" width="128" height="128" />
		<texture id="ui_am_icon_wait"     x="896" y="128" width="128" height="128" />

		<texture id="ui_am_icon_other"    x="0"   y="256" width="128" height="128" />
		<texture id="ui_am_icon_group"    x="128" y="256" width="128" height="128" />

		<!-- BUTTON TEXTURES NEED ALL FOUR STATES.
		     A CUI3tButton does NOT look up the plain name -- it appends _e/_t/
		     _h/_d and asks for those. Every working button texture in the game
		     is defined that way and none define the bare name. Registering only
		     the bare id means all four lookups miss and the engine draws its
		     missing-texture fill, which is the blue that kept coming back.
		     Statics are different: they take the plain name, which is why the
		     category icons above worked while the buttons did not.

		     So every id used as a button texture is repeated four ways below.
		     Adding a new one? If a button will wear it, add the four states. -->

		<!-- Worn by the injected PDA tab when it lands on an icon-style strip,
		     where each tab has its own picture and there is no shared frame to
		     borrow. Same cell as ui_am_icon_group above. -->
		<texture id="ui_am_icon_group_e"  x="128" y="256" width="128" height="128" />
		<texture id="ui_am_icon_group_t"  x="128" y="256" width="128" height="128" />
		<texture id="ui_am_icon_group_h"  x="128" y="256" width="128" height="128" />
		<texture id="ui_am_icon_group_d"  x="128" y="256" width="128" height="128" />

		<!-- Mod App Creator launcher icon. Cell index 19. -->
		<texture id="ui_am_icon_app"      x="384" y="256" width="128" height="128" />
		<texture id="ui_am_icon_app_e"    x="384" y="256" width="128" height="128" />
		<texture id="ui_am_icon_app_t"    x="384" y="256" width="128" height="128" />
		<texture id="ui_am_icon_app_h"    x="384" y="256" width="128" height="128" />
		<texture id="ui_am_icon_app_d"    x="384" y="256" width="128" height="128" />

		<!-- Deliberately empty cell, used as the texture for the invisible click
		     surfaces behind the mission cards so a card shows only its frame.
		     All four state ids point at the same transparent pixels. -->
		<texture id="ui_am_blank_e"       x="256" y="256" width="128" height="128" />
		<texture id="ui_am_blank_t"       x="256" y="256" width="128" height="128" />
		<texture id="ui_am_blank_h"       x="256" y="256" width="128" height="128" />
		<texture id="ui_am_blank_d"       x="256" y="256" width="128" height="128" />
		<texture id="ui_am_blank"         x="256" y="256" width="128" height="128" />
	</file>
</w>
