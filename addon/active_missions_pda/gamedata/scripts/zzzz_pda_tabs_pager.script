-- load-order: после anthology zzzz_pda_tabs_pager (same filename override)
-- Active Missions Anthology: adds eptActiveMissions next to Area Map.
-- Keep in sync with reference/anthology/scripts/zzzz_pda_tabs_pager.script
-- when the core pager changes.

local prev_id = "eptPdaTabsPrev"
local next_id = "eptPdaTabsNext"
local page_size = 7
local page = 1
local prev_text = "<<"
local next_text = ">>"
local last_real_section = "eptTasks"
local current_wrapper = nil
local next_layout_tg = 0

local real_order = {
	"eptTasks",
	"eptActiveMissions",
	"eptRanking",
	"eptRelations",
	"eptContacts",
	"eptEncyclopedia",
	"eptRadio",
	"eptLogs",
	"eptExtraAchievements",
	"eptHarukaSkills",
	"eptUtjanTraits",
	"eptTalents",
	"eptInteractivePDA",
	"eptFactions",
	"eptTaskboard"
}

local function safe_call(obj, method, ...)
	if not obj then return false end
	local ok, fn = pcall(function()
		return obj[method]
	end)
	if not (ok and type(fn) == "function") then return false end
	local args = {...}
	ok = pcall(function()
		return fn(obj, unpack(args))
	end)
	return ok
end

local function get_menu_tab()
	if not (ActorMenu and ActorMenu.get_pda_menu) then return end
	local menu = ActorMenu.get_pda_menu()
	if not menu then return end
	local ok, tab = pcall(function()
		return menu:GetTabControl()
	end)
	if not (ok and tab) then return menu end
	return menu, tab
end

local function get_button(tab, id)
	if not tab then return end
	local ok, btn = pcall(function()
		return tab:GetButtonById(id)
	end)
	return ok and btn or nil
end

local function build_existing_order(tab)
	local result = {}
	for _, id in ipairs(real_order) do
		if get_button(tab, id) then
			result[#result + 1] = id
		end
	end
	return result
end

local function find_index(list, section)
	for idx, id in ipairs(list) do
		if id == section then
			return idx
		end
	end
end

local function get_page_count(list)
	return math.max(1, math.ceil(#list / page_size))
end

local function clamp_page(value, list)
	local max_page = get_page_count(list)
	if value < 1 then return 1 end
	if value > max_page then return max_page end
	return value
end

local function page_for_section(list, section)
	local idx = find_index(list, section)
	return idx and clamp_page(math.ceil(idx / page_size), list) or page
end

local function get_text_control(btn)
	if not btn then return end
	local ok, text = pcall(function()
		return btn:TextControl()
	end)
	return ok and text or nil
end

local function set_button_label(btn, label, width)
	if not label then return end
	local text = get_text_control(btn)
	if text then
		safe_call(text, "SetText", label)
		safe_call(text, "SetTextColor", GetARGB(255, 230, 230, 230))
		safe_call(text, "SetWndSize", vector2():set(width or 40, 27))
	end
	safe_call(btn, "SetText", label)
end

local function show_button(btn, show, x, width, label)
	if not btn then return end
	safe_call(btn, "Show", show)
	safe_call(btn, "Enable", show)
	safe_call(btn, "SetWndPos", vector2():set(x, 0))
	safe_call(btn, "SetWndSize", vector2():set(width, 27))
	set_button_label(btn, label, width)
end

local function first_section_on_page(list, target_page)
	local first_idx = ((target_page - 1) * page_size) + 1
	return list[first_idx] or list[1] or "eptTasks"
end

local function section_on_current_page(list, section)
	local idx = find_index(list, section)
	if not idx then return false end
	local first_idx = ((page - 1) * page_size) + 1
	return idx >= first_idx and idx < first_idx + page_size
end

local function apply_layout(preferred_section)
	local menu, tab = get_menu_tab()
	if not (menu and tab) then return end

	local order = build_existing_order(tab)
	local active = preferred_section or menu:GetActiveSection()
	if active and active ~= prev_id and active ~= next_id and find_index(order, active) then
		last_real_section = active
		page = page_for_section(order, active)
	end
	page = clamp_page(page, order)

	local tab_x = 132
	local tab_y = 23
	local available = 570
	local arrow_w = 40
	local gap = 4
	local show_prev = page > 1
	local show_next = page < get_page_count(order)
	local first_idx = ((page - 1) * page_size) + 1
	local last_idx = math.min(first_idx + page_size - 1, #order)
	local visible_count = last_idx - first_idx + 1
	local arrow_space = (show_prev and (arrow_w + gap) or 0) + (show_next and (arrow_w + gap) or 0)
	local real_w = visible_count > 0 and math.floor((available - arrow_space) / visible_count) or 80
	if real_w > 89 then real_w = 89 end
	if real_w < 55 then real_w = 55 end

	safe_call(tab, "SetWndPos", vector2():set(tab_x, tab_y))
	safe_call(tab, "SetWndSize", vector2():set(available, 27))

	local x = 0
	show_button(get_button(tab, prev_id), show_prev, x, arrow_w, prev_text)
	if show_prev then
		x = x + arrow_w + gap
	end

	for idx, id in ipairs(order) do
		local btn = get_button(tab, id)
		local show = idx >= first_idx and idx <= last_idx
		if show then
			show_button(btn, true, x, real_w)
			x = x + real_w
		else
			show_button(btn, false, -2000, 1)
		end
	end

	for _, id in ipairs(real_order) do
		if not find_index(order, id) then
			show_button(get_button(tab, id), false, -2000, 1)
		end
	end

	if show_next then
		x = x + gap
	end
	show_button(get_button(tab, next_id), show_next, x, arrow_w, next_text)
end

local function delayed_activate(section)
	local menu, tab = get_menu_tab()
	if not (menu and tab and menu:IsShown()) then return true end
	apply_layout(section)
	safe_call(tab, "SetActiveTab", section)
	return true
end

local function schedule_activate(section)
	if not section then return end
	if RemoveTimeEvent then
		RemoveTimeEvent("pda_tabs_pager", "activate")
	end
	if CreateTimeEvent then
		CreateTimeEvent("pda_tabs_pager", "activate", 0, delayed_activate, section)
	end
end

local function choose_section_for_page(list)
	if section_on_current_page(list, last_real_section) then
		return last_real_section
	end
	return first_section_on_page(list, page)
end

local function patch_pda_subdialog()
	local pda_script = rawget(_G, "pda")
	if not (pda_script and pda_script.set_active_subdialog) then return end
	if pda_script.set_active_subdialog == current_wrapper then return end

	local next_set_active_subdialog = pda_script.set_active_subdialog
	current_wrapper = function(section)
		local menu, tab = get_menu_tab()
		if section == prev_id or section == next_id then
			local order = tab and build_existing_order(tab) or real_order
			if menu then
				local active = menu:GetActiveSection()
				if active and find_index(order, active) then
					last_real_section = active
				end
			end
			page = clamp_page(page + (section == next_id and 1 or -1), order)
			local target = choose_section_for_page(order)
			apply_layout(target)
			schedule_activate(target)
			return menu and menu:GetActiveDialog() or nil
		end

		if tab then
			local order = build_existing_order(tab)
			if find_index(order, section) then
				last_real_section = section
				page = page_for_section(order, section)
				apply_layout(section)
			end
		end

		return next_set_active_subdialog(section)
	end

	pda_script.set_active_subdialog = current_wrapper
end

local function actor_on_update()
	local now = time_global()
	if now < next_layout_tg then return end
	next_layout_tg = now + 250
	local menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu()
	if menu and menu:IsShown() then
		apply_layout()
	end
end

function on_game_start()
	patch_pda_subdialog()
	RegisterScriptCallback("on_game_load", patch_pda_subdialog)
	RegisterScriptCallback("actor_on_update", actor_on_update)
end