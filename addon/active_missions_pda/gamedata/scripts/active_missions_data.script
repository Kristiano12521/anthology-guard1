-- Active Missions - data layer
--
-- Collects the actor's in-progress tasks out of task_manager and decorates each
-- one with the three things the vanilla PDA list refuses to tell you: what kind
-- of job it is, which map it is on, and who handed it out.
--
-- Nothing here touches the engine task list, so the stock "Area map" tab keeps
-- working exactly as before.

local gts = game.translate_string

-- ---------------------------------------------------------------------------
-- Mission type classification
-- ---------------------------------------------------------------------------
-- Tasks carry no type field, so we read it off the functors declared in the
-- tm_*.ltx section. status_functor is the more specific of the two, so it wins;
-- target_functor is the fallback. Anything unrecognised lands in "other" rather
-- than being dropped, so tasks from addons we've never heard of still show up.

local type_by_status = {
	actor_has_fetch_item                     = "fetch",
	actor_has_fetch_weapon_warfare           = "fetch",
	multifetch_status_functor                = "fetch",
	drx_sl_quest_item_task_status            = "fetch",
	drx_sl_retrieve_item_task_status         = "fetch",
	intercept_artifact_task_status_functor   = "fetch",
	skyfall_task_status_functor              = "fetch",
	recover_item_on_corpse_status_functor    = "fetch",

	delivery_task                            = "delivery",
	urgent_orders_status_functor             = "delivery",

	bounty_task                              = "bounty",
	top_10_task_status_functor               = "bounty",
	tracking_stalker_task_status_functor     = "bounty",
	vengence_amplified_status_functor        = "bounty",

	big_game_task_status_functor             = "hunt",
	baba_yaga_task_status_functor            = "hunt",

	assault_task_status_functor              = "assault",
	dominance_task_status_functor            = "assault",

	gd_task_status_functor                   = "defense",
	hold_the_ground_task_status_functor      = "defense",
	no_step_back_task_status_functor         = "defense",
	dead_night_task_status_functor           = "defense",

	hostage_task                             = "rescue",
	duty_girl_task_status                    = "rescue",

	measure_task                             = "survey",
	anomaly_scanner_task_status              = "survey",
	chimera_scan_status                      = "survey",
	recover_mutant_data_status               = "survey",
	task_type_ecolog_gathered_tissue_samples = "survey",

	nta_stash_task_status_functor            = "stash",
	drx_sl_money_task_status                 = "payment",
	spy_task_status_functor                  = "spy",
	fate_task                                = "fate",
	veh_destroy_sf                           = "sabotage",
	check_if_enough_time_passed              = "wait",

	-- Addon quest lines that are storyline anyway; listed so they still land
	-- somewhere sensible if storyline splitting is turned off in MCM.
	special_steps_for_lostzone_tasks         = "story",
	brain_game_status_functor                = "story",
	gambling_with_life_status_functor        = "story",
	house_of_horrors_task_status_functor     = "story",
	mirage_task_status_functor               = "story",
	mystery_of_the_swamps_task_status_functor = "story",
	the_living_fire_task_status_functor      = "story",
	sbf_cotb_task_status_functor             = "story",
	sbf_intro_task_status_functor            = "story",
	sbf_lad_task_status_functor              = "story",
	agr_u_bandit_boss_task_1_stages          = "story",
