-- Active Missions - PDA tab
--
-- A grouped, filterable view of the tasks the actor is currently carrying.
-- Left column picks how to group (mission type / map region / giving faction /
-- everything at once) and lists the groups; the right column lists the missions
-- in the selected group as cards that expand to the full briefing.
--
-- The stock "Area map" tab is untouched -- this is purely additive.

local gts = game.translate_string

local CARD_W          = 554  -- widened: four labelled lines were overflowing
local CARD_BASE_H     = 96   -- collapsed card; the list has no vert_interval, so
                             -- the 4px below the content is the gap between cards
local CARD_DESCR_PAD  = 18   -- room below the briefing box, which starts at y=96
local DESCR_FRAME_W   = 534  -- must match <card_descr_frame_*> in the layout
local DESCR_BOX_PAD   = 14   -- padding the briefing box adds around its text
local CAT_ROW_H       = 44
local CAT_ROW_W       = 176  -- must match <cat_row> in the layout

-- Custom iTheon's PDA Taskboard ships rounded 9-slice card frames and a set of
-- per-category icons. When it is installed we borrow them so this tab matches
-- the board it sits beside; otherwise everything falls back to stock Anomaly
-- frames and one generic icon. Purely cosmetic, and an optional dependency --
-- the mod is never required.
--
-- pda_taskboard is the giveaway: that namespace is unique to this fork. 293,
-- 463 and the Gamma fork all ship ui_pda_taskboard_tab without it.
local function custom_skin()
	return _G.pda_taskboard ~= nil
end

-- Our own line-art glyph per mission type, shipped with the mod.
--
-- Vanilla's PDA icons are character portraits and map pins -- they look nothing
-- like a task board icon, and there is no line-art set in the base game or
-- anywhere else in the pack that covers seventeen mission types. So the sheet is
-- generated by make-icons.ps1 (1024x512 uncompressed 32-bit DDS, the format
-- Anomaly's UI atlases use) and every type gets its own symbol, with no
-- dependency on anything.
local OWN_TYPE_ICON = {
	story    = "ui_am_icon_story",     -- star
	fetch    = "ui_am_icon_fetch",     -- download into a tray
	delivery = "ui_am_icon_delivery",  -- parcel
	bounty   = "ui_am_icon_bounty",    -- head with a target
	hunt     = "ui_am_icon_hunt",      -- paw
	assault  = "ui_am_icon_assault",   -- crosshair over a building
	defense  = "ui_am_icon_defense",   -- shield
	rescue   = "ui_am_icon_rescue",    -- medical cross
	survey   = "ui_am_icon_survey",    -- magnifier
	stash    = "ui_am_icon_stash",     -- chest
	payment  = "ui_am_icon_payment",   -- banknote
	spy      = "ui_am_icon_spy",       -- eye
	fate     = "ui_am_icon_fate",      -- question mark
	sabotage = "ui_am_icon_sabotage",  -- bomb
	survival = "ui_am_icon_survival",  -- flame
	wait     = "ui_am_icon_wait",      -- clock
	other    = "ui_am_icon_other",     -- ellipsis
}

local OWN_GROUP_ICON = "ui_am_icon_group"

-- Always our own set. Borrowing Custom iTheon's was tried and dropped: it only
-- covers eleven of our seventeen types, so several had to share a glyph, and it
-- made the sidebar depend on which taskboard fork happened to be installed. Ours
-- gives every type its own symbol and looks the same everywhere.
local function category_icon(key, mode)
	if (mode ~= "type") then
		return OWN_GROUP_ICON
	end
	return OWN_TYPE_ICON[key] or OWN_TYPE_ICON.other
end

local COL_BTN_ON   = GetARGB(255, 255, 230, 140)
local COL_BTN_OFF  = GetARGB(255, 200, 200, 200)
local COL_DIM      = GetARGB(255, 120, 120, 120)
local COL_TITLE    = GetARGB(255, 235, 235, 235)

-- Shared by the mission cards and the tracked banner so both read the same.

-- Labelled, colour-coded detail block, in the task board's idiom: a dim label
-- then a bright value. Built as one complex_mode string because a CUITextWnd can
-- only carry one colour otherwise, and "\\n" is the control's newline marker
-- rather than a Lua escape.
local DIM     = "%c[255,150,150,150]"
local VALUE   = "%c[255,235,235,235]"
local FACTION = "%c[255,150,205,235]"
local C_TRACK = "%c[255,120,220,120]"
local C_READY = "%c[255,235,205,100]"

-- Red when you have none, yellow when partway, green once the quota is met --
-- matching how the vanilla fetch counter colours itself. Defined here rather
-- than beside its other caller because status_text below needs it, and a Lua
-- local is invisible to anything declared above it.
local function amount_colour(have, need)
	if (have <= 0) then
		return utils_xml.get_color("d_red")
	elseif (have >= need) then
		return utils_xml.get_color("pda_green")
	end
	return utils_xml.get_color("pda_yellow")
end

-- Status row for the complex_mode block. Every segment carries its own colour
-- code rather than the row taking a single one, so the item count can use the
-- same red / yellow / green scale as the expanded briefing does without
-- dragging the rest of the line along with it.
local function status_text(entry)
	local bits = {}

	if (entry.tracked) then
		bits[#bits + 1] = C_TRACK .. gts("st_am_tracked")
	end
	if (entry.items) then
		bits[#bits + 1] = amount_colour(entry.items.carried, entry.items.need)
			.. string.format("%d/%d %s",
				entry.items.carried, entry.items.need, gts("st_am_items"))
	end
	if (entry.ready) then
		bits[#bits + 1] = C_READY .. gts("st_am_ready")
	end
	if (entry.dist) then
		bits[#bits + 1] = DIM .. string.format("%d %s", entry.dist, gts("st_am_metres"))
	elseif (entry.target_id) then
		bits[#bits + 1] = DIM .. gts("st_am_offlevel")
	end

	return table.concat(bits, "   ")
end

-- Labelled, colour-coded detail block in the task board's idiom: a dim label
-- then a bright value. One complex_mode string, because a CUITextWnd carries a
-- single colour otherwise. "\\n" is the control's newline marker, not a Lua
-- escape.
local function info_block(entry)
	local rows = {}

	rows[#rows + 1] = DIM .. gts("st_am_lbl_location") .. ": " .. VALUE .. entry.level_label

	if (entry.giver_name) then
		rows[#rows + 1] = DIM .. gts("st_am_lbl_giver") .. ": " .. VALUE .. entry.giver_name
			.. FACTION .. "  " .. entry.faction_label
	else
		rows[#rows + 1] = DIM .. gts("st_am_lbl_faction") .. ": " .. FACTION .. entry.faction_label
	end

	rows[#rows + 1] = DIM .. gts("st_am_lbl_type") .. ": " .. VALUE .. entry.ttype_label

	local status = status_text(entry)
	if (status ~= "") then
		rows[#rows + 1] = status
	end

	return table.concat(rows, "\\n")
end

-- Are we living in the task board's tab? Asked on every refresh rather than once
-- at construction: this window is a singleton built the first time the tab is
-- opened, so a value read in InitControls is frozen for the rest of the session.
-- That is how the hand-off button ended up permanently hidden for anyone who
-- turned the option on after opening the tab once -- leaving no way back to the
-- board at all.
local function sharing_taskboard()
	return _G.zzz_active_missions_hook ~= nil
		and type(zzz_active_missions_hook.sharing_taskboard) == "function"
		and zzz_active_missions_hook.sharing_taskboard() or false
end

-- ---------------------------------------------------------------------------
-- Escape hatch
-- ---------------------------------------------------------------------------
-- Mod App Creator hides the PDA's tab strip when its launcher opens, and never
-- restores it -- GetTabControl():Show(false) appears exactly once in the whole
-- addon. So an app opened from the launcher is a dead end: no tabs, no button,
-- and the only way out is MAC's own keybind (Right Ctrl by default), which
-- nobody who has not read its options will guess.
--
-- Tested on the live strip rather than on "is MAC installed", so this also
-- covers anything else that hides it for its own reasons.
local function strip_hidden()
	local ok, hidden = pcall(function()
		local pda = ActorMenu.get_pda_menu()
		local tabs = pda and pda:GetTabControl()
		return tabs ~= nil and not tabs:IsShown()
	end)
	return (ok and hidden) and true or false
end

local function mac_installed()
	return _G.mac_mcm ~= nil and type(mac_mcm.add_app) == "function"
end

-- Put the PDA's tab strip back on screen while this window is open.
--
-- A Back button gets you out, but only to one place. Restoring the strip hands
-- back the whole PDA, which is what someone stuck on this screen actually wants.
--
-- Nothing undoes this on the way out, deliberately. MAC hides the strip again in
-- its own launcher's Reset(), so returning to the launcher restores its intended
-- look by itself -- while hiding it ourselves as we left would simply move the
-- dead end one tab further along, onto whatever the player picked next.
local function restore_strip()
	pcall(function()
		local pda = ActorMenu.get_pda_menu()
		local tabs = pda and pda:GetTabControl()
		if (tabs and not tabs:IsShown()) then
			tabs:Show(true)
		end
	end)
end

-- Where Back goes. In order of preference:
--
--   1. Whatever section the player was actually on before opening us. The hook
--      records it on every switch, and it is the only answer that is right by
--      construction rather than by assumption.
--   2. Interactive 3D PDA Enhanced's Network screen, if it is installed
--      alongside Mod App Creator. It absorbs MAC's app list into its own apps
--      grid (CustomPDAX:BuildAppsCategory reads mac_mcm.PDA_APPS) and launches
--      each app with SetActiveSubdialog -- so with both installed, the launcher
--      is not where anyone came from.
--   3. MAC's own launcher tab, when MAC is on its own.
--   4. The area map, which every PDA has whatever else is installed.
local function back_target()
	local hook = _G.zzz_active_missions_hook
	if (hook and type(hook.last_section) == "function") then
		local prev = hook.last_section()
		if (prev) then
			return prev
		end
	end

	if (mac_installed()) then
		if (_G.pda_inter_gui) then
			return "eptInteractive"
		end
		return "eptLauncher"
	end

	return "eptTasks"
end

local function set_icon(static, name)
	local ok = pcall(function() static:InitTexture(name) end)
	if not (ok) then
		pcall(function() static:InitTexture("ui_pda2_mtask_overlay") end)
	end
end

-- Item block appended under the briefing of a fetch task. "\\n" is the text
-- control's newline marker, not a Lua escape.
local function requirement_text(entry)
	local req = active_missions_data.item_requirement(entry)
	if not (req) then
		return ""
	end

	local plain = utils_xml.get_color("pda_white")

	return "\\n\\n"
		.. plain .. gts("st_am_needs") .. ": " .. req.name .. " (x" .. req.need .. ")"
		.. "\\n" .. plain .. gts("st_am_carried") .. ": "
		.. amount_colour(req.carried, req.need) .. req.carried
		.. "\\n" .. plain .. gts("st_am_stashed") .. ": "
		.. amount_colour(req.stashed, req.need) .. req.stashed
end

local xml = CScriptXmlInit()
xml:ParseFile("pda_active_missions.xml")

local gui = nil
function get_ui()
	gui = gui or pda_active_missions_tab()
	return gui
end

-- Forget the cached window so the next get_ui() builds a fresh one.
--
-- Needed when the tab strip is rebuilt after an option change. DestroyAll_UI()
-- only clears singletons registered in _GUIsInstances, and this one is a plain
-- local -- so without this the old window would survive the reload holding stale
-- geometry.
function drop_cache()
	gui = nil
end

-- ---------------------------------------------------------------------------
-- Mission card
-- ---------------------------------------------------------------------------

-- ---------------------------------------------------------------------------
-- Category row
-- ---------------------------------------------------------------------------
-- A plain AddTextItem row was legible but flat. This gives each group the same
-- treatment the task board gives its categories: framed row, icon, name, and the
-- count pushed to the right.

class "am_cat_row" (CUIListBoxItem)
function am_cat_row:__init(label, count, icon, selected) super(CAT_ROW_H)
	self:SetWndSize(vector2():set(CAT_ROW_W, CAT_ROW_H))
	self:GetTextItem():SetText("")

	xml:InitFrame(custom_skin() and "cat_row_bg_custom" or "cat_row_bg_stock", self)

	self.icon = xml:InitStatic("cat_row_icon", self)
	set_icon(self.icon, icon)

	self.name = xml:InitTextWnd("cat_row_name", self)
	self.name:SetText(string.format("%s   (%d)", label, count))

	-- The selected group is called out in amber, the way the board marks its
	-- open category.
	self.name:SetTextColor(selected and COL_BTN_ON or GetARGB(255, 215, 215, 215))
end

function am_cat_row:__finalize()
end

class "am_row" (CUIWindow)
function am_row:__init(owner, index) super()
	self:SetWndRect(Frect():set(0, 0, CARD_W, CARD_BASE_H))

	-- Attach order is draw order: the click strip goes down first so the text
	-- statics render on top of it. Statics don't consume mouse events, so
	-- clicks anywhere on the strip still reach the button.
	self.hit = xml:Init3tButton("card_hit", self)
	xml:InitFrame(custom_skin() and "card_frame_custom" or "card_frame_stock", self)
	self.icon = xml:InitStatic("card_icon", self)
	self.title = xml:InitTextWnd("card_title", self)
	self.info = xml:InitTextWnd("card_info", self)
	self.btn_track = xml:Init3tButton("card_btn_track", self)

	-- Box behind the briefing. Attached before the text so the text draws over
	-- it; sized in Fill once the briefing has been measured.
	self.descr_frame = xml:InitFrame(
		custom_skin() and "card_descr_frame_custom" or "card_descr_frame_stock", self)
	self.descr = xml:InitTextWnd("card_descr", self)

	local hit_name = "am_hit_" .. index
	owner:Register(self.hit, hit_name)
	owner:AddCallback(hit_name, ui_events.BUTTON_CLICKED, function()
		owner:OnCardClicked(index)
	end, owner)

	local track_name = "am_track_" .. index
	owner:Register(self.btn_track, track_name)
	owner:AddCallback(track_name, ui_events.BUTTON_CLICKED, function()
		owner:OnTrackClicked(index)
	end, owner)
end

function am_row:SetBlank()
	self:Show(false)
	self:SetWndSize(vector2():set(CARD_W, 0))
end

-- Fills the card and returns the height it wants.
function am_row:Fill(entry, expanded)
	self:Show(true)

	set_icon(self.icon, entry.icon)
	self.title:SetText(entry.title)
	self.info:SetText(info_block(entry))

	self.btn_track:Enable(not entry.tracked)

	local height = CARD_BASE_H
	if (expanded) then
		-- Item counts are only computed for the open card: they walk the whole
		-- inventory and every nearby stash, which is far too much to do for
		-- every row on a 2 second refresh.
		self.descr:Show(true)
		self.descr:SetText((entry.descr ~= "" and entry.descr or gts("st_am_no_briefing"))
			.. requirement_text(entry))
		self.descr:AdjustHeightToText()

		-- Wrap the briefing in its own box. The height is only knowable after
		-- AdjustHeightToText, so the frame is grown to fit here rather than in
		-- the layout: text height plus padding above and below.
		local text_h = self.descr:GetHeight()
		self.descr_frame:Show(true)
		self.descr_frame:SetWndSize(vector2():set(DESCR_FRAME_W, text_h + DESCR_BOX_PAD))

		height = CARD_BASE_H + text_h + CARD_DESCR_PAD
	else
		self.descr:Show(false)
		self.descr:SetText("")
		self.descr_frame:Show(false)
	end

	self:SetWndSize(vector2():set(CARD_W, height))
	return height
end

-- ---------------------------------------------------------------------------
-- Tab
-- ---------------------------------------------------------------------------

class "pda_active_missions_tab" (CUIScriptWnd)
function pda_active_missions_tab:__init() super()
	self.rows      = {}   -- pooled cards, created once and reused
	self.visible   = {}   -- row index -> entry currently shown there
	self.expanded  = {}   -- task id -> true
	self.mode      = active_missions_data.setting("default_group", "type")
	self.groups    = {}
	self.order     = {}
	self.sel_key   = nil

	self:InitControls()
end

function pda_active_missions_tab:__finalize()
	gui = nil
end

function pda_active_missions_tab:InitControls()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))

	self.frame = xml:InitFrame("frame_main", self)
	xml:InitFrame("frame_group", self.frame)
	xml:InitFrame("frame_categories", self.frame)
	xml:InitFrame("frame_tasks", self.frame)

	xml:InitTextWnd("group_caption", self.frame)
	self.summary = xml:InitTextWnd("summary_caption", self.frame)

	self.mode_buttons = {}
	self.mode_labels = {
		type    = "ui_st_am_group_type",
		region  = "ui_st_am_group_region",
		faction = "ui_st_am_group_faction",
		all     = "ui_st_am_group_all",
	}
	for _, mode in ipairs(active_missions_data.valid_modes()) do
		local btn = xml:Init3tButton("btn_group_" .. mode, self.frame)
		local name = "am_mode_" .. mode
		self:Register(btn, name)
		self:AddCallback(name, ui_events.BUTTON_CLICKED, function()
			self:SetMode(mode)
		end, self)
		self.mode_buttons[mode] = btn
	end

	xml:InitFrame("frame_tracked", self.frame)

	self.tracked_hit = xml:Init3tButton("tracked_hit", self.frame)
	self:Register(self.tracked_hit, "am_tracked_hit")
	self:AddCallback("am_tracked_hit", ui_events.BUTTON_CLICKED, self.OnTrackedClicked, self)

	xml:InitTextWnd("tracked_caption", self.frame)
	self.tracked_icon = xml:InitStatic("tracked_icon", self.frame)
	self.tracked_title = xml:InitTextWnd("tracked_title", self.frame)
	self.tracked_info = xml:InitTextWnd("tracked_info", self.frame)

	-- Only relevant when we are sharing the task board's tab; hidden otherwise so
	-- a normal setup sees no stray button.
	self.btn_taskboard = xml:Init3tButton("btn_taskboard", self.frame)
	self:Register(self.btn_taskboard, "am_go_taskboard")
	self:AddCallback("am_go_taskboard", ui_events.BUTTON_CLICKED, self.OnTaskboardClicked, self)
	self.btn_taskboard:Show(sharing_taskboard())

	-- Shown only when the tab strip is hidden and there is genuinely no other way
	-- out. Shares btn_taskboard's slot, so both conditions are checked together
	-- on every refresh -- see Reload().
	self.btn_back = xml:Init3tButton("btn_back", self.frame)
	self:Register(self.btn_back, "am_go_back")
	self:AddCallback("am_go_back", ui_events.BUTTON_CLICKED, self.OnBackClicked, self)
	self.btn_back:Show(false)

	self.category_list = xml:InitListBox("category_list", self.frame)
	self:Register(self.category_list, "am_categories")
	self:AddCallback("am_categories", ui_events.LIST_ITEM_CLICKED, self.OnCategorySelected, self)
	self:AddCallback("am_categories", ui_events.LIST_ITEM_SELECT, self.OnCategorySelected, self)

	self.task_list = xml:InitScrollView("task_list", self.frame)

	self.empty_label = xml:InitTextWnd("empty_caption", self.frame)
	self.empty_label:SetText(gts("st_am_empty"))
	self.empty_label:Show(false)

	self:PaintModeButtons()
end

-- Called by the engine every frame while the tab is on screen.
function pda_active_missions_tab:Update()
	CUIScriptWnd.Update(self)

	local tg = time_global()
	local gap = tg - (self.last_tick or 0)
	self.last_tick = tg

	-- A long gap means the tab was closed or another one was in front, so treat
	-- the next frame as a fresh open and rebuild everything.
	if (gap > 500) then
		self.next_poll = tg + 2000
		self:Reload()
		return
	end

	if (self.next_poll and tg < self.next_poll) then
		return
	end
	self.next_poll = tg + 2000
	self:Reload()
end

function pda_active_missions_tab:SetMode(mode)
	if (self.mode == mode) then
		return
	end
	self.mode = mode
	self.sel_key = nil
	self:PaintModeButtons()
	self:Reload()
end

-- The active grouping is marked the same way the selected category row is: amber
-- text, with the label bracketed so it still reads as chosen on a screenshot or
-- for anyone who cannot pick the colour out.
function pda_active_missions_tab:PaintModeButtons()
	for mode, btn in pairs(self.mode_buttons) do
		local on = (mode == self.mode)
		btn:TextControl():SetTextColor(on and COL_BTN_ON or COL_BTN_OFF)
		btn:TextControl():SetText(
			on and ("[ " .. gts(self.mode_labels[mode]) .. " ]") or gts(self.mode_labels[mode]))
	end
end

-- Re-reads the task list and redraws. Selected group, expanded cards and scroll
-- position are all preserved, so this is safe to call on a timer.
function pda_active_missions_tab:Reload()
	local entries = active_missions_data.collect()
	self.groups, self.order = active_missions_data.group(entries, self.mode)

	if not (self.sel_key and self.groups[self.sel_key]) then
		self.sel_key = self.order[1]
	end

	-- Only touch the list box when something it displays actually changed; doing
	-- it on every poll would fight the player's clicks. The selected key is part
	-- of the signature because selection is drawn into the row itself now.
	local parts = {}
	for i, key in ipairs(self.order) do
		parts[i] = string.format("%s|%d", self.groups[key].label, #self.groups[key].items)
	end
	local signature = table.concat(parts, "~") .. "~~" .. tostring(self.sel_key) .. "~" .. self.mode

	if (signature ~= self.cat_signature) then
		self.cat_signature = signature
		self.category_list:RemoveAll()
		for _, key in ipairs(self.order) do
			local g = self.groups[key]
			self.category_list:AddExistingItem(
				am_cat_row(g.label, #g.items, category_icon(key, self.mode), key == self.sel_key))
		end
	end

	-- Sync the highlight every time, not just on rebuild: the tracked-strip jump
	-- changes sel_key without changing the set of groups. Re-selecting what is
	-- already selected is a no-op, so this doesn't fight the player's clicks.
	for i, key in ipairs(self.order) do
		if (key == self.sel_key) then
			self.category_list:SetSelectedIndex(i - 1)
			break
		end
	end

	self.summary:SetText(string.format("%d %s", #entries, gts("st_am_active")))
	self.empty_label:Show(#entries == 0)

	-- These two share a slot. Sharing the board's tab means the strip is on
	-- screen and there is already a way out, so the hand-off wins and the escape
	-- hatch only appears when it is genuinely needed. Re-checked every refresh
	-- rather than at construction: this window is a singleton built once, and the
	-- strip can be hidden after it was first opened.
	local sharing = sharing_taskboard()
	self.btn_taskboard:Show(sharing)

	-- Back stays useful even with the strip restored: under a launcher we have no
	-- tab of our own, so the strip cannot take you back to where you came from.
	-- Evaluated before restore_strip(), or strip_hidden() would be answering a
	-- question the next line has already changed.
	self.btn_back:Show(not sharing and (mac_installed() or strip_hidden()))
	restore_strip()

	self:DrawTracked(entries)
	self:DrawTasks()
end

-- The tracked mission is drawn from the full entry list, not the selected
-- group, so it stays visible whichever group is being browsed.
function pda_active_missions_tab:DrawTracked(entries)
	local active
	for _, e in ipairs(entries) do
		if (e.tracked) then
			active = e
			break
		end
	end

	if not (active) then
		self.tracked_icon:Show(false)
		self.tracked_title:SetText(gts("st_am_nothing_tracked"))
		self.tracked_title:SetTextColor(COL_DIM)
		self.tracked_info:SetText("")
		return
	end

	self.tracked_icon:Show(true)
	set_icon(self.tracked_icon, active.icon)

	self.tracked_title:SetText(active.title)
	self.tracked_title:SetTextColor(COL_TITLE)

	-- Same labelled block the cards use, so the tracked mission is presented
	-- identically to the row it came from.
	self.tracked_info:SetText(info_block(active))
end

function pda_active_missions_tab:OnCategorySelected()
	local idx = self.category_list:GetSelectedIndex()
	if not (idx) or idx < 0 then
		return
	end
	local key = self.order[idx + 1]
	if not (key) or key == self.sel_key then
		return
	end
	self.sel_key = key
	self:DrawTasks()
end

function pda_active_missions_tab:GetRow(index)
	if not (self.rows[index]) then
		local row = am_row(self, index)
		self.rows[index] = row
		self.task_list:AddWindow(row, false)
	end
	return self.rows[index]
end

function pda_active_missions_tab:DrawTasks()
	local scroll = self.task_list:GetCurrentScrollPos()

	local items = self.sel_key and self.groups[self.sel_key] and self.groups[self.sel_key].items or {}

	self.visible = {}
	local offset, jump_to = 0, nil
	for i, entry in ipairs(items) do
		local row = self:GetRow(i)
		local height = row:Fill(entry, self.expanded[entry.id] and true or false)
		if (self.pending_jump == entry.id) then
			jump_to = offset
		end
		offset = offset + height
		self.visible[i] = entry
	end
	self.pending_jump = nil

	-- Pooled cards past the end collapse to zero height instead of being
	-- destroyed, so their callbacks stay registered exactly once.
	local i = #items + 1
	while (self.rows[i]) do
		self.rows[i]:SetBlank()
		i = i + 1
	end

	-- CUIScrollView only recalculates when its child list changes, so nudge it.
	-- This has to happen before touching the scroll position, or the new row
	-- heights are not in the max-scroll calculation yet.
	local nudge = CUIWindow()
	self.task_list:AddWindow(nudge, false)
	self.task_list:RemoveWindow(nudge)

	if (jump_to) then
		local ok, max = pcall(function() return self.task_list:GetMaxScrollPos() end)
		scroll = (ok and max and jump_to > max) and max or jump_to
	end
	self.task_list:SetScrollPos(scroll)
end

-- Clicking the tracked strip jumps to that mission's card: switches to whichever
-- group holds it, opens its briefing and scrolls it into view.
function pda_active_missions_tab:OnTrackedClicked()
	for _, key in ipairs(self.order) do
		for _, entry in ipairs(self.groups[key].items) do
			if (entry.tracked) then
				self.sel_key = key
				self.expanded[entry.id] = true
				self.pending_jump = entry.id
				self:Reload()
				return
			end
		end
	end
end

function pda_active_missions_tab:OnCardClicked(index)
	local entry = self.visible[index]
	if not (entry) then
		return
	end
	self.expanded[entry.id] = (not self.expanded[entry.id]) or nil
	self:DrawTasks()
end

-- Hands the shared tab over to the task board for this viewing. The hook clears
-- its flag as soon as it serves them, so re-opening the tab comes back here.
function pda_active_missions_tab:OnTaskboardClicked()
	zzz_active_missions_hook.show_taskboard_next()
	ActorMenu.get_pda_menu():SetActiveSubdialog("eptTaskboard")
end

function pda_active_missions_tab:OnBackClicked()
	pcall(function()
		ActorMenu.get_pda_menu():SetActiveSubdialog(back_target())
	end)
end

function pda_active_missions_tab:OnTrackClicked(index)
	local entry = self.visible[index]
	if not (entry and entry.gametask and db.actor) then
		return
	end
	db.actor:set_active_task(entry.gametask)
	self:Reload()
end
