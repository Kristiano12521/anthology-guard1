-- PDA Buy Info GUI Fix
-- Anomaly 1.5.3 / Anthology 2.1
--
-- Interactive PDA's buy-info (and trade) replies arrive from actor_on_update
-- after the player can already close the PDA. The original scripts then do
-- pda_inter_gui.GUI:Upd*LowerMenu(). Anthology's embedded tab lives in PDA_GUI;
-- standalone GUI stays nil. Indexing it is a fatal Lua error.
--
-- This addon does not replace pda_inter_x_buyinfo.script. It points GUI at
-- the live window for the original call, then restores the field.

local LOG_TAG = "[fix_pda_buyinfo_gui]"
local VERSION = "1.0.0"

local orig = {}
local installed = false
local callbacks_registered = false
local logged_err = {}

-- Original last line is GUI:UpdFindLowerMenu / UpdTradeLowerMenu. If both
-- windows are missing, a no-op object lets that line finish without a fatal.
local noop_gui = {
	UpdFindLowerMenu = function() end,
	UpdTradeLowerMenu = function() end,
}

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

local function log_once(key, fmt, ...)
	if logged_err[key] then
		return
	end
	logged_err[key] = true
	log(fmt, ...)
end

local function live_gui()
	if type(pda_inter_gui) ~= "table" then
		return nil
	end
	return pda_inter_gui.PDA_GUI or pda_inter_gui.GUI
end

-- Same idea as pda_inter_x_tasks.refresh_task_lower_menu: the embedded tab
-- is PDA_GUI, the old standalone window is GUI. Prefer the live one.
local function with_live_gui(slot, fn)
	if type(pda_inter_gui) ~= "table" then
		return fn()
	end

	local saved = pda_inter_gui.GUI
	if saved == nil then
		pda_inter_gui.GUI = live_gui() or noop_gui
	end

	local ok, err = pcall(fn)

	pda_inter_gui.GUI = saved

	if not ok then
		log_once(slot, "%s failed after GUI bind: %s", slot, tostring(err))
	end
	return ok
end

local function patched_add_sender()
	return with_live_gui("add_sender", orig.add_sender)
end

local function patched_add_trader()
	return with_live_gui("add_trader", orig.add_trader)
end

local function wrap(slot, owner, name, patched)
	if type(owner) ~= "table" or type(owner[name]) ~= "function" then
		return false
	end
	if owner[name] == patched then
		return true
	end
	orig[slot] = orig[slot] or owner[name]
	owner[name] = patched
	return true
end

local function install()
	if installed then
		return true
	end

	local wrapped = 0
	local missing = 0

	local function need(ok, label)
		if ok then
			wrapped = wrapped + 1
		else
			missing = missing + 1
			log("missing %s", label)
		end
	end

	if type(pda_inter_x_buyinfo) == "table" then
		need(wrap("add_sender", pda_inter_x_buyinfo, "add_sender", patched_add_sender), "pda_inter_x_buyinfo.add_sender")
	else
		missing = missing + 1
		log("pda_inter_x_buyinfo not found - Interactive PDA not loaded")
	end

	-- Same delayed GUI: call from actor_on_update. Not in the original ZIP,
	-- but it fatals the same way if the embedded tab is used without GUI.
	if type(pda_inter_x_trade) == "table" then
		need(wrap("add_trader", pda_inter_x_trade, "add_trader", patched_add_trader), "pda_inter_x_trade.add_trader")
	end

	installed = wrapped > 0
	log("loaded v%s wrapped=%s missing=%s", VERSION, tostring(wrapped), tostring(missing))
	return installed
end

local function uninstall()
	if type(pda_inter_x_buyinfo) == "table" and orig.add_sender then
		pda_inter_x_buyinfo.add_sender = orig.add_sender
	end
	if type(pda_inter_x_trade) == "table" and orig.add_trader then
		pda_inter_x_trade.add_trader = orig.add_trader
	end
	orig = {}
	installed = false
	logged_err = {}
end

function on_game_load()
	logged_err = {}
end

function actor_on_first_update()
	if not installed then
		install()
	end
end

function on_game_start()
	install()
	if not callbacks_registered then
		RegisterScriptCallback("on_game_load", on_game_load)
		RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = true
	end
end

function on_game_end()
	if callbacks_registered then
		UnregisterScriptCallback("on_game_load", on_game_load)
		UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = false
	end
	uninstall()
end
