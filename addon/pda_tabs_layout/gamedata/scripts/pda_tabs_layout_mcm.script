-- MCM for PDA Tabs Layout calibrator.

function on_mcm_load()
	local gr = {
		{id = "title", type = "slide", link = "ui_options_slider_player",
			text = "ui_mcm_pda_tabs_layout_title", size = {512, 50}, spacing = 20},

		{id = "enable", type = "check", val = 1, def = true},
		{id = "enable_desc", type = "desc", text = "ui_mcm_pda_tabs_layout_enable_desc"},

		{id = "line_geom", type = "line"},
		{id = "geom_head", type = "desc", text = "ui_mcm_pda_tabs_layout_geom_head"},

		{id = "gap", type = "track", val = 2, min = 0, max = 20, step = 1, def = 4},
		{id = "page_size", type = "track", val = 2, min = 3, max = 12, step = 1, def = 7},
		{id = "arrow_w", type = "track", val = 2, min = 24, max = 48, step = 1, def = 36},
		{id = "tab_w_min", type = "track", val = 2, min = 40, max = 80, step = 1, def = 56},
		{id = "tab_w_max", type = "track", val = 2, min = 60, max = 120, step = 1, def = 84},

		{id = "line_strip", type = "line"},
		{id = "strip_head", type = "desc", text = "ui_mcm_pda_tabs_layout_strip_head"},

		{id = "strip_x", type = "track", val = 2, min = 80, max = 200, step = 1, def = 132},
		{id = "strip_y", type = "track", val = 2, min = 0, max = 60, step = 1, def = 23},
		{id = "strip_w", type = "track", val = 2, min = 400, max = 700, step = 5, def = 570},

		{id = "line_dump", type = "line"},
		{id = "dump_head", type = "desc", text = "ui_mcm_pda_tabs_layout_dump_head"},
		{id = "dump_key", type = "key_bind", val = 2, def = -1},
		{id = "dump_mod", type = ui_mcm.kb_mod_radio, val = 2, def = 0, hint = "mcm_kb_modifier",
			content = {{0, "mcm_kb_mod_none"}, {1, "mcm_kb_mod_shift"}, {2, "mcm_kb_mod_ctrl"}, {3, "mcm_kb_mod_alt"}}},
	}

	return {
		id = "pda_tabs_layout",
		sh = true,
		gr = gr,
	}
end
