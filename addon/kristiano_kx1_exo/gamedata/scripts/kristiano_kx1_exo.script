-- load-order: after aa_load_recipes_Banjaji_CSI, fix_milspec_exo_craft, item_exo_device, exo_servo_sounds, item_parts
-- Kristiano KX-1: endgame exo craft, fabric scraps, flash decrypt, default recharge PSU.

local LOG_TAG = "[kristiano_kx1_exo]"
local VERSION = "1.5.1-b"

printf("%s loaded v%s", LOG_TAG, VERSION)

local KX1_SECTION = "kristiano_kx1_exo_outfit"
local KX1_FRAME = "kristiano_kx1_frame"
local FLASH_ENC = "kristiano_kx1_flash_encrypted"
local RECIPE_NOTE = "recipe_kristiano_kx1"
local LORE_ARTICLE = "encyclopedia_items_kristiano_kx1"
local SMS_FIRST = "st_kristiano_kx1_sms_first_equip"
local DEFAULT_PSU = "exo_power_supply_proto"
local EXO_TAB_TITLE = "st_exo_system_craftingtitle"
local PARTS_TAB_TITLE = "st_OutfitPartsOverhaul_crafting_title"
local DECRYPT_COST = 75000
local EVENT_ID = "kristiano_kx1_exo"
local FULL_CHARGE_RAD_SCRUB = -0.0008
local FULL_CHARGE_EPS = 0.5

-- B5: Exo System servo has no per-suit preset (class = floor(inv_weight/10) only).
-- Light wrap while KX-1 is worn: quieter + lower step pitch. Not a fork of exo_servo_sounds.
local SERVO_VOL_MUL = 0.55
local SERVO_STEP_POWER_MUL = 0.72
local SERVO_LAND_MUL = 0.70

local orig_is_exobackpack = nil
local orig_load = nil
local orig_servo_get_power = nil
local orig_servo_footstep = nil
local orig_servo_land = nil
local orig_disassembly_outfit = nil
local installed = false
local servo_wrapped = false
local legend_flash_given = false
local first_sms_sent = false
local flash_stash_given = false
local psu_pending = {}
local full_charge_next_t = 0
local stash_try_next_t = 0

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

local function is_kx1(obj)
	return obj ~= nil and obj:section() == KX1_SECTION
end

local function wearing_kx1()
	if not (db and db.actor) then
		return false
	end
	return is_kx1(db.actor:item_in_slot(7))
end

local function send_tip(string_id, delay)
	if not (db and db.actor and news_manager and type(news_manager.send_tip) == "function") then
		return
	end
	news_manager.send_tip(db.actor, game.translate_string(string_id), nil, "nano", delay or 5000)
end

local function wrap_servo_sounds()
	if servo_wrapped then
		return
	end
	if not exo_servo_sounds then
		log("WARN: exo_servo_sounds missing - KX-1 servo preset skipped")
		return
	end
	if type(UnregisterScriptCallback) ~= "function" then
		log("WARN: UnregisterScriptCallback missing - KX-1 servo preset skipped")
		return
	end

	orig_servo_get_power = exo_servo_sounds.get_power
	if type(orig_servo_get_power) == "function" then
		exo_servo_sounds.get_power = function()
			local p = orig_servo_get_power()
			if wearing_kx1() then
				return p * SERVO_VOL_MUL
			end
			return p
		end
	end

	orig_servo_footstep = exo_servo_sounds.actor_on_footstep
	if type(orig_servo_footstep) == "function" then
		UnregisterScriptCallback("actor_on_footstep", orig_servo_footstep)
		exo_servo_sounds.actor_on_footstep = function(material, power, hud_view, flags)
			if wearing_kx1() and power then
				power = power * SERVO_STEP_POWER_MUL
			end
			return orig_servo_footstep(material, power, hud_view, flags)
		end
		RegisterScriptCallback("actor_on_footstep", exo_servo_sounds.actor_on_footstep)
	end

	orig_servo_land = exo_servo_sounds.actor_on_land
	if type(orig_servo_land) == "function" then
		UnregisterScriptCallback("actor_on_land", orig_servo_land)
		exo_servo_sounds.actor_on_land = function(landing_speed)
			if wearing_kx1() and landing_speed then
				landing_speed = landing_speed * SERVO_LAND_MUL
			end
			return orig_servo_land(landing_speed)
		end
		RegisterScriptCallback("actor_on_land", exo_servo_sounds.actor_on_land)
	end

	servo_wrapped = true
	log("KX-1 servo preset wrapped (quieter / lower pitch)")
end

local function unwrap_servo_sounds()
	if not servo_wrapped or not exo_servo_sounds then
		return
	end
	if type(orig_servo_get_power) == "function" then
		exo_servo_sounds.get_power = orig_servo_get_power
	end
	if type(orig_servo_footstep) == "function" then
		UnregisterScriptCallback("actor_on_footstep", exo_servo_sounds.actor_on_footstep)
		exo_servo_sounds.actor_on_footstep = orig_servo_footstep
		RegisterScriptCallback("actor_on_footstep", orig_servo_footstep)
	end
	if type(orig_servo_land) == "function" then
		UnregisterScriptCallback("actor_on_land", exo_servo_sounds.actor_on_land)
		exo_servo_sounds.actor_on_land = orig_servo_land
		RegisterScriptCallback("actor_on_land", orig_servo_land)
	end
	orig_servo_get_power = nil
	orig_servo_footstep = nil
	orig_servo_land = nil
	servo_wrapped = false
end

local function unlock_kx1_lore_article()
	if not (ui_pda_encyclopedia_tab and type(ui_pda_encyclopedia_tab.unlock_article) == "function") then
		return
	end
	if ui_pda_encyclopedia_tab.is_unlocked_article and ui_pda_encyclopedia_tab.is_unlocked_article(LORE_ARTICLE) then
		return
	end
	ui_pda_encyclopedia_tab.unlock_article(LORE_ARTICLE)
	log("lore article unlocked: %s", LORE_ARTICLE)
end

local function send_first_kx1_sms()
	if first_sms_sent or not db.actor then
		return
	end
	local text = game.translate_string(SMS_FIRST)
	if type(dynamic_news_helper) == "table" and type(dynamic_news_helper.send_tip) == "function" then
		-- Own tip icon (news_tips_icons.kristiano_kx1); not welcome's "kristiano"
		dynamic_news_helper.send_tip(SMS_FIRST, nil, 60, 30, "kristiano_kx1", "kx1", "gr")
	elseif news_manager and type(news_manager.send_tip) == "function" then
		news_manager.send_tip(db.actor, text, nil, "kristiano_kx1", 8000)
	else
		log("WARN: no tip API for first KX-1 SMS")
		return
	end
	first_sms_sent = true
	unlock_kx1_lore_article()
	log("first KX-1 SMS sent")
end

function menu_no_patch(obj)
	return false
end

function action_no_patch(obj)
end

function menu_decrypt_flash(obj)
	local parent = obj and obj:parent()
	if not (parent and db.actor and parent:id() == db.actor:id()) then
		return false
	end
	local tip = game.translate_string("st_kristiano_kx1_decrypt_menu")
	return string.format("%s (%s)", tip, tostring(DECRYPT_COST))
end

function action_decrypt_flash(obj)
	if not (obj and db.actor) then
		return
	end
	local money = db.actor:money()
	if not money or money < DECRYPT_COST then
		send_tip("st_kristiano_kx1_decrypt_nomoney", 4000)
		return
	end
	db.actor:give_money(-DECRYPT_COST)
	alife_create_item(RECIPE_NOTE, db.actor)
	alife_release_id(obj:id())
	-- Unlock craft knowledge immediately (encyclopedia note for CSI).
	if ui_pda_encyclopedia_tab and type(ui_pda_encyclopedia_tab.unlock_note) == "function" then
		ui_pda_encyclopedia_tab.unlock_note("encyclopedia__notes_" .. RECIPE_NOTE)
	end
	unlock_kx1_lore_article()
	SendScriptCallback("actor_on_interaction", "notes", nil, RECIPE_NOTE)
	send_tip("st_kristiano_kx1_decrypt_ok", 5000)
	log("flash decrypted for %s", tostring(DECRYPT_COST))
end

local function tab_index_by_title(tabs, title)
	if not tabs then
		return nil
	end
	for i, tab_title in pairs(tabs) do
		if tab_title == title then
			return i
		end
	end
	return nil
end

local function has_identificator(list, identificator)
	if not list then
		return false
	end
	for i = 1, #list do
		local recipe = list[i]
		if recipe and recipe.identificator == identificator then
			return true
		end
	end
	return false
end

local function append_recipe(list, recipe)
	if has_identificator(list, recipe.identificator) then
		return false
	end
	list[#list + 1] = recipe
	return true
end

local function kx1_frame_recipe()
	-- B8 step 1: Nosorog + wiring/fabrics -> non-wearable chassis
	return {
		identificator = KX1_FRAME,
		results = {[KX1_FRAME] = 1},
		notes = {[RECIPE_NOTE] = 1},
		tools = {["itm_expertkit"] = 1},
		components = {
			["merc_nosorog_outfit"] = 1,
			["prt_i_capacitors"] = 40,
			["prt_i_transistors"] = 40,
			["prt_i_resistors"] = 40,
			["prt_i_textolite"] = 15,
			["prt_i_copper"] = 20,
			["prt_i_scrap"] = 25,
			["prt_i_fasteners"] = 20,
			["prt_i_ceramic"] = 10,
			["prt_i_rubber"] = 8,
			["prt_o_basic_retardant"] = 15,
			["prt_o_basic_ballistic"] = 15,
			["heavy_sewing_thread"] = 3,
		},
	}
end

local function kx1_recipe()
	-- B8 step 2: chassis + PSUs + arts + IAM modules -> finished KX-1
	return {
		identificator = KX1_SECTION,
		results = {[KX1_SECTION] = 1},
		notes = {[RECIPE_NOTE] = 1},
		tools = {["itm_expertkit"] = 1},
		components = {
			[KX1_FRAME] = 1,
			["exo_power_supply_tank"] = 1,
			["exo_power_supply_sprint"] = 1,
			-- af_aam = прикладной модуль (7 = artefact_count); af_aac контейнер не нужен
			["af_aam"] = 7,
			["prt_i_capacitors"] = 40,
			["prt_i_transistors"] = 40,
			["prt_i_resistors"] = 40,
			["prt_i_textolite"] = 10,
			["prt_i_copper"] = 20,
			["prt_i_scrap"] = 25,
			["prt_i_fasteners"] = 20,
			["prt_i_ceramic"] = 10,
			["prt_i_rubber"] = 7,
			["prt_o_basic_retardant"] = 15,
			["prt_o_basic_ballistic"] = 15,
			["heavy_sewing_thread"] = 2,
			["af_dummy_pellicle"] = 1,
			["af_electra_flash"] = 1,
			["af_gold_fish"] = 2,
			["af_fuzz_kolobok"] = 1,
			["af_fireball"] = 1,
			["af_surge_up"] = 1,
			["af_cooler"] = 1,
			["af_dummy_battery_af_aam"] = 1,
			["af_full_empty_af_aam"] = 1,
		},
	}
end

local function retardant_recipe()
	return {
		identificator = "prt_o_basic_retardant",
		results = {["prt_o_basic_retardant"] = 5},
		notes = {["recipe_advanced_1"] = 1},
		tools = {["itm_advancedkit"] = 1},
		components = {
			["prt_o_fabrics_2"] = 3,
			["glue_a"] = 1,
			["solvent"] = 1,
			["sewing_thread"] = 1,
		},
	}
end

local function inject_recipes()
	local csi = aa_load_recipes_Banjaji_CSI
	local recipes = csi and csi.all_recipes
	local tabs = csi and csi.all_recipe_tabs
	if not (recipes and tabs) then
		log("ABORT: all_recipes/all_recipe_tabs missing after LoadRecipesLTX")
		return
	end

	local added = 0

	local exo_tab = tab_index_by_title(tabs, EXO_TAB_TITLE)
	if not exo_tab then
		exo_tab = #tabs + 1
		tabs[exo_tab] = EXO_TAB_TITLE
	end
	recipes[exo_tab] = recipes[exo_tab] or {}
	if append_recipe(recipes[exo_tab], kx1_frame_recipe()) then
		added = added + 1
	end
	if append_recipe(recipes[exo_tab], kx1_recipe()) then
		added = added + 1
	end

	local parts_tab = tab_index_by_title(tabs, PARTS_TAB_TITLE)
	if parts_tab then
		recipes[parts_tab] = recipes[parts_tab] or {}
		if append_recipe(recipes[parts_tab], retardant_recipe()) then
			added = added + 1
		end
	else
		log("WARN: Outfit Parts tab %s not found", PARTS_TAB_TITLE)
	end

	log("injected %s new recipes", tostring(added))
end

local function wrapped_LoadRecipesLTX(...)
	local result = orig_load(...)
	inject_recipes()
	return result
end

local function wrapped_is_exobackpack(obj)
	if is_kx1(obj) then
		return true
	end
	if orig_is_exobackpack then
		return orig_is_exobackpack(obj)
	end
	return false
end

-- B7: guaranteed rare salvage on top of con_parts_list rolls
local function wrapped_disassembly_outfit(obj, obj_d)
	local was_kx = is_kx1(obj)
	local result = orig_disassembly_outfit(obj, obj_d)
	if was_kx and db.actor then
		alife_create_item("exo_power_supply", db.actor)
		alife_create_item("prt_i_textolite", db.actor)
		alife_create_item("prt_i_textolite", db.actor)
		alife_create_item("prt_i_capacitors", db.actor)
		send_tip("st_kristiano_kx1_disassemble_bonus", 5000)
		log("legendary disassemble bonus granted")
	end
	return result
end

-- B3: one-shot stash with encrypted flash (no all.spawn).
-- Uses get/set_random_stash so we only mark success when a box was found.
local function try_place_flash_stash()
	if flash_stash_given or not db.actor then
		return
	end
	if db.actor:object(FLASH_ENC) or db.actor:object(RECIPE_NOTE) or db.actor:object(KX1_SECTION) then
		flash_stash_given = true
		return
	end
	if not (treasure_manager
		and type(treasure_manager.get_random_stash) == "function"
		and type(treasure_manager.set_random_stash) == "function") then
		log("WARN: treasure_manager stash API missing - flash stash skipped")
		flash_stash_given = true
		return
	end
	local hint = game.translate_string("st_kristiano_kx1_stash_hint")
	local id, name, desc, stash_hint = treasure_manager.get_random_stash(nil, hint, true)
	if not id then
		-- No suitable box yet (level/caches not ready) — retry later, do not burn the flag.
		log("flash stash: no suitable box yet, will retry")
		return
	end
	local str = name or hint
	if desc and stash_hint then
		str = "%c[255,255,160,0]" .. name .. "\\n%c[default]" .. desc .. "\\n%c[160,100,100,200]" .. (stash_hint or "")
	end
	treasure_manager.set_random_stash(nil, str, {FLASH_ENC}, id)
	flash_stash_given = true
	send_tip("st_kristiano_kx1_stash_tip", 7000)
	log("placed random stash with encrypted flash id=%s", tostring(id))
end

-- Full-charge PSU buff: mild radiation scrub while KX-1 power is at max
local function on_full_charge_update()
	if not wearing_kx1() or not item_exo_device or type(item_exo_device.get_data) ~= "function" then
		return
	end
	local outfit = db.actor:item_in_slot(7)
	if not outfit then
		return
	end
	local data = item_exo_device.get_data(outfit:id())
	if not (data and data.power and data.supply and data.supply.max) then
		return
	end
	if data.power + FULL_CHARGE_EPS < data.supply.max then
		return
	end
	db.actor:change_radiation(FULL_CHARGE_RAD_SCRUB)
end

-- Throttle all per-tick work; actor_on_update fires every frame.
local function on_actor_update()
	local now = time_global()
	if now < full_charge_next_t then
		return
	end
	full_charge_next_t = now + 1000
	on_full_charge_update()
	if (not flash_stash_given) and now >= stash_try_next_t then
		stash_try_next_t = now + 15000
		try_place_flash_stash()
	end
end

local function enforce_backpack_lock()
	if not (db and db.actor) then
		return
	end
	local outfit = db.actor:item_in_slot(7)
	if not is_kx1(outfit) then
		return
	end
	local backpack = db.actor:item_in_slot(13)
	if backpack then
		db.actor:move_to_ruck(backpack)
	end
end

local function try_install_default_psu(suit_id, psu_id)
	if not (item_exo_device and type(item_exo_device.install_psu) == "function") then
		return true
	end
	local suit = level.object_by_id(suit_id)
	local psu = level.object_by_id(psu_id)
	if not (suit and psu and is_kx1(suit)) then
		return false
	end
	local data = item_exo_device.get_data(suit_id)
	if data and data.supply then
		alife_release_id(psu_id)
		return true
	end
	data = data or {power = 0}
	item_exo_device.install_psu(suit, data, psu)
	log("default recharge PSU installed on KX-1 id %s", tostring(suit_id))
	return true
end

function psu_install_tick()
	local left = false
	for suit_id, psu_id in pairs(psu_pending) do
		if try_install_default_psu(suit_id, psu_id) then
			psu_pending[suit_id] = nil
		else
			left = true
		end
	end
	if left then
		ResetTimeEvent(EVENT_ID, "psu_tick", 0.1)
		return false
	end
	return true
end

local function schedule_default_psu(suit)
	if not (suit and item_exo_device) then
		return
	end
	local suit_id = suit:id()
	local data = item_exo_device.get_data(suit_id)
	if data and data.supply then
		return
	end
	if psu_pending[suit_id] then
		return
	end
	local se = alife_create_item(DEFAULT_PSU, db.actor)
	if not se then
		log("WARN: failed to spawn default PSU")
		return
	end
	psu_pending[suit_id] = se.id
	CreateTimeEvent(EVENT_ID, "psu_tick", 0, psu_install_tick)
end

local function on_kx1_to_slot(obj)
	if is_kx1(obj) then
		schedule_default_psu(obj)
		send_first_kx1_sms()
	end
	enforce_backpack_lock()
end

local function on_kx1_item_take(obj)
	if is_kx1(obj) then
		send_first_kx1_sms()
	end
end

local function actor_has_section(sec)
	if not db.actor then
		return false
	end
	return db.actor:object(sec) ~= nil
end

local function try_give_legend_flash()
	if legend_flash_given or not db.actor then
		return
	end
	if not (ranks and ranks.get_obj_rank_name) then
		return
	end
	local rank = ranks.get_obj_rank_name(db.actor)
	if rank ~= "legend" then
		return
	end
	if actor_has_section(FLASH_ENC) or actor_has_section(RECIPE_NOTE) then
		legend_flash_given = true
		return
	end
	alife_create_item(FLASH_ENC, db.actor)
	legend_flash_given = true
	send_tip("st_kristiano_kx1_legend_flash", 6000)
	log("legend rank: encrypted flash granted")
end

local function ensure_recipe_known()
	if not (ui_pda_encyclopedia_tab and type(ui_pda_encyclopedia_tab.unlock_note) == "function") then
		return
	end
	local note_id = "encyclopedia__notes_" .. RECIPE_NOTE
	if ui_pda_encyclopedia_tab.is_unlocked_note and ui_pda_encyclopedia_tab.is_unlocked_note(note_id) then
		return
	end
	-- Already holding the blueprint item (old save / decrypt before encyclopedia patch).
	if db.actor and db.actor:object(RECIPE_NOTE) then
		ui_pda_encyclopedia_tab.unlock_note(note_id)
		unlock_kx1_lore_article()
		SendScriptCallback("actor_on_interaction", "notes", nil, RECIPE_NOTE)
		log("ensured encyclopedia unlock for existing blueprint")
	end
end

local function legend_check()
	ensure_recipe_known()
	try_give_legend_flash()
	if not legend_flash_given then
		CreateTimeEvent(EVENT_ID, "legend_poll", 30.0, legend_poll)
	end
end

function legend_poll()
	try_give_legend_flash()
	if legend_flash_given then
		return true
	end
	ResetTimeEvent(EVENT_ID, "legend_poll", 30.0)
	return false
end

local function save_state(data)
	data.kristiano_kx1_exo = {
		version = 4,
		legend_flash_given = legend_flash_given and true or false,
		first_sms_sent = first_sms_sent and true or false,
		flash_stash_given = flash_stash_given and true or false,
	}
end

local function load_state(data)
	local saved = data.kristiano_kx1_exo or {}
	legend_flash_given = saved.legend_flash_given and true or false
	first_sms_sent = saved.first_sms_sent and true or false
	flash_stash_given = saved.flash_stash_given and true or false
end

local function uninstall()
	local csi = aa_load_recipes_Banjaji_CSI
	if installed and csi and orig_load and csi.LoadRecipesLTX == wrapped_LoadRecipesLTX then
		csi.LoadRecipesLTX = orig_load
	end
	if installed and item_exo_device and orig_is_exobackpack and item_exo_device.is_exobackpack == wrapped_is_exobackpack then
		item_exo_device.is_exobackpack = orig_is_exobackpack
	end
	if installed and item_parts and orig_disassembly_outfit and item_parts.disassembly_outfit == wrapped_disassembly_outfit then
		item_parts.disassembly_outfit = orig_disassembly_outfit
	end
	orig_load = nil
	orig_is_exobackpack = nil
	orig_disassembly_outfit = nil
	installed = false
	psu_pending = {}
end

local function install()
	if installed then
		return
	end

	if not aa_load_recipes_Banjaji_CSI then
		log("ABORT: aa_load_recipes_Banjaji_CSI not found - guard NOT installed")
		return
	end
	if type(aa_load_recipes_Banjaji_CSI.LoadRecipesLTX) ~= "function" then
		log("ABORT: LoadRecipesLTX not found - guard NOT installed")
		return
	end

	orig_load = aa_load_recipes_Banjaji_CSI.LoadRecipesLTX
	aa_load_recipes_Banjaji_CSI.LoadRecipesLTX = wrapped_LoadRecipesLTX

	if item_exo_device and type(item_exo_device.is_exobackpack) == "function" then
		orig_is_exobackpack = item_exo_device.is_exobackpack
		item_exo_device.is_exobackpack = wrapped_is_exobackpack
	else
		log("WARN: item_exo_device.is_exobackpack missing - PSU UI may ignore KX-1")
	end

	if item_parts and type(item_parts.disassembly_outfit) == "function" then
		orig_disassembly_outfit = item_parts.disassembly_outfit
		item_parts.disassembly_outfit = wrapped_disassembly_outfit
	else
		log("WARN: item_parts.disassembly_outfit missing - legendary salvage skipped")
	end

	installed = true
	log("hooks installed v%s", VERSION)

	if aa_load_recipes_Banjaji_CSI.all_recipes and aa_load_recipes_Banjaji_CSI.all_recipe_tabs then
		inject_recipes()
	end
end

function on_game_start()
	install()
	wrap_servo_sounds()
	RegisterScriptCallback("actor_on_first_update", enforce_backpack_lock)
	RegisterScriptCallback("actor_on_first_update", legend_check)
	RegisterScriptCallback("actor_on_first_update", wrap_servo_sounds)
	RegisterScriptCallback("actor_on_update", on_actor_update)
	RegisterScriptCallback("actor_item_to_slot", on_kx1_to_slot)
	RegisterScriptCallback("actor_item_to_ruck", enforce_backpack_lock)
	RegisterScriptCallback("actor_on_item_drop", enforce_backpack_lock)
	RegisterScriptCallback("actor_on_item_take", on_kx1_item_take)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
end

function on_game_end()
	UnregisterScriptCallback("actor_on_first_update", enforce_backpack_lock)
	UnregisterScriptCallback("actor_on_first_update", legend_check)
	UnregisterScriptCallback("actor_on_first_update", wrap_servo_sounds)
	UnregisterScriptCallback("actor_on_update", on_actor_update)
	UnregisterScriptCallback("actor_item_to_slot", on_kx1_to_slot)
	UnregisterScriptCallback("actor_item_to_ruck", enforce_backpack_lock)
	UnregisterScriptCallback("actor_on_item_drop", enforce_backpack_lock)
	UnregisterScriptCallback("actor_on_item_take", on_kx1_item_take)
	UnregisterScriptCallback("save_state", save_state)
	UnregisterScriptCallback("load_state", load_state)
	unwrap_servo_sounds()
	uninstall()
end
