-- BHS FDDA Loot Window Fix
-- Anomaly 1.5.3 / Anthology 2.1
--
-- BHS zzzzzz_anthology_bhs_fdda_patch captures ui_inventory.start AFTER
-- FDDA wrapped it. The idle action then calls that start, FDDA re-enters
-- start_body_search, sees tag body_search and returns without opening UI.
-- Vendor FDDA instead calls its private baseUIS (vanilla start).
--
-- Wrap start_body_search in on_game_start (after BHS file-load patch).
-- Anomaly keeps the function on the script module table, not always on _G
-- (same pattern as utils_obj.find_close_cover). Re-entry during an active
-- search is a no-op (vendor). Opening loot here raced npc_on_use and made
-- Esc reopen the window. Idle in BHS 0.6.4 opens via LMode_Init.

local LOG_TAG = "[fix_bhs_fdda_loot]"
local VERSION = "1.0.3"
local orig_start_body_search = nil

printf("%s loaded v%s", LOG_TAG, VERSION)
local patched_module = nil

local function resolve_start_body_search()
	if type(liz_fdda_redone_body_search) == "table"
		and type(liz_fdda_redone_body_search.start_body_search) == "function" then
		return liz_fdda_redone_body_search, liz_fdda_redone_body_search.start_body_search
	end
	if type(start_body_search) == "function" then
		return nil, start_body_search
	end
	return nil, nil
end

local function patched_start_body_search(obj, show_ui)
	if lam2 and lam2.get_action_with_tag and lam2.get_action_with_tag("body_search") then
		return
	end
	return orig_start_body_search(obj, show_ui)
end

function on_game_start()
	if orig_start_body_search then
		return
	end
	local module, fn = resolve_start_body_search()
	if type(fn) ~= "function" then
		printf("%s start_body_search not found - guard NOT installed", LOG_TAG)
		return
	end
	orig_start_body_search = fn
	patched_module = module
	if module then
		module.start_body_search = patched_start_body_search
		printf(LOG_TAG .. " start_body_search wrapped (module liz_fdda_redone_body_search)")
	else
		start_body_search = patched_start_body_search
		printf(LOG_TAG .. " start_body_search wrapped (global)")
	end
end

function on_game_end()
	if orig_start_body_search then
		if patched_module then
			patched_module.start_body_search = orig_start_body_search
		else
			start_body_search = orig_start_body_search
		end
		orig_start_body_search = nil
		patched_module = nil
	end
end
