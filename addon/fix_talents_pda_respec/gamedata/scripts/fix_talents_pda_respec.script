-- Talents PDA Respec Fix
-- Anomaly 1.5.3 / Anthology 2.1
--
-- Classes & Talents PDA tab shifts the whole background to (28, 34) so it
-- clears PDA chrome. The respec button sits at the bottom of the right
-- panel and is clipped. Compact PDA (Milspec / Tactical 1440p) also has no
-- opaque modal behind the confirm box, so tree levels, bars and stats show
-- through the Yes/No prompt.
--
-- ZIP v1.0.1 replaced talents_gui.script. That hides talent-tree artwork
-- even in the standalone window, rewrites tooltips, and fights any other
-- patch of the same file. This addon keeps the original file and wraps
-- TalentsMenu methods for the PDA tab only.

local LOG_TAG = "[fix_talents_pda_respec]"
local VERSION = "1.0.0"
local FITTED_FLAG = "_fix_talents_pda_respec_fitted"
local MARGIN = 4

local orig = {}
local installed = false
local callbacks_registered = false

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

local function module_of()
	if type(talents_gui) == "table" then
		return talents_gui
	end
	return nil
end

local function set_shown(elem, visible)
	if not elem then
		return
	end
	pcall(function()
		elem:Show(visible)
	end)
end

local function overlay_active(self)
	if not (self and self.is_pda_tab and self.respec_cont) then
		return false
	end
	local ok, shown = pcall(function()
		return self.respec_cont:IsShown()
	end)
	return ok and shown == true
end

-- The confirm box has no opaque backdrop in the compact PDA tab. Hide the
-- right-panel widgets that sit under it; restore them when it closes.
local function set_overlay(self, active)
	if not (self and self.is_pda_tab) then
		return
	end

	active = active == true

	if type(self.tree_conts) == "table" then
		for _, cont in pairs(self.tree_conts) do
			set_shown(cont, not active)
		end
	end

	if self.stat_conts then
		set_shown(self.stat_conts.main, not active)
	end

	set_shown(self.respec_btn, not active)
	set_shown(self.talents_tooltip_cont, false)
	set_shown(self.respec_cont, active)
end

-- bg is moved down by InitControls; children move with it and the bottom
-- of the right panel is clipped by the tab. Shift the button up by the
-- overflow only, and skip if a previous wrap already compensated.
local function fit_respec_btn(self)
	if not (self and self.is_pda_tab and self.respec_btn and self.bg) then
		return false
	end
	if self[FITTED_FLAG] then
		return true
	end

	local ok, overflow = pcall(function()
		local btn = self.respec_btn
		local pos = btn:GetWndPos()
		local parent = self.talents_descr_cont
		if not (pos and parent) then
			return 0
		end

		local bg_y = self.bg:GetWndPos().y
		if type(bg_y) ~= "number" or bg_y <= 0 then
			return 0
		end

		local btn_h = btn:GetHeight()
		local parent_h = parent:GetHeight()
		local bottom = pos.y + btn_h
		local extra = (bottom + bg_y) - parent_h
		if extra <= MARGIN then
			return 0
		end

		local new_y = pos.y - extra
		if new_y < MARGIN then
			new_y = MARGIN
		end
		btn:SetWndPos(vector2():set(pos.x, new_y))
		return extra
	end)

	self[FITTED_FLAG] = true
	if ok and type(overflow) == "number" and overflow > MARGIN then
		log("respec button shifted up by %.0f in PDA tab", overflow)
		return true
	end
	return ok and true or false
end

local function patched_BuildTalentsMenu(self, xml)
	orig.BuildTalentsMenu(self, xml)
	fit_respec_btn(self)
end

local function patched_RefreshForOpen(self)
	orig.RefreshForOpen(self)
	if self.is_pda_tab then
		fit_respec_btn(self)
		set_overlay(self, false)
	end
end

local function patched_OnClickRespec(self)
	orig.OnClickRespec(self)
	if self.is_pda_tab then
		set_overlay(self, true)
	end
end

local function patched_OnClickRespecNo(self)
	orig.OnClickRespecNo(self)
	if self.is_pda_tab then
		set_overlay(self, false)
	end
end

local function patched_OnClickRespecYes(self)
	orig.OnClickRespecYes(self)
	if self.is_pda_tab then
		set_overlay(self, false)
	end
end

local function patched_UpdateTalentsMenu(self)
	orig.UpdateTalentsMenu(self)
	if overlay_active(self) then
		set_overlay(self, true)
	end
end

local function patched_Update(self)
	orig.Update(self)
	if overlay_active(self) then
		set_shown(self.talents_tooltip_cont, false)
	end
end

local function wrap(slot, owner, name, patched)
	if owner == nil or type(patched) ~= "function" then
		return false
	end

	local ok_get, current = pcall(function()
		return owner[name]
	end)
	if not ok_get or type(current) ~= "function" then
		return false
	end
	if current == patched then
		return true
	end

	orig[slot] = orig[slot] or current

	local ok_set = pcall(function()
		owner[name] = patched
	end)
	if not ok_set then
		orig[slot] = nil
		return false
	end
	return true
end

local function restore(slot, owner, name)
	if owner == nil or not orig[slot] then
		return
	end
	pcall(function()
		if owner[name] then
			owner[name] = orig[slot]
		end
	end)
end

local function install()
	if installed then
		return true
	end

	local gui = module_of()
	if not gui then
		log("talents_gui not found - Classes & Talents not loaded")
		return false
	end

	local cls = gui.TalentsMenu
	if cls == nil then
		log("talents_gui.TalentsMenu not found")
		return false
	end

	local wrapped = 0
	local missing = 0

	local function need(ok, label)
		if ok then
			wrapped = wrapped + 1
		else
			missing = missing + 1
			log("missing %s", label)
		end
	end

	need(wrap("BuildTalentsMenu", cls, "BuildTalentsMenu", patched_BuildTalentsMenu), "TalentsMenu.BuildTalentsMenu")
	need(wrap("OnClickRespec", cls, "OnClickRespec", patched_OnClickRespec), "TalentsMenu.OnClickRespec")
	need(wrap("OnClickRespecNo", cls, "OnClickRespecNo", patched_OnClickRespecNo), "TalentsMenu.OnClickRespecNo")
	need(wrap("OnClickRespecYes", cls, "OnClickRespecYes", patched_OnClickRespecYes), "TalentsMenu.OnClickRespecYes")
	need(wrap("UpdateTalentsMenu", cls, "UpdateTalentsMenu", patched_UpdateTalentsMenu), "TalentsMenu.UpdateTalentsMenu")
	need(wrap("Update", cls, "Update", patched_Update), "TalentsMenu.Update")

	-- PDA-only helper; older standalone C&T builds may not have it.
	if wrap("RefreshForOpen", cls, "RefreshForOpen", patched_RefreshForOpen) then
		wrapped = wrapped + 1
	end

	installed = wrapped > 0
	if installed and gui.PDA_GUI then
		fit_respec_btn(gui.PDA_GUI)
	end
	log("loaded v%s wrapped=%s missing=%s", VERSION, tostring(wrapped), tostring(missing))
	return installed
end

local function uninstall()
	local gui = module_of()
	local cls = gui and gui.TalentsMenu
	if cls ~= nil then
		restore("BuildTalentsMenu", cls, "BuildTalentsMenu")
		restore("RefreshForOpen", cls, "RefreshForOpen")
		restore("OnClickRespec", cls, "OnClickRespec")
		restore("OnClickRespecNo", cls, "OnClickRespecNo")
		restore("OnClickRespecYes", cls, "OnClickRespecYes")
		restore("UpdateTalentsMenu", cls, "UpdateTalentsMenu")
		restore("Update", cls, "Update")
	end
	orig = {}
	installed = false
end

function actor_on_first_update()
	if not installed then
		install()
	end
end

function on_game_start()
	install()
	if not callbacks_registered then
		RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = true
	end
end

function on_game_end()
	if callbacks_registered then
		UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = false
	end
	uninstall()
end
