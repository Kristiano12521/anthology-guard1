-- load-order: after mags_patches.script, exo_loot.script
-- Arena Loadout Fix
-- Anomaly 1.5.3 / Anthology 2.1
--
-- Mags Redux bar_fights table is Anomaly 1.5.1 loadouts (1911 / OC-33 / Val / STANAG).
-- Anthology issues SoC-style guns (PM / MP5 / Groza / G36). Spare mags do not fit.
-- Exo System free_power only matches exobackpack_exo_outfit and never installs a PSU,
-- so arena exo_outfit stays at 0 power and the actor is slowed to a crawl.
--
-- Vanilla xr_effects.bar_arena_teleport (via MAG/Exo wrappers) does
-- se_save_var(se.id, ...) with no nil check after alife_create. Missing section
-- -> FATAL attempt to index local 'se'. Guard with pcall + safe recover spawn.

local LOG_TAG = "[fix_arena_loadout]"
local VERSION = "1.1.0"
local APPLY_DELAY = 0.35
local SPARE_MAGS = 2
local PSU_SECTION = "exo_power_supply"

printf("%s loaded v%s", LOG_TAG, VERSION)

-- Same sections as reference/anomaly/scripts/xr_effects.script bar_arena_teleport.
local FIGHT_LOADOUTS = {
	["bar_arena_fight_1"] = { "novice_outfit", "wpn_pm", "ammo_9x18_pmm", "ammo_9x18_pmm" },
	["bar_arena_fight_2"] = { "stalker_outfit", "wpn_mp5", "ammo_9x19_pbp" },
	["bar_arena_fight_3"] = { "stalker_outfit", "wpn_bm16", "ammo_12x70_buck", "ammo_12x70_buck" },
	["bar_arena_fight_4"] = {
		"stalker_outfit", "wpn_ak74", "ammo_5.45x39_ap", "ammo_5.45x39_ap", "bandage", "bandage",
	},
	["bar_arena_fight_5"] = {
		"wpn_abakan", "ammo_5.45x39_ap", "ammo_5.45x39_ap", "ammo_5.45x39_ap",
		"bandage", "medkit", "svoboda_light_outfit",
	},
	["bar_arena_fight_6"] = {
		"wpn_groza", "ammo_9x39_ap", "ammo_9x39_ap", "ammo_9x39_ap", "specops_outfit",
	},
	["bar_arena_fight_7"] = { "wpn_knife", "bandage", "grenade_f1", "grenade_f1" },
	["bar_arena_fight_8"] = {
		"wpn_g36", "exo_outfit",
		"ammo_5.56x45_ap", "ammo_5.56x45_ap", "ammo_5.56x45_ap", "ammo_5.56x45_ap",
	},
}

local orig_teleport = nil
local pending_exo_id = nil
local pending_psu_id = nil

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end
local function has_mags()
	return magazine_binder
		and type(magazine_binder.is_supported_weapon) == "function"
		and type(magazine_binder.weapon_default_magazine) == "function"
		and type(magazine_binder.is_magazine) == "function"
		and type(magazine_binder.is_compatible) == "function"
		and type(magazine_binder.create_mag_data) == "function"
		and type(magazine_binder.set_data) == "function"
		and stack and type(stack.push) == "function"
end

local function has_exo()
	return item_exo_device
		and type(item_exo_device.is_exo) == "function"
		and type(item_exo_device.get_data) == "function"
		and type(item_exo_device.set_data) == "function"
		and type(item_exo_device.init_data) == "function"
		and type(item_exo_device.install_psu) == "function"
end

local function delay_call(act_id, timer, fn, ...)
	if magazines and type(magazines.create_time_event) == "function" then
		magazines.create_time_event("fix_arena_loadout", act_id, timer, fn, ...)
	else
		CreateTimeEvent("fix_arena_loadout", act_id, timer, fn, ...)
	end
end

local function ammo_for_weapon_mag(wpn, mag_sec)
	if not (wpn and mag_sec and utils_item and type(utils_item.get_ammo) == "function") then
		return nil
	end
	local map = utils_item.get_ammo(wpn:section(), wpn:id())
	if not (map and map[1]) then
		return nil
	end
	local calibers = magazine_binder.get_magazine_caliber and magazine_binder.get_magazine_caliber(mag_sec)
	if type(calibers) ~= "table" then
		return map[1]
	end
	local allow = {}
	for i = 1, #calibers do
		allow[calibers[i]] = true
	end
	for i = 1, #map do
		if allow[map[i]] then
			return map[i]
		end
	end
	return map[1]
end

function fill_one_mag(id, mag_sec, ammo_sec)
	if not (id and mag_sec and ammo_sec) then
		return true
	end
	local mag_data = magazine_binder.get_mag_loaded and magazine_binder.get_mag_loaded(id)
	if not mag_data then
		mag_data = magazine_binder.create_mag_data(id, mag_sec)
	end
	if not mag_data then
		return true
	end
	local amount = SYS_GetParam(2, mag_sec, "max_mag_size") or 0
	for _ = 1, amount do
		stack.push(mag_data.loaded, ammo_sec)
	end
	if magazine_binder.toggle_carried_mag then
		magazine_binder.toggle_carried_mag(id)
	end
	magazine_binder.set_data(id, mag_data)
	return true
end

local function collect_weapons()
	local weapons = {}
	db.actor:iterate_inventory(function(_, item)
		if item and magazine_binder.is_supported_weapon(item) then
			weapons[#weapons + 1] = item
		end
	end)
	return weapons
end

local function mag_fits_any(mag, weapons)
	for i = 1, #weapons do
		if magazine_binder.is_compatible(weapons[i], mag) then
			return true
		end
	end
	return false
end

local function release_item(item)
	if not item then
		return
	end
	local id = item:id()
	if magazine_binder.is_carried_mag and magazine_binder.is_carried_mag(id) and magazine_binder.toggle_carried_mag then
		magazine_binder.toggle_carried_mag(id)
	end
	pcall(alife_release, item)
end

local function fix_arena_mags()
	if not has_mags() then
		return
	end

	local weapons = collect_weapons()
	if #weapons == 0 then
		-- Shotgun / knife rounds: drop leftover MAG spares that fit nothing.
		local leftovers = {}
		db.actor:iterate_inventory(function(_, item)
			if item and magazine_binder.is_magazine(item) then
				leftovers[#leftovers + 1] = item
			end
		end)
		for i = 1, #leftovers do
			release_item(leftovers[i])
		end
		if #leftovers > 0 then
			log("removed %s leftover magazine(s), no mag-fed weapon", #leftovers)
		end
		return
	end

	local wrong = {}
	db.actor:iterate_inventory(function(_, item)
		if item and magazine_binder.is_magazine(item) and not mag_fits_any(item, weapons) then
			wrong[#wrong + 1] = item
		end
	end)
	for i = 1, #wrong do
		release_item(wrong[i])
	end

	local spawned = 0
	for i = 1, #weapons do
		local wpn = weapons[i]
		if wpn then
			local mag_sec = magazine_binder.weapon_default_magazine(wpn)
			local ammo_sec = mag_sec and ammo_for_weapon_mag(wpn, mag_sec)
			if mag_sec and ammo_sec and ini_sys and ini_sys:section_exist(mag_sec) then
				local have = 0
				db.actor:iterate_inventory(function(_, item)
					if item and magazine_binder.is_magazine(item) and magazine_binder.is_compatible(wpn, item) then
						have = have + 1
					end
				end)
				for _ = have + 1, SPARE_MAGS do
					local se = alife_create_item(mag_sec, db.actor)
					if se and se.id then
						delay_call("fill_" .. se.id, 0, fill_one_mag, se.id, mag_sec, ammo_sec)
						spawned = spawned + 1
					end
				end
			else
				log("no default mag/ammo for %s", wpn:section())
			end
		end
	end

	log("mags: removed %s incompatible, spawned %s default", #wrong, spawned)
end

function install_pending_psu()
	local exo_id = pending_exo_id
	local psu_id = pending_psu_id
	pending_exo_id = nil
	pending_psu_id = nil

	if not (exo_id and psu_id and has_exo()) then
		return true
	end

	local suit = level.object_by_id(exo_id)
	local psu = level.object_by_id(psu_id)
	if not (suit and psu and item_exo_device.is_exo(suit)) then
		log("PSU install skipped: object missing")
		return true
	end

	local data = item_exo_device.get_data(suit:id())
	if not data then
		data = item_exo_device.init_data(suit:id())
	end
	pcall(item_exo_device.install_psu, suit, data, psu)

	data = item_exo_device.get_data(suit:id())
	if data then
		local max_power = (data.supply and data.supply.max) or 150
		data.power = max_power
		item_exo_device.set_data(suit:id(), data)
		log("exo id %s charged %s/%s, PSU %s", suit:id(), data.power, max_power, data.supply and data.supply.name or "none")
	end
	return true
end

local function charge_exo_item(item)
	local id = item:id()
	local data = item_exo_device.get_data(id)
	if not data then
		data = item_exo_device.init_data(id)
	end
	data.power = (data.supply and data.supply.max) or 100
	if data.power < 100 then
		data.power = 100
	end
	item_exo_device.set_data(id, data)
	return data
end

local function fix_arena_exo()
	if not has_exo() then
		return
	end

	local exos = {}
	db.actor:iterate_inventory(function(_, item)
		if item and item_exo_device.is_exo(item) then
			exos[#exos + 1] = item
		end
	end)
	if #exos == 0 then
		return
	end

	for i = 1, #exos do
		charge_exo_item(exos[i])
	end

	local suit = exos[1]
	local data = item_exo_device.get_data(suit:id())
	if data and data.supply then
		log("exo already has PSU %s, power %s", data.supply.name or "?", data.power or 0)
		return
	end
	if not (ini_sys and ini_sys:section_exist(PSU_SECTION)) then
		log("section %s missing, charged without PSU", PSU_SECTION)
		return
	end

	local se = alife_create_item(PSU_SECTION, db.actor)
	if not (se and se.id) then
		log("failed to spawn %s", PSU_SECTION)
		return
	end
	pending_exo_id = suit:id()
	pending_psu_id = se.id
	delay_call("install_psu", 0.1, install_pending_psu)
	log("spawned %s for exo id %s", PSU_SECTION, pending_exo_id)
end

function apply_arena_loadout()
	if not (db and db.actor) then
		return true
	end
	fix_arena_mags()
	fix_arena_exo()
	return true
end

local function current_fight_loadout()
	for info, items in pairs(FIGHT_LOADOUTS) do
		if has_alife_info(info) then
			return info, items
		end
	end
	return nil, nil
end

local function spawn_arena_item(sec)
	if not (sec and db and db.actor and type(alife_create) == "function") then
		return false
	end
	if ini_sys and type(ini_sys.section_exist) == "function" and not ini_sys:section_exist(sec) then
		log("spawn skip missing section %s", sec)
		return false
	end
	local se = alife_create(
		sec,
		db.actor:position(),
		db.actor:level_vertex_id(),
		db.actor:game_vertex_id(),
		AC_ID
	)
	if not se then
		log("alife_create failed for %s", sec)
		return false
	end
	if type(se_save_var) == "function" and se.id then
		pcall(se_save_var, se.id, se:name(), "unpatched", true)
	end
	return true
end

local function actor_has_any_weapon()
	local found = false
	db.actor:iterate_inventory(function(_, item)
		if item and IsWeapon and IsWeapon(item) then
			found = true
		end
	end)
	return found
end

-- If vanilla/MAG crashed mid-spawn after inventory was dumped to the arena box,
-- finish the fight loadout with nil-safe creates. Skip when a weapon already
-- landed (partial success) to avoid duplicate AKs.
function recover_arena_spawn()
	if not (db and db.actor) then
		return
	end
	local info, items = current_fight_loadout()
	if not (info and items) then
		log("recover skipped: no bar_arena_fight_* info")
		return
	end
	if actor_has_any_weapon() then
		log("recover skipped: weapon already present (%s)", info)
		return
	end
	local ok_n, fail_n = 0, 0
	for i = 1, #items do
		if spawn_arena_item(items[i]) then
			ok_n = ok_n + 1
		else
			fail_n = fail_n + 1
		end
	end
	log("recover %s: spawned %s, failed %s", info, ok_n, fail_n)
end

function patched_bar_arena_teleport(actor, npc)
	if orig_teleport then
		local ok, err = pcall(orig_teleport, actor, npc)
		if not ok then
			log("orig bar_arena_teleport error: %s", tostring(err))
			pcall(recover_arena_spawn)
		end
	end
	delay_call("apply", APPLY_DELAY, apply_arena_loadout)
end

local function install()
	if not (xr_effects and type(xr_effects.bar_arena_teleport) == "function") then
		log("xr_effects.bar_arena_teleport not found - guard NOT installed")
		return false
	end
	if xr_effects.bar_arena_teleport == patched_bar_arena_teleport then
		return true
	end
	orig_teleport = xr_effects.bar_arena_teleport
	xr_effects.bar_arena_teleport = patched_bar_arena_teleport
	log("bar_arena_teleport wrapped")
	return true
end

local function uninstall()
	if orig_teleport and type(xr_effects) == "table" then
		xr_effects.bar_arena_teleport = orig_teleport
	end
	orig_teleport = nil
	pending_exo_id = nil
	pending_psu_id = nil
end

function on_game_start()
	install()
end

function on_game_end()
	uninstall()
end
