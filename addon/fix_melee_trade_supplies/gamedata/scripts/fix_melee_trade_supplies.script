-- Melee Trade Supplies Guard
-- Anomaly 1.5.3 / Anthology 2.1
--
-- R.A.K melee_trade_inject.vks_spawn_stock prints
--   ! Trader has no supplies for this supply level [X] - [Y]
-- when the melee trade ini has no section for the resolved supply level
-- (or the trader community is missing from ini_by_faction, e.g. milstalk).
-- Quiet skip: same gameplay (no melee inject), no log spam.

local LOG_TAG = "[fix_melee_trade_supplies]"
local VERSION = "1.0.0"

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig_vks = nil
local installed = false
local callbacks_registered = false
local skip_count = 0
local logged = {}

local function log_skip(npc_name, supply_level)
	skip_count = skip_count + 1
	local key = tostring(npc_name) .. "|" .. tostring(supply_level)
	if logged[key] then
		return
	end
	logged[key] = true
	printf(
		"%s skip missing melee supplies npc=%s level=%s (unique keys; total_skips=%s)",
		LOG_TAG,
		tostring(npc_name),
		tostring(supply_level),
		tostring(skip_count)
	)
end

local function guarded_vks_spawn_stock(npc)
	if not orig_vks then
		return
	end
	if not npc then
		return
	end
	-- Run original but silence its bang-printf for the known message.
	local prev_printf = _G.printf
	local hit = false
	_G.printf = function(fmt, ...)
		if type(fmt) == "string" and string.find(fmt, "Trader has no supplies for this supply level", 1, true) then
			hit = true
			local npc_name = select(1, ...)
			local supply_level = select(2, ...)
			log_skip(npc_name, supply_level)
			return
		end
		return prev_printf(fmt, ...)
	end
	local ok, err = pcall(orig_vks, npc)
	_G.printf = prev_printf
	if not ok then
		printf("%s vks_spawn_stock error: %s", LOG_TAG, tostring(err))
	end
	return hit
end

local function install()
	if installed then
		return true
	end
	local mod = rawget(_G, "melee_trade_inject")
	if not (mod and type(mod.vks_spawn_stock) == "function") then
		printf("%s melee_trade_inject.vks_spawn_stock not found - guard NOT installed", LOG_TAG)
		return false
	end
	if mod.vks_spawn_stock == guarded_vks_spawn_stock then
		installed = true
		return true
	end
	orig_vks = mod.vks_spawn_stock
	mod.vks_spawn_stock = guarded_vks_spawn_stock
	installed = true
	printf("%s wrapped melee_trade_inject.vks_spawn_stock", LOG_TAG)
	return true
end

local function uninstall()
	local mod = rawget(_G, "melee_trade_inject")
	if installed and mod and orig_vks then
		mod.vks_spawn_stock = orig_vks
	end
	orig_vks = nil
	installed = false
end

function actor_on_first_update()
	if not installed then
		install()
	end
end

function on_game_start()
	install()
	if not callbacks_registered then
		RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = true
	end
end

function on_game_end()
	if callbacks_registered then
		UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = false
	end
	uninstall()
	skip_count = 0
	logged = {}
end
