-- RX Bandage Dead NPC Guard
-- Anomaly 1.5.3 / Anthology 2.1
--
-- action_bandage:initialize calls set_smart_cover_target_idle() after the
-- stalker can already be dead. Engine FATAL:
--   CAI_Stalker: do not call smart_cover_setup_idle_target when stalker is dead
--   rx_bandage.script(175)
--
-- xr_smartcover.action_smartcover_activity:target_selector already returns
-- before the same engine call when not obj:alive(). rx_bandage does not.
-- finalize() already bails on a corpse; initialize/evaluate/execute do not.
--
-- ZIP v1.0.0 BETA replaced the whole rx_bandage.script for one alive()
-- check. This addon wraps the class methods and leaves the original file.

local LOG_TAG = "[fix_rx_bandage_dead]"
local VERSION = "1.0.1"

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig = {}
local installed = false

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

local function class_from(module_name, class_name)
	local module = rawget(_G, module_name)
	if module and module[class_name] then
		return module[class_name]
	end
	return rawget(_G, class_name)
end

local function npc_alive(npc)
	if not npc then
		return false
	end
	local ok, alive = pcall(function()
		return npc:alive()
	end)
	return ok and alive and true or false
end

function patched_evaluate(self)
	if not npc_alive(self and self.object) then
		return false
	end
	return orig.evaluate(self)
end

function patched_initialize(self)
	if not npc_alive(self and self.object) then
		-- Original fatals at set_smart_cover_target_idle. A corpse needs
		-- no bandage setup; finalize() already returns immediately.
		local base = rawget(_G, "action_base")
		if base and type(base.initialize) == "function" then
			base.initialize(self)
		end
		return
	end
	return orig.initialize(self)
end

function patched_execute(self)
	if not npc_alive(self and self.object) then
		return
	end
	return orig.execute(self)
end

local function wrap(slot, class, name, patched)
	if not (class and type(class[name]) == "function") then
		return false
	end
	if class[name] == patched then
		return true
	end
	orig[slot] = orig[slot] or class[name]
	class[name] = patched
	return true
end

local function install()
	if installed then
		return true
	end

	local eva = class_from("rx_bandage", "evaluator_bandage")
	local act = class_from("rx_bandage", "action_bandage")
	if not (eva and act) then
		log("rx_bandage classes not found - guard NOT installed")
		return false
	end

	local ok_eva = wrap("evaluate", eva, "evaluate", patched_evaluate)
	local ok_init = wrap("initialize", act, "initialize", patched_initialize)
	local ok_exec = wrap("execute", act, "execute", patched_execute)
	if not (ok_eva and ok_init and ok_exec) then
		log(
			"missing methods evaluate=%s initialize=%s execute=%s",
			tostring(ok_eva),
			tostring(ok_init),
			tostring(ok_exec)
		)
		return false
	end

	installed = true
	log("loaded v%s wrapped evaluate/initialize/execute", VERSION)
	return true
end

local function uninstall()
	local eva = class_from("rx_bandage", "evaluator_bandage")
	local act = class_from("rx_bandage", "action_bandage")
	if eva and orig.evaluate then
		eva.evaluate = orig.evaluate
	end
	if act then
		if orig.initialize then
			act.initialize = orig.initialize
		end
		if orig.execute then
			act.execute = orig.execute
		end
	end
	orig = {}
	installed = false
end

function actor_on_first_update()
	if not installed then
		install()
	end
end

function on_game_start()
	install()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end

function on_game_end()
	UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
	uninstall()
end
