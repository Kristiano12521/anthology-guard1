-- Create Squad Nil Smart Guard
-- Anomaly 1.5.3 / Anthology 2.1
--
-- sim_board.create_squad indexes spawn_smart.position with no nil check.
-- xr_effects.create_squad logs a missing smart_name but still calls through.
-- Guard both: return nil (same contract as zz_anthology_safe_offline_spawn).

local LOG_TAG = "[fix_create_squad_nil_smart]"
local VERSION = "1.0.0"

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig_board_create_squad = nil
local orig_xr_create_squad = nil
local patched_board = nil
local board_installed = false
local xr_installed = false
local callbacks_registered = false
local logged = {}

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

local function log_once(key, fmt, ...)
	if logged[key] then
		return
	end
	logged[key] = true
	log(fmt, ...)
end

-- Cheap caller label for residual paths (e.g. tasks_defense indexing sq.id).
-- getinfo(3): 1=this helper, 2=our wrap, 3=external caller.
local function caller_label()
	if not (type(debug) == "table" and type(debug.getinfo) == "function") then
		return "?"
	end
	local ok, info = pcall(debug.getinfo, 3, "Sln")
	if not (ok and type(info) == "table") then
		return "?"
	end
	local src = info.short_src or info.source or "?"
	local line = info.currentline
	local name = info.name
	if type(name) == "string" and name ~= "" then
		return string.format("%s:%s:%s", tostring(src), name, tostring(line))
	end
	return string.format("%s:%s", tostring(src), tostring(line))
end

------------------------------------------------------------------------
-- SIMBOARD.create_squad ù primary guard (all call paths)
------------------------------------------------------------------------
local function patched_board_create_squad(self, smart, squad_section, ...)
	if not smart then
		local sq = tostring(squad_section)
		local who = caller_label()
		log_once(
			"board|" .. sq,
			"skip create_squad: spawn_smart=nil squad=%s caller=%s",
			sq,
			who
		)
		return nil
	end
	return orig_board_create_squad(self, smart, squad_section, ...)
end

local function install_board()
	local board = rawget(_G, "SIMBOARD")
	if not (board and type(board.create_squad) == "function") then
		return false
	end
	-- Same board object: stay under any outer wrap (zz_anthology_safe_offline_spawn).
	if patched_board == board and board_installed then
		return true
	end
	orig_board_create_squad = board.create_squad
	board.create_squad = patched_board_create_squad
	patched_board = board
	board_installed = true
	log("wrapped SIMBOARD.create_squad")
	return true
end

------------------------------------------------------------------------
-- xr_effects.create_squad ù early exit + clear log
------------------------------------------------------------------------
local function patched_xr_create_squad(actor, obj, p)
	local squad_id = p and p[1]
	if squad_id == nil then
		log_once("xr|nil_squad", "skip xr_effects.create_squad: squad_id=nil")
		return
	end
	local smart_name = p and p[2]
	if smart_name == nil then
		log_once("xr|nil_smart_name", "skip xr_effects.create_squad: smart_name=nil squad=%s", tostring(squad_id))
		return
	end

	local board = rawget(_G, "SIMBOARD")
	local smart = board and board.smarts_by_names and board.smarts_by_names[smart_name]
	if smart == nil then
		local who = caller_label()
		log_once(
			"xr|" .. tostring(smart_name),
			"skip xr_effects.create_squad: smart_name=%s squad=%s caller=%s",
			tostring(smart_name),
			tostring(squad_id),
			who
		)
		return
	end

	return orig_xr_create_squad(actor, obj, p)
end

local function install_xr()
	if xr_installed and orig_xr_create_squad then
		local mod = rawget(_G, "xr_effects")
		if mod and mod.create_squad == patched_xr_create_squad then
			return true
		end
	end
	local mod = rawget(_G, "xr_effects")
	if not (mod and type(mod.create_squad) == "function") then
		log_once("xr_missing", "xr_effects.create_squad not found - guard NOT installed")
		return false
	end
	if mod.create_squad == patched_xr_create_squad then
		xr_installed = true
		return true
	end
	orig_xr_create_squad = mod.create_squad
	mod.create_squad = patched_xr_create_squad
	xr_installed = true
	log("wrapped xr_effects.create_squad")
	return true
end

------------------------------------------------------------------------
-- install / uninstall
------------------------------------------------------------------------
local function install_all()
	if not install_board() then
		-- SIMBOARD may appear later; actor_on_first_update retries.
	end
	install_xr()
end

local function uninstall_all()
	local board = rawget(_G, "SIMBOARD")
	if board and orig_board_create_squad and board.create_squad == patched_board_create_squad then
		board.create_squad = orig_board_create_squad
	end
	local mod = rawget(_G, "xr_effects")
	if mod and orig_xr_create_squad and mod.create_squad == patched_xr_create_squad then
		mod.create_squad = orig_xr_create_squad
	end
	orig_board_create_squad = nil
	orig_xr_create_squad = nil
	patched_board = nil
	board_installed = false
	xr_installed = false
	logged = {}
end

function on_game_load()
	logged = {}
end

function actor_on_first_update()
	install_all()
end

function on_game_start()
	install_all()
	if not callbacks_registered then
		RegisterScriptCallback("on_game_load", on_game_load)
		RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = true
	end
end

function on_game_end()
	if callbacks_registered then
		UnregisterScriptCallback("on_game_load", on_game_load)
		UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = false
	end
	uninstall_all()
end
