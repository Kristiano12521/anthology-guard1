-- DRX SL meet-honcho loop fix
-- Anomaly 1.5.3 / Anthology 2.1
--
-- After a honcho has no more storyline tasks, default_task auto-completes and
-- calls drx_sl_meet_random_honcho(). When no OTHER valid honcho exists,
-- vanilla keeps current_honcho and re-issues meet_task for the same NPC.
-- That meet is often still inprocess -> TASK ALREADY EXISTS / PDA stuck on
-- "meet X" while dialog flashes "get next task" new+complete.
--
-- Monkey-patch: never self-meet on empty candidate list; skip give_task if
-- meet already active; clear stuck meet info/task for current on abort.

-- load-order: after xr_effects / axr_task_manager (wraps at on_game_start)

local LOG_TAG = "[fix_drx_sl_meet_loop]"
local VERSION = "1.0.0"

printf("%s loaded v%s", LOG_TAG, VERSION)

local orig = {}
local installed = false
local callbacks_registered = false

local function log(fmt, ...)
	printf(LOG_TAG .. " " .. fmt, ...)
end

local function meet_task_active(task_id)
	if type(task_id) ~= "string" or task_id == "" then
		return false
	end

	local tm = rawget(_G, "task_manager")
	local mgr = tm and tm.get_task_manager and tm.get_task_manager()
	local info = mgr and mgr.task_info and mgr.task_info[task_id]
	if info then
		local st = info.status
		if st ~= "fail" and st ~= "completed" then
			return true
		end
	end

	if db and db.actor and type(db.actor.get_task) == "function" then
		local ok, eng = pcall(function()
			return db.actor:get_task(task_id, true)
		end)
		if ok and eng ~= nil then
			return true
		end
	end

	return false
end

local function clear_stuck_meet_for(honcho)
	if type(honcho) ~= "string" or honcho == "" then
		return
	end

	local info_id = "drx_sl_meet_honcho_" .. honcho
	if type(has_alife_info) == "function" and type(disable_info) == "function" then
		local ok, has = pcall(has_alife_info, info_id)
		if ok and has then
			pcall(disable_info, info_id)
			log("cleared stuck meet info %s", info_id)
		end
	end

	local tm = rawget(_G, "task_manager")
	local ini = tm and tm.task_ini
	local mgr = tm and tm.get_task_manager and tm.get_task_manager()
	if not (ini and mgr and type(mgr.set_task_completed) == "function") then
		return
	end

	local i = 1
	while true do
		local task_id = "drx_sl_" .. honcho .. "_meet_task_" .. i
		if not (ini.section_exist and ini:section_exist(task_id)) then
			break
		end
		if meet_task_active(task_id) then
			pcall(function()
				mgr:set_task_completed(task_id)
			end)
			log("forced complete stuck %s", task_id)
		end
		i = i + 1
	end
end

-- Corrected copy of xr_effects.drx_sl_meet_random_honcho (vanilla ~704-780).
local function patched_meet_random_honcho(actor, npc, p)
	local atm = rawget(_G, "axr_task_manager")
	local drx_sl_honchos_table = atm and atm.drx_sl_honchos_table
	if not drx_sl_honchos_table then
		log("axr_task_manager.drx_sl_honchos_table missing - abort")
		return
	end

	local current_honcho = ""
	if db and db.actor and type(load_var) == "function" then
		current_honcho = load_var(db.actor, "drx_sl_current_honcho", "") or ""
	end

	local honcho_list = {}
	local size_t = 0
	local cond = rawget(_G, "xr_conditions")

	for i = 1, #drx_sl_honchos_table do
		local honcho = drx_sl_honchos_table[i][1]
		local alive = false
		if honcho == "esc_m_trader" then
			alive = true
		elseif cond and type(cond.is_alive) == "function" then
			local ok, res = pcall(cond.is_alive, nil, nil, {honcho})
			alive = ok and res and true or false
		end

		if alive and honcho ~= current_honcho then
			local is_enemy = false
			local actor_se = alife() and alife():actor()
			local actor_comm = actor_se and actor_se:community()
			if actor_comm and relation_registry and relation_registry.community_relation then
				for j = 2, #drx_sl_honchos_table[i] do
					local ok, rel = pcall(relation_registry.community_relation, drx_sl_honchos_table[i][j], actor_comm)
					if ok and rel and rel <= -1000 then
						is_enemy = true
						break
					end
				end
			end
			if not is_enemy then
				size_t = size_t + 1
				honcho_list[size_t] = honcho
			end
		end
	end

	-- Vanilla bug: size_t==0 kept current_honcho and re-issued self-meet.
	if size_t < 1 then
		log("no valid next honcho (current=%s) - skip self-meet loop", tostring(current_honcho))
		clear_stuck_meet_for(current_honcho)
		return
	end

	local next_honcho = honcho_list[math.random(size_t)]
	if db and db.actor and type(save_var) == "function" then
		save_var(db.actor, "drx_sl_current_honcho", next_honcho)
		local n = load_var(db.actor, "drx_sl_current_task_number", 1) + 1
		save_var(db.actor, "drx_sl_current_task_number", n)
		printf("DRX SL task count: " .. tostring(n))
	end

	local tm = rawget(_G, "task_manager")
	local task_ltx_file = tm and tm.task_ini
	if not task_ltx_file then
		log("task_manager.task_ini missing - abort")
		return
	end

	local honcho_task_list = {}
	size_t = 0
	local i = 1
	while true do
		local honcho_task_id = "drx_sl_" .. next_honcho .. "_meet_task_" .. i
		if task_ltx_file:section_exist(honcho_task_id) then
			if not meet_task_active(honcho_task_id) then
				size_t = size_t + 1
				honcho_task_list[size_t] = honcho_task_id
			else
				log("exclude already-active %s", honcho_task_id)
			end
			i = i + 1
		else
			break
		end
	end

	if size_t < 1 then
		log("no free meet tasks for %s - skip give_task", tostring(next_honcho))
		return
	end

	local honcho_task_id = honcho_task_list[math.random(size_t)]
	if db and db.actor and type(save_var) == "function" then
		save_var(db.actor, "drx_sl_current_task", honcho_task_id)
	end
	printf("DRX SL current storyline task: " .. honcho_task_id)

	if type(give_info) == "function" then
		give_info("drx_sl_meet_honcho_" .. next_honcho)
	end

	local mgr = tm.get_task_manager and tm.get_task_manager()
	if mgr and type(mgr.give_task) == "function" then
		mgr:give_task(honcho_task_id)
	else
		log("task_manager:give_task missing - meet not issued")
	end
end

local function install()
	if installed then
		return
	end

	local effects = rawget(_G, "xr_effects")
	if not (effects and type(effects.drx_sl_meet_random_honcho) == "function") then
		log("xr_effects.drx_sl_meet_random_honcho not found - guard NOT installed")
		return
	end

	orig.drx_sl_meet_random_honcho = effects.drx_sl_meet_random_honcho
	effects.drx_sl_meet_random_honcho = patched_meet_random_honcho
	installed = true
	log("v%s wrapped: drx_sl_meet_random_honcho", VERSION)
end

local function uninstall()
	if not installed then
		orig = {}
		return
	end

	local effects = rawget(_G, "xr_effects")
	if effects and orig.drx_sl_meet_random_honcho then
		effects.drx_sl_meet_random_honcho = orig.drx_sl_meet_random_honcho
	end

	orig = {}
	installed = false
end

function on_game_load()
	-- no save state
end

function actor_on_first_update()
	local effects = rawget(_G, "xr_effects")
	local ok = effects and effects.drx_sl_meet_random_honcho == patched_meet_random_honcho
	if not installed or not ok then
		installed = false
		orig = {}
		install()
	end
end

function on_game_start()
	install()
	if not callbacks_registered then
		RegisterScriptCallback("on_game_load", on_game_load)
		RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = true
	end
end

function on_game_end()
	if callbacks_registered then
		UnregisterScriptCallback("on_game_load", on_game_load)
		UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
		callbacks_registered = false
	end
	uninstall()
end
