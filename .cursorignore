# Распакованные чужие моды для ревью: не индексировать, чтобы не конкурировать с addon/.
_tmp_*/

# Эталон сборки (~14k файлов). Поиск по API/секциям/callback — через
# tools/refindex.py (индекс в .cache/), не через семантический индекс Cursor.
# Файлы по пути из refindex читать адресно (Read / shell).
reference/

# Сырые логи игры и одноразовая карточка xraylog — не исходники, часто с локальными путями.
logs/*.log
logs/card.md

# Архив карточек разбора: нужны только при /crash, тогда читать адресно
# (ссылка из docs/issues.md или путь от --archive), не через индекс.
logs/cards/

# Кэш инструментов (индекс reference/ и прочее).
.cache/

# Собранные моды для MO2, руками не правятся.
build/

# Бинарники в addon/: текстуры, звуки, спавн, секвенции.
# Тексты (.script, .ltx, .xml) остаются в индексе.
addon/**/*.dds
addon/**/*.png
addon/**/*.ogg
addon/**/*.bin
addon/**/*.seq
