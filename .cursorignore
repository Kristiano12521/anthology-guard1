# Распакованные чужие моды для ревью: не индексировать, чтобы не конкурировать с addon/.
_tmp_*/

# Сырые логи игры и одноразовая карточка xraylog — не исходники, часто с локальными путями.
# Архив logs/cards/ не исключаем: это поисковая база разборов.
logs/*.log
logs/card.md

# Кэш инструментов (индекс reference/ и прочее).
.cache/

# Собранные моды для MO2, руками не правятся.
build/

# reference/ в .gitignore, но агенту он нужен как эталон — не исключаем целиком.
!reference/
!reference/**

# Бинарники в addon/ и reference/: текстуры, звуки, спавн, секвенции.
# Тексты (.script, .ltx, .xml) остаются в индексе.
addon/**/*.dds
addon/**/*.png
addon/**/*.ogg
addon/**/*.bin
addon/**/*.seq
reference/**/*.dds
reference/**/*.png
reference/**/*.ogg
reference/**/*.bin
reference/**/*.seq
