# Исходники сборки лежат локально и в git не хранятся (объём + лицензия).
reference/*
!reference/README.md
!reference/.gitkeep

# Артефакты сборки аддонов
build/*
!build/README.md
!build/.gitkeep

# Реальные игровые логи — только локально, там пути и имя пользователя
logs/*
!logs/README.md
!logs/samples/
!logs/cards/
!logs/.gitkeep
logs/card.md

# Одноразовые артефакты инструментов (/mine, refindex и т.п.)
mine.txt
out.txt

# Распакованные чужие моды для ревью — не в git.
_tmp_*/

# Кэш инструментов
.cache/
__pycache__/
*.pyc

# Мусор ОС / редакторов
.DS_Store
Thumbs.db
*.swp

# ��������� ������ ������
/mine.txt
/out.txt
*.tmp.txt
