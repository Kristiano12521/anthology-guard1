-- __TITLE__
-- Anomaly 1.5.3 / Anthology 2.1
-- Logic only. MCM options live in __MOD_ID___mcm.script

local LOG_TAG = "[__MOD_ID__]"
local VERSION = "1.0.0"

-- Presence line for xraylog «Мои моды» — unconditional, before any guards.
printf("%s loaded v%s", LOG_TAG, VERSION)

local function opt(path, default)
	return ui_mcm and ui_mcm.get(path) or default
end

local function log(fmt, ...)
	if opt("__MOD_ID__/debug", false) then
		printf(LOG_TAG .. " " .. fmt, ...)
	end
end

-- Module state. Reset it on game load: locals survive between sessions.
local state = nil

local function reset_state()
	state = {
		last_tick = 0,
	}
end

----------------------------------------------------------------------
-- Two-layer repair (optional). Uncomment when the case matches.
--
-- Pattern from addon code (not a project rule):
--   full:   fix_rogue_hostility, fix_soc_nimble_flash, fix_noosphere_voice_x18
--   partial: fix_quest_story_id (DLTX + CreateTimeEvent + also register wrap)
--   partial: fix_wtf_assault_instacomplete (runtime merge only — no DLTX,
--            no CreateTimeEvent)
--
-- Layer 1 — DLTX (see mod_items_food___MOD_ID__.ltx):
--   Fixes FUTURE spawns / scheme / jobs. New objects pick it up from config.
--
-- Layer 2 — one-shot CreateTimeEvent (this stub):
--   Fixes ALREADY broken saves after load. Schedule from actor_on_first_update.
--   Retry: ResetTimeEvent + return false. Done / give up: return true
--   (Create with the same ids while the slot lives is a no-op).
--   Cancel on on_game_end. Reset attempt counter on on_game_load.
--   Do not poll actor_on_update / scan 1..65534 for this.
--
-- Extra triggers seen in the full mods (optional):
--   actor_on_item_take (nimble), npc_on_death_callback (noosphere).
----------------------------------------------------------------------
--[[
local EVENT_ID = "__MOD_ID__"
local REPAIR_ACTION = "repair"
local REPAIR_DELAY = 1.0
local REPAIR_MAX_ATTEMPTS = 10
local repair_attempts = 0

-- Returns true when repair finished or should stop; false to keep the slot.
local function try_repair()
	if not db.actor then
		return false
	end
	-- if already healthy / not applicable -> return true
	-- if fixed this tick -> return true
	-- if target not ready yet -> return false
	return true
end

function repair_tick()
	repair_attempts = repair_attempts + 1
	if try_repair() then
		return true
	end
	if repair_attempts >= REPAIR_MAX_ATTEMPTS then
		-- Future cases: Layer 1 DLTX. Stop the timer.
		return true
	end
	ResetTimeEvent(EVENT_ID, REPAIR_ACTION, REPAIR_DELAY)
	return false
end

local function cancel_repair()
	if type(RemoveTimeEvent) == "function" then
		pcall(RemoveTimeEvent, EVENT_ID, REPAIR_ACTION)
	end
	repair_attempts = 0
end

local function schedule_repair()
	cancel_repair()
	if not db.actor then
		return
	end
	-- Optional early exit if quest/info already OK (see rogue / noosphere).
	CreateTimeEvent(EVENT_ID, REPAIR_ACTION, REPAIR_DELAY, repair_tick)
end
--]]

----------------------------------------------------------------------
-- Callbacks
----------------------------------------------------------------------

local function on_game_load()
	reset_state()
	-- repair_attempts = 0
	log("loaded")
end

local function actor_on_first_update()
	-- db.actor is guaranteed available from here, not earlier.
	if not opt("__MOD_ID__/enable", true) then
		return
	end
	-- schedule_repair()
	log("actor ready")
end

local function actor_on_update()
	if not state or not opt("__MOD_ID__/enable", true) then
		return
	end

	-- Runs every tick: keep it cheap, throttle real work.
	local now = time_global()
	if now - state.last_tick < 1000 then
		return
	end
	state.last_tick = now

	-- Heavy work belongs in CreateTimeEvent, not here.
end

local function save_state(data)
	data.__MOD_ID__ = {
		version = 1,
	}
end

local function load_state(data)
	-- Read defensively: the field is absent in saves made before this mod.
	local saved = data.__MOD_ID__ or {}
	if saved.version ~= 1 then
		log("no saved state, starting fresh")
	end
end

----------------------------------------------------------------------
-- Registration
----------------------------------------------------------------------

function on_game_start()
	reset_state()
	-- install() guard example:
	-- if not target then printf("%s target not found - guard NOT installed", LOG_TAG); return end
	RegisterScriptCallback("on_game_load", on_game_load)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
end

function on_game_end()
	-- cancel_repair()
	UnregisterScriptCallback("on_game_load", on_game_load)
	UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
	UnregisterScriptCallback("actor_on_update", actor_on_update)
	UnregisterScriptCallback("save_state", save_state)
	UnregisterScriptCallback("load_state", load_state)
end
